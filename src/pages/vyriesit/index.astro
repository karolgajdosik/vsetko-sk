---
import Base from '../../layouts/Base.astro';
---
<Base title="Moje prípady – súkromná schránka" description="Prehľad potvrdených lokálnych prípadov zo všetkých troch scenárov V7.">
<main id="obsah" class="wrap main">
  <p class="eyebrow">VŠETKO24 · osobná schránka</p>
  <h1>Moje prípady</h1>
  <p>Jedno miesto na prezeranie prípadov, ktoré ste výslovne vytvorili v troch sprievodcoch. Údaje zostávajú iba v tomto prehliadači. Táto schránka ich neupravuje ani neposiela. Prípady možno výslovne zahrnúť do šifrovanej zálohy cez stránku Záloha.</p>
  <nav aria-label="Sprievodcovia prípadmi">
    <a href="/vyriesit/zdrazena-sluzba/">Zdražená služba</a> ·
    <a href="/vyriesit/reklamacia-nakupu/">Reklamácia nákupu</a> ·
    <a href="/vyriesit/koniec-zmluvy/">Koniec zmluvy</a>
  </nav>
  <p><a href="/vyriesit/dokument-na-ulohy/">Pripraviť úlohy podľa typu dokumentu</a></p>
  <p id="inbox-status" role="status" aria-live="polite">Načítavam miestne záznamy…</p>
  <section id="inbox-due" hidden aria-labelledby="inbox-due-title">
    <h2 id="inbox-due-title">Na vybavenie</h2>
    <ul id="inbox-due-list"></ul>
  </section>
  <div id="inbox-cases"></div>
  <p>Ak je úložisko poškodené alebo zablokované, príslušné záznamy nezobrazíme a nič neprepíšeme. Na úpravu, export alebo odstránenie otvorte konkrétneho sprievodcu. Na iných zariadeniach sa prípady automaticky nezobrazia.</p>
  <noscript>Na zobrazenie lokálnych prípadov je potrebný JavaScript.</noscript>
</main>
<style>
#inbox-cases{display:grid;gap:1rem;margin:1.5rem 0}
.inbox-card{border:1px solid var(--border, #aaa);border-radius:.75rem;padding:1rem;overflow-wrap:anywhere}
.inbox-card h2{margin:.2rem 0;font-size:1.15rem}
.inbox-card p{margin:.45rem 0}
</style>
<script>
import { createDeadlineCalendar } from '../../lib/deadline-center.mjs';
import { formatCaseDate, localCaseDate, validCaseFollowUp } from '../../lib/case-follow-up.mjs';
type Entry=Record<string,unknown>;
const sources=[
  {key:'v24-v7-service-cases-v1',title:'Zdražená služba',path:'/vyriesit/zdrazena-sluzba/',name:'service'},
  {key:'v24-v7-complaint-cases-v1',title:'Reklamácia nákupu',path:'/vyriesit/reklamacia-nakupu/',name:'item'},
  {key:'v24-v7-contract-end-v1',title:'Koniec zmluvy',path:'/vyriesit/koniec-zmluvy/',name:'name'}
] as const;
const root=document.getElementById('inbox-cases')!;
const status=document.getElementById('inbox-status')!;
const dueSection = document.getElementById('inbox-due')!;
const dueList = document.getElementById('inbox-due-list')!;
const today = localCaseDate();
let total=0,errors=0;
const text=(value:unknown,max=90)=>typeof value==='string'?value.slice(0,max):'';
for(const source of sources){
  let entries:Entry[]=[];
  try{
    const raw=localStorage.getItem(source.key);
    if(raw!==null){
      if(raw.length>250000)throw Error('Príliš veľký záznam');
      const parsed:unknown=JSON.parse(raw);
      if(!parsed||typeof parsed!=='object'||Array.isArray(parsed))throw Error('Neplatný formát');
      const data=parsed as {version?:unknown;entries?:unknown};
      if(data.version!==1||!Array.isArray(data.entries)||data.entries.length>20||
        !data.entries.every((entry:unknown)=>entry!==null&&typeof entry==='object'&&!Array.isArray(entry)&&typeof (entry as Entry).id==='string')){
        throw Error('Neplatná verzia alebo štruktúra');
      }
      entries=data.entries as Entry[];
    }
  }catch{
    errors++;
    const warning=document.createElement('p');
    warning.textContent='Záznamy „'+source.title+'“ sa nedajú bezpečne načítať. Skontrolujte ich v pôvodnom sprievodcovi; nič nebolo zmenené.';
    root.append(warning);
    continue;
  }
  for(const entry of entries){
    total++;
    const card=document.createElement('article');card.className='inbox-card';
    const heading=document.createElement('h2');
    heading.textContent=text(entry[source.name])||'Nepomenovaný prípad';
    const category=document.createElement('p');category.textContent=source.title;
    const state=document.createElement('p');
    const hasReply=typeof entry.reply==='string'&&entry.reply.trim().length>0;
    const hasResult=typeof entry.actual==='number'&&Number.isFinite(entry.actual);
    const savedFollowUp = entry.followUp as {sentOn:string;contactOn:string} | undefined;
    const followUp = !hasResult && validCaseFollowUp(savedFollowUp) ? savedFollowUp : undefined;
    const due = followUp && followUp.contactOn <= today;
    state.textContent=followUp?'Čakám na odpoveď':hasResult?'Skutočný výsledok zaznamenaný':hasReply?'Odpoveď zaznamenaná':'Rozpracovaný prípad';
    const link = document.createElement('a');
    link.href = source.path + '#' + new URLSearchParams({ pripad: String(entry.id) });
    link.textContent = 'Otvoriť prípad';
    const lastStep = document.createElement('p');
    const lastEvent = Array.isArray(entry.history) ? entry.history.at(-1) : null;
    const lastMessage = text(lastEvent?.note ?? lastEvent?.message, 700);
    lastStep.textContent = 'Posledný zaznamenaný krok: ' + (lastMessage || 'bez záznamu');

    const nextStep = document.createElement('p');
    const nextAction = followUp ? (due ? 'Ozvite sa k prípadu.' : 'Počkajte na odpoveď do termínu ďalšieho kontaktu.')
      : hasResult ? 'Skontrolujte výsledok prípadu.'
      : hasReply ? 'Zapíšte skutočný výsledok, keď ho budete poznať.'
      : 'Otvorte prípad a skontrolujte ďalší postup a podklady.';
    nextStep.textContent = 'Najbližší krok: ' + nextAction;

    card.append(heading, category, state, lastStep, nextStep);
    if (followUp) {
      const date = document.createElement('p');
      date.textContent = 'Ďalší kontakt: ' + formatCaseDate(followUp.contactOn);
      card.append(date);
      if (due) {
        const item = document.createElement('li');
        const dueLink = document.createElement('a');
        dueLink.href = link.href;
        dueLink.textContent = heading.textContent + ' · ' + formatCaseDate(followUp.contactOn);
        item.append(dueLink);
        dueList.append(item);
        dueSection.hidden = false;
      }
    }
    const endDate = text(entry.endDate, 10);
    if (source.name === 'name' && /^\d{4}-\d{2}-\d{2}$/.test(endDate)) {
      const [year, month, day] = endDate.split('-');
      const date = document.createElement('p');
      date.textContent = 'Evidovaný koniec obdobia: ' + Number(day) + '. ' + Number(month) + '. ' + year;
      card.append(date);
    }
    card.append(link);
    if (followUp) {
      const exportButton = document.createElement('button');
      exportButton.type = 'button';
      exportButton.textContent = 'Stiahnuť termín (.ics)';
      exportButton.addEventListener('click', () => {
        const calendar = createDeadlineCalendar([{
          id: source.name + '-' + String(entry.id).slice(0, 99),
          title: 'Ďalší kontakt · ' + source.title,
          date: followUp.contactOn
        }]);
        const url = URL.createObjectURL(new Blob([calendar], {type: 'text/calendar;charset=utf-8'}));
        const download = document.createElement('a');
        download.href = url;
        download.download = 'vsetko24-dalsi-kontakt.ics';
        download.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      });
      card.append(document.createTextNode(' '), exportButton);
    }
    root.append(card);
  }
}
status.textContent=total+' miestnych prípadov'+(errors?' · '+errors+' zdrojov sa nepodarilo bezpečne načítať':'')+'.';
if(!total&&!errors){const empty=document.createElement('p');empty.textContent='Zatiaľ nemáte uložené prípady. Začnite niektorým zo sprievodcov vyššie.';root.append(empty);}
</script>
