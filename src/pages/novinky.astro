import Base from '../layouts/Base.astro';
const tools=[
['/moj-prehlad/','Môj prehľad','Vyberte si témy a obľúbené odkazy. Pozrite si počet vlastných úloh a termínov.'],
['/ai/','Spresnite otázku asistentovi','Filtrujte lokálne výsledky podľa oblasti a typu a pokračujte súvisiacou témou.'],
['/kalendar/','Vlastné povinnosti a termíny','Vyberte si šablónu, potvrďte vlastný dátum a exportujte termíny do kalendára.'],
['/dokumenty/','Centrum dokumentov','Vyhľadajte vhodný nástroj a pripravte dokument v prehliadači.'],
['/financie/prehlad/','Financie 360°','Spočítajte rozpočet, rezervu a vlastný scenár zmeny príjmov alebo výdavkov.'],
['/auto/moje-auto/','Auto 360°','Evidujte náklady na auto a ich priemer na kilometer za vlastné obdobie.'],
['/aplikacia/','Portál na ploche mobilu','Pridajte si web ako aplikáciu a prečítajte si jeho offline možnosti.'],
