---
import Base from '../layouts/Base.astro';
---
<Base updated="22. 10. 2026" sourceLinks={[{"label": "Národná banka Slovenska", "url": "https://nbs.sk/"}]} title="Financie a kalkulačky" description="Bezplatná hypotekárna kalkulačka a jednoduchý rodinný rozpočet."><main id="obsah" class="wrap main"><p class="eyebrow">Financie</p><h1>Financie a kalkulačky</h1><p class="intro section-intro">Praktické výpočty priamo vo vašom prehliadači. Zadané údaje sa neposielajú na server.</p><section class="panel" id="hypoteka"><h2>Hypotekárna kalkulačka</h2><div class="calc"><div><div class="field"><label for="amount">Výška úveru <output id="amountLabel">180 000 €</output></label><input id="amount" type="range" min="20000" max="400000" step="5000" value="180000"/></div><div class="field"><label for="rate">Ročný úrok <output id="rateLabel">3,8 %</output></label><input id="rate" type="range" min="0" max="10" step="0.1" value="3.8"/></div><div class="field"><label for="years">Splatnosť <output id="yearsLabel">30 rokov</output></label><input id="years" type="range" min="5" max="40" step="1" value="30"/></div></div><div class="result" aria-live="polite"><p>Orientačná mesačná splátka</p><strong id="payment">—</strong><p>Celkom splátky: <b id="total">—</b></p><p>Celkom úroky: <b id="cost">—</b></p></div></div><p class="note">Výpočet predpokladá nemennú úrokovú sadzbu počas celej splatnosti. Nezahŕňa poplatky, poistenie ani zmeny sadzby po fixácii. Nie je ponukou úveru.</p><p class="source">Zdroj informácií o úveroch: <a href="https://nbs.sk/" target="_blank" rel="noopener noreferrer">Národná banka Slovenska ↗</a></p></section><section class="panel" id="rozpocet"><h2>Rodinný rozpočet</h2><p>Zadajte orientačné mesačné príjmy a výdavky.</p><div class="budget"><label for="income">Príjmy (€)<input id="income" type="number" min="0" step="10" value="2500" inputmode="decimal"/></label><label for="expenses">Výdavky (€)<input id="expenses" type="number" min="0" step="10" value="1800" inputmode="decimal"/></label></div><p>Odhadovaný mesačný zostatok: <output class="budget-output" id="balance">—</output></p><p class="note">Výpočet je iba informatívny, údaje sa neukladajú.</p></section></main><script>
const el=(id:string)=>document.getElementById(id) as HTMLInputElement;const eur=(n:number)=>new Intl.NumberFormat('sk-SK',{style:'currency',currency:'EUR',maximumFractionDigits:2}).format(n);function update(){const p=Number(el('amount').value),annual=Number(el('rate').value),r=annual/1200,n=Number(el('years').value)*12;const m=r===0?p/n:p*r/(1-Math.pow(1+r,-n));el('amountLabel').textContent=eur(p);el('rateLabel').textContent=annual.toFixed(1).replace('.',',')+' %';el('yearsLabel').textContent=n/12+' rokov';el('payment').textContent=eur(m);el('total').textContent=eur(m*n);el('cost').textContent=eur(m*n-p)}function budget(){const income=Math.max(0,Number(el('income').value)||0),expenses=Math.max(0,Number(el('expenses').value)||0);el('balance').textContent=eur(income-expenses)}['amount','rate','years'].forEach(id=>el(id).addEventListener('input',update));['income','expenses'].forEach(id=>el(id).addEventListener('input',budget));update();budget();
</script></Base>
