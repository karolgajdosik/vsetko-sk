---
import Base from '../../layouts/Base.astro';
---
<Base title="Referenčné kurzy ECB" description="Referenčné výmenné kurzy eura z Európskej centrálnej banky."><main class="wrap main" id="obsah"><p class="eyebrow"><a href="/data/">Dáta a API</a></p><h1>Výmenné kurzy ECB</h1><p class="intro">Koľko jednotiek cudzej meny pripadá na 1 EUR. Kurzy ECB sú referenčné, nie kurzovým lístkom banky.</p><div class="panel"><p id="rate-status" role="status" aria-live="polite">Načítavam referenčné kurzy…</p><div id="rate-list" class="list"></div><p id="rate-updated" class="muted"></p><button id="rate-reload" type="button">Obnoviť údaje</button></div><p>Oficiálny zdroj: <a href="https://data.ecb.europa.eu/" target="_blank" rel="noopener noreferrer">European Central Bank ↗</a>. Pri rozhodovaní o výmene peňazí si overte skutočný kurz svojej banky.</p></main><script>
const status=document.getElementById('rate-status');const list=document.getElementById('rate-list');const updated=document.getElementById('rate-updated');const reload=document.getElementById('rate-reload');
async function load(){status.textContent='Načítavam referenčné kurzy…';list.replaceChildren();updated.textContent='';reload.disabled=true;try{const response=await fetch('/api/ecb-rates',{headers:{Accept:'application/json'}});if(!response.ok)throw new Error('Unavailable');const data=await response.json();if(!Array.isArray(data.rates)||!data.rates.length)throw new Error('Empty');for(const item of data.rates){const article=document.createElement('article');article.className='article';const h=document.createElement('h2');h.textContent='1 EUR = '+Number(item.rate).toLocaleString('sk-SK',{maximumFractionDigits:5})+' '+item.currency;const p=document.createElement('p');p.textContent='Referenčný deň: '+item.date;article.append(h,p);list.append(article);}status.textContent='Kurzy načítané.';updated.textContent='Čas kontroly: '+new Date(data.checkedAt).toLocaleString('sk-SK');}catch{status.textContent='Kurzy sa nepodarilo načítať. Skúste to neskôr alebo použite oficiálny zdroj ECB.';}finally{reload.disabled=false;}}reload.addEventListener('click',load);load();
</script></Base>
