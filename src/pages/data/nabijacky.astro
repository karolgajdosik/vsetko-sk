---
import Base from '../../layouts/Base.astro';
---
<Base title="Nabíjacie stanice elektromobilov" description="Interaktívna mapa nabíjacích staníc na Slovensku podľa Open Charge Map."><main class="wrap main" id="obsah"><p class="eyebrow"><a href="/data/">Dáta a API</a></p><h1>Mapa nabíjacích staníc</h1><p class="intro">Vyhľadajte nabíjačky na Slovensku podľa oblasti. Zobrazené údaje pochádzajú z Open Charge Map a neukazujú živú obsadenosť.</p><form id="charger-form" class="panel"><label for="region">Oblasť</label><select id="region"><option value="48.1486,17.1077">Bratislava</option><option value="48.7164,21.2611">Košice</option><option value="49.2231,18.7394">Žilina</option><option value="48.9984,21.2339">Prešov</option><option value="48.3064,18.0764">Nitra</option><option value="48.7363,19.1462">Banská Bystrica</option><option value="48.8945,18.0444">Trenčín</option><option value="48.3774,17.5872">Trnava</option></select><label for="radius">Okruh</label><select id="radius"><option value="15">15 km</option><option value="30" selected>30 km</option><option value="60">60 km</option><option value="100">100 km</option></select><label for="charging-type">Typ nabíjania</label><select id="charging-type"><option value="all">Všetky</option><option value="dc">DC (jednosmerné)</option><option value="ac">AC / ostatné</option></select><button type="submit">Vyhľadať stanice</button></form><p id="charger-status" role="status" aria-live="polite">Vyberte oblasť a spustite vyhľadávanie.</p><div id="charger-map" style="height:420px;max-width:100%;border-radius:12px;background:#e5e7eb" aria-label="Mapa nabíjacích staníc"></div><div id="charger-list" class="list"></div><p class="notice">Zdroj: <a href="https://openchargemap.org/" target="_blank" rel="noopener noreferrer">Open Charge Map ↗</a>. Informácie si pred cestou overte u prevádzkovateľa; výkon, konektory ani dostupnosť nemusia byť aktuálne. Mapa používa podklady OpenStreetMap.</p></main><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/><script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script><script>
const form=document.getElementById('charger-form'),status=document.getElementById('charger-status'),list=document.getElementById('charger-list'),region=document.getElementById('region'),type=document.getElementById('charging-type');let map,layer,stations=[];
function isDc(station){return station.connections.some(c=>c.isDc)}
function draw(){list.replaceChildren();const filtered=stations.filter(s=>type.value==='all'||(type.value==='dc'?isDc(s):!isDc(s)));status.textContent='Nájdené stanice: '+filtered.length+(stations.length!==filtered.length?' (filtrované z '+stations.length+')':'');if(window.L){if(!map){map=L.map('charger-map').setView([48.7,19.5],7);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap contributors',maxZoom:18}).addTo(map);layer=L.layerGroup().addTo(map)}layer.clearLayers();const bounds=[];for(const s of filtered){const marker=L.marker([s.lat,s.lon]).addTo(layer);const detail=document.createElement('div');const heading=document.createElement('strong');heading.textContent=s.name;const info=document.createElement('p');info.textContent=s.address+' · '+s.operator;detail.append(heading,info);marker.bindPopup(detail);bounds.push([s.lat,s.lon]);}if(bounds.length)map.fitBounds(bounds,{padding:[20,20],maxZoom:13});else{const [lat,lon]=region.value.split(',').map(Number);map.setView([lat,lon],10)}setTimeout(()=>map.invalidateSize(),100)}for(const s of filtered.slice(0,100)){const article=document.createElement('article');article.className='article';const h=document.createElement('h2');h.textContent=s.name;const p=document.createElement('p');p.textContent=[s.address,s.operator,s.connections.map(c=>c.type+(c.powerKw?' '+c.powerKw+' kW':'')).join(' · ')].filter(Boolean).join(' | ');const a=document.createElement('a');a.href='https://www.openstreetmap.org/?mlat='+encodeURIComponent(s.lat)+'&mlon='+encodeURIComponent(s.lon)+'#map=16/'+encodeURIComponent(s.lat)+'/'+encodeURIComponent(s.lon);a.target='_blank';a.rel='noopener noreferrer';a.textContent='Zobraziť polohu ↗';article.append(h,p,a);list.append(article)}}
form.addEventListener('submit',async event=>{event.preventDefault();status.textContent='Načítavam nabíjacie stanice…';list.replaceChildren();const button=form.querySelector('button');button.disabled=true;try{const [lat,lon]=region.value.split(',').map(Number);const response=await fetch('/api/nabijacky?lat='+lat+'&lon='+lon+'&distance='+document.getElementById('radius').value);const data=await response.json();if(!response.ok)throw Error(data.error||'Služba je nedostupná');stations=data.stations||[];draw()}catch(e){status.textContent=e.message||'Načítanie zlyhalo.';}finally{button.disabled=false}});type.addEventListener('change',()=>{if(stations.length)draw()});
</script></Base>
