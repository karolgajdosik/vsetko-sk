---
import Base from '../../layouts/Base.astro';
---
<Base title="Vyhľadávanie firiem podľa IČO" description="Overenie základných údajov slovenskej firmy z oficiálneho Registra právnických osôb."><main class="wrap main" id="obsah"><p class="eyebrow"><a href="/data/">Dáta a API</a></p><h1>Vyhľadávanie firmy podľa IČO</h1><p class="intro">Zadajte osemmiestne IČO. Údaje získavame z oficiálneho Registra právnických osôb SR.</p><form id="rpo-form" class="panel"><label for="ico">IČO spoločnosti</label><input id="ico" name="ico" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" required placeholder="Napr. 31333532" aria-describedby="ico-help"/><p id="ico-help" class="muted">Zadajte presne 8 číslic vrátane úvodných núl.</p><button type="submit">Vyhľadať firmu</button></form><p id="rpo-status" role="status" aria-live="polite"></p><p id="rpo-fallback" class="notice" hidden>Ak register dočasne neodpovedá, môžete vyhľadať IČO priamo na <a href="https://rpo.minv.sk/new/" target="_blank" rel="noopener noreferrer">oficiálnom portáli RPO ↗</a>.</p><div id="rpo-results" class="list"></div><p class="notice">Zdroj: <a href="https://rpo.minv.sk/new/" target="_blank" rel="noopener noreferrer">oficiálny RPO ↗</a>. Údaje sa aktualizujú spravidla denne. Výsledok nie je právne záväzný výpis.</p></main><script>
const form=document.getElementById('rpo-form');const status=document.getElementById('rpo-status');const results=document.getElementById('rpo-results');
form.addEventListener('submit',async event=>{event.preventDefault();const ico=document.getElementById('ico').value.trim();results.replaceChildren();document.getElementById('rpo-fallback').hidden=true;if(!/^\d{8}$/.test(ico)){status.textContent='IČO musí mať presne osem číslic.';return;}status.textContent='Overujem IČO v registri…';const button=form.querySelector('button');button.disabled=true;try{const response=await fetch('/api/rpo?ico='+encodeURIComponent(ico));const data=await response.json();const isStale=response.status===503&&data.stale===true&&Array.isArray(data.results);if(!response.ok&&!isStale)throw new Error(data.error||'Služba je nedostupná.');if(!data.results.length){status.textContent='Pre zadané IČO sa nenašiel záznam alebo register nevrátil podporované údaje.';return;}if(isStale){const verifiedAt=Date.parse(data.checkedAt);const when=Number.isFinite(verifiedAt)?new Date(verifiedAt).toLocaleString('sk-SK'):'neznámeho dátumu';status.textContent='Register je dočasne nedostupný. Zobrazené sú uložené, aktuálne neoverené údaje z '+when+'.';document.getElementById('rpo-fallback').hidden=false;}else{status.textContent='Výsledky overenia: '+data.results.length;}for(const item of data.results){const card=document.createElement('article');card.className='article';const title=document.createElement('h2');title.textContent=item.name||'Subjekt bez názvu';const p=document.createElement('p');p.textContent='IČO: '+item.identifier;card.append(title,p);results.append(card);}}catch(e){status.textContent=e.message||'Vyhľadávanie zlyhalo.';document.getElementById('rpo-fallback').hidden=false;}finally{button.disabled=false;}});
</script></Base>
