---
import Base from '../../layouts/Base.astro';
---
<Base title="Ekonomické ukazovatele Slovenska" description="Počet obyvateľov, HDP a hospodársky rast podľa otvoreného API Svetovej banky."><main class="wrap main" id="obsah"><p class="eyebrow"><a href="/data/">Dáta a API</a></p><h1>Slovensko v číslach</h1><p class="intro">Najnovšie dostupné ročné údaje Svetovej banky. Nejde o živé meranie ani o údaje za rovnaký rok pri všetkých ukazovateľoch.</p><p id="stats-status" role="status" aria-live="polite">Načítavam ukazovatele…</p><div id="stats-list" class="list"></div><section class="panel"><h2>Porovnanie hodnôt ukazovateľov</h2><p class="note">Ukazovatele používajú rozdielne jednotky a roky. Graf zobrazuje jednotlivé hodnoty vzhľadom na najvyššiu hodnotu v aktuálnej sade; nie je určený na ekonomické porovnávanie veličín.</p><div id="stats-chart" class="stats-chart" role="img" aria-label="Relatívny prehľad aktuálnych ekonomických ukazovateľov"></div></section><button id="stats-refresh" type="button">Obnoviť údaje</button><p>Zdroj: <a href="https://data.worldbank.org/country/slovak-republic" target="_blank" rel="noopener noreferrer">World Bank Open Data ↗</a>. Hodnoty môžu byť spätne revidované.</p><p>Podrobnejšie slovenské štatistiky pripravujeme z novej databázy <a href="https://slovak.statistics.sk/wps/portal/ext/Databases/" target="_blank" rel="noopener noreferrer">STATdata ŠÚ SR ↗</a>.</p></main><script>
const status=document.getElementById('stats-status'),list=document.getElementById('stats-list'),refresh=document.getElementById('stats-refresh'),chart=document.getElementById('stats-chart');async function load(){status.textContent='Načítavam ukazovatele…';list.replaceChildren();chart.replaceChildren();refresh.disabled=true;try{const res=await fetch('/api/ukazovatele');if(!res.ok)throw Error('Unavailable');const data=await res.json();if(!Array.isArray(data.indicators))throw Error('Invalid');for(const i of data.indicators){const article=document.createElement('article');article.className='article';const h=document.createElement('h2');h.textContent=i.name;const p=document.createElement('p');p.textContent=Number(i.value).toLocaleString('sk-SK',{maximumFractionDigits:i.unit==='%'?2:0})+' '+i.unit+' · rok '+i.year;article.append(h,p);list.append(article)}const numeric=data.indicators.filter(i=>Number.isFinite(Number(i.value))&&Number(i.value)>=0);const max=Math.max(1,...numeric.map(i=>Number(i.value)));for(const i of numeric){const row=document.createElement('div');row.className='stats-row';const name=document.createElement('span');name.textContent=i.name+' ('+i.year+')';const track=document.createElement('div');track.className='stats-track';const bar=document.createElement('div');bar.className='stats-bar';bar.style.width=Number(i.value)/max*100+'%';track.append(bar);const value=document.createElement('strong');value.textContent=Number(i.value).toLocaleString('sk-SK',{maximumFractionDigits:2})+' '+i.unit;row.append(name,track,value);chart.append(row);}status.textContent='Údaje načítané. Posledná kontrola: '+new Date(data.checkedAt).toLocaleString('sk-SK')}catch{status.textContent='Údaje nie sú dostupné. Skúste to neskôr.'}finally{refresh.disabled=false}}refresh.addEventListener('click',load);load();
</script><style>.stats-chart{display:grid;gap:.8rem;margin:1rem 0}.stats-chart :global(.stats-row){display:grid;grid-template-columns:minmax(120px,1fr) 2fr minmax(100px,1fr);gap:.7rem;align-items:center}.stats-chart :global(.stats-track){height:16px;background:#94a3b855;border-radius:9px;overflow:hidden}.stats-chart :global(.stats-bar){height:100%;background:#5145d8}.stats-chart :global(.stats-row strong){overflow-wrap:anywhere}@media(max-width:700px){.stats-chart :global(.stats-row){grid-template-columns:1fr}.stats-chart :global(.stats-row strong){font-size:.85rem}}</style></Base>
