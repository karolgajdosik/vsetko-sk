---
import Base from '../../layouts/Base.astro';
---
<Base title="Ekonomické ukazovatele Slovenska" description="Počet obyvateľov, HDP a hospodársky rast podľa otvoreného API Svetovej banky."><main class="wrap main" id="obsah"><p class="eyebrow"><a href="/data/">Dáta a API</a></p><h1>Slovensko v číslach</h1><p class="intro">Najnovšie dostupné ročné údaje Svetovej banky. Nejde o živé meranie ani o údaje za rovnaký rok pri všetkých ukazovateľoch.</p><p id="stats-status" role="status" aria-live="polite">Načítavam ukazovatele…</p><div id="stats-list" class="list"></div><button id="stats-refresh" type="button">Obnoviť údaje</button><p>Zdroj: <a href="https://data.worldbank.org/country/slovak-republic" target="_blank" rel="noopener noreferrer">World Bank Open Data ↗</a>. Hodnoty môžu byť spätne revidované.</p><p>Podrobnejšie slovenské štatistiky pripravujeme z novej databázy <a href="https://slovak.statistics.sk/wps/portal/ext/Databases/" target="_blank" rel="noopener noreferrer">STATdata ŠÚ SR ↗</a>.</p></main><script>
const status=document.getElementById('stats-status'),list=document.getElementById('stats-list'),refresh=document.getElementById('stats-refresh');async function load(){status.textContent='Načítavam ukazovatele…';list.replaceChildren();refresh.disabled=true;try{const res=await fetch('/api/ukazovatele');if(!res.ok)throw Error('Unavailable');const data=await res.json();if(!Array.isArray(data.indicators))throw Error('Invalid');for(const i of data.indicators){const article=document.createElement('article');article.className='article';const h=document.createElement('h2');h.textContent=i.name;const p=document.createElement('p');p.textContent=Number(i.value).toLocaleString('sk-SK',{maximumFractionDigits:i.unit==='%'?2:0})+' '+i.unit+' · rok '+i.year;article.append(h,p);list.append(article)}status.textContent='Údaje načítané. Posledná kontrola: '+new Date(data.checkedAt).toLocaleString('sk-SK')}catch{status.textContent='Údaje nie sú dostupné. Skúste to neskôr.'}finally{refresh.disabled=false}}refresh.addEventListener('click',load);load();
</script></Base>
