---
import Base from '../../layouts/Base.astro';
import integrations from '../../data/integrations.json';
const labels={ready:'Pripravené na integráciu','key-required':'Vyžaduje API kľúč',evaluate:'V preverovaní'};
---
<Base title="Dáta a API" description="Prehľad zdrojov otvorených údajov pre VŠETKO24.sk."><main class="wrap main" id="obsah"><p class="eyebrow">Otvorené dáta</p><h1>Dáta a API</h1><p class="intro">Budujeme prepojenie na dôveryhodné dátové zdroje. Uvedenie zdroja neznamená, že už poskytujeme živé údaje.</p><p><a class="primary" href="/data/kurzy/">Zobraziť referenčné kurzy ECB →</a></p><p><a class="primary" href="/data/firmy/">Vyhľadať firmu podľa IČO →</a></p><p><a class="primary" href="/data/nabijacky/">Mapa nabíjacích staníc →</a></p><p><a class="primary" href="/data/ukazovatele/">Slovensko v číslach →</a></p><p><a class="primary" href="/data/hypoteky-nbs/">Hypotéky a sadzby NBS →</a></p><p><a class="primary" href="/data/statdata/">STATdata – oficiálne štatistiky →</a></p><div class="list">{integrations.map(item=><article class="article"><span class="tag">{item.category} · {labels[item.status]}</span><h2>{item.title}</h2><p>{item.note}</p><p>Zdroj: <a href={item.url} target="_blank" rel="noopener noreferrer">{item.provider} ↗</a></p></article>)}</div></main></Base>
