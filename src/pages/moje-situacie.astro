---
import Base from '../layouts/Base.astro';
import { CASE_TEMPLATES, VALUE_FIELDS } from '../lib/workspace-store.mjs';
---
<Base title="Moje rozpracované situácie" description="Kúpa auta, bývania a úspory domácnosti. Uložte si postup, vlastné vstupy a nadviažte dokumentmi a termínmi bez registrácie.">
<main id="obsah" class="wrap main workspace">
<p class="eyebrow">Osobný pomocník · V5</p><h1>Moje rozpracované situácie</h1>
<p class="intro">Vyriešte kúpu auta, bývania alebo úspory od prvého výpočtu po dokument a termín. Vyberte aktívny prípad a pokračujte tam, kde ste skončili.</p>
<div class="workspace-links"><a href="/vyriesit/zdrazena-sluzba/">Vyriešiť zdraženú službu</a><a href="/centrum-uspor/">Centrum úspor</a><a href="/dokumenty/">Dokumenty</a><a href="/kalendar/">Termíny</a><a href="/zaloha/">Šifrovaná záloha</a></div>
<p class="note">Názvy prípadov, zaškrtnuté kroky a vami potvrdené číselné vstupy sa ukladajú iba v tomto prehliadači. Nevkladajte mená, adresy ani čísla dokladov do názvu. Bez účtu a bez automatickej synchronizácie; pri zdieľanom zariadení použite vlastný profil prehliadača.</p>
<noscript><p>Na vytváranie a uloženie prípadu zapnite JavaScript. Návody, kalkulačky a dokumenty sú dostupné aj samostatne cez odkazy vyššie.</p></noscript>
<p id="workspace-status" role="status" aria-live="polite"></p>
<section class="panel"><h2>Začať novú situáciu</h2><form id="case-create" class="new-case"><label>Typ situácie<select id="case-kind">{Object.entries(CASE_TEMPLATES).map(([id,t])=><option value={id}>{t.title}</option>)}</select></label><label>Vlastný názov (nepovinný)<input id="case-title" maxlength="100" placeholder="Napríklad rodinné auto"/></label><button type="submit">Vytvoriť prípad</button></form></section>
<div class="case-layout"><section class="panel"><h2>Moje prípady</h2><p id="case-summary" class="note"></p><div id="case-list"></div></section>
<section class="panel" id="case-detail" hidden aria-labelledby="case-heading"><h2 id="case-heading"></h2><p id="case-progress" role="status"></p><label>Názov prípadu<input id="case-rename" maxlength="100" required/></label><button id="case-rename-save" type="button">Uložiť názov</button>
<details class="case-inputs"><summary>Spoločné vstupy a orientačný prepočet</summary><p>Vyplňte iba známe údaje a potvrďte ich uloženie. Prázdne pole znamená neznámu hodnotu, nula je platný vstup. Náklady v iných kalkulačkách prevezmete výslovným tlačidlom.</p><form id="case-values"><div class="value-grid">{Object.entries(VALUE_FIELDS).map(([id,f])=><label data-value-field={id}>{f.label}<input id={`case-${id}`} name={id} type="number" min={id==='loanYears'?'0.08333333333333333':'0'} max={f.max} step={id==='loanYears'?'any':id==='annualKm'?'1':'0.01'} inputmode="decimal"/></label>)}</div><button type="submit">Uložiť spoločné vstupy</button><button type="button" id="case-values-clear">Vymazať vstupy prípadu</button></form><div id="case-projection" role="status"></div><p class="note">Orientačný prepočet používa anuitnú splátku bez poplatkov a poistenia úveru. Pri aute zahŕňa iba zadaný servis a poistenie, palivo a ostatné výdavky doplňte v kalkulačke. Pri bývaní doplňte prevádzku v nákladoch na bývanie. Nejde o ponuku ani schválenie úveru.</p></details>
<section aria-labelledby="case-deadlines-heading"><h3 id="case-deadlines-heading">Termíny tohto prípadu</h3><div id="case-deadlines"></div><p><a href="/kalendar/">Pridať alebo upraviť termín v kalendári</a> · Pri ukladaní výslovne zvoľte priradenie k aktívnemu prípadu.</p></section>
<h3>Postup k výsledku</h3><p>Otvorenie nástroja krok automaticky nedokončí. Označte iba to, čo ste skutočne vybavili.</p><ol id="case-steps"></ol>
<div class="case-actions"><button type="button" id="case-export">Stiahnuť prehľad prípadu (.txt)</button><button type="button" id="case-delete">Odstrániť tento prípad</button></div><p>Pre bezpečný prenos všetkých údajov použite <a href="/zaloha/">šifrovanú zálohu</a>.</p>
</section></div>
</main>
<script>
import { normalizeDeadline } from '../lib/deadline-center.mjs';
import { CASE_TEMPLATES, VALUE_FIELDS, createCase, emptyWorkspace, readWorkspace, writeWorkspace, caseProjection, WORKSPACE_KEY } from '../lib/workspace-store.mjs';
const el=(id:string)=>document.getElementById(id)!;
const inp=(id:string)=>el(id) as HTMLInputElement;
let state=emptyWorkspace(); let corrupt=false; let ephemeral=false;
const message=(s:string)=>{el('workspace-status').textContent=s;};
try { state=readWorkspace(localStorage); } catch { corrupt=true; message('Úložisko nie je dostupné alebo jeho údaje nie sú platné. Pôvodné údaje neprepíšeme. Prípad môžete vytvoriť dočasne; pred odchodom stiahnite prehľad.'); }
const current=()=>state.cases.find(item=>item.id===state.activeCaseId);
function refresh(){if(corrupt||ephemeral)return;try{state=readWorkspace(localStorage);}catch{corrupt=true;message('Uložené údaje sa nepodarilo načítať. Pôvodný obsah neprepíšeme.');}}
function save(){if(corrupt){ephemeral=true;message('Zmeny sú iba dočasné v tejto stránke. Pred odchodom stiahnite prehľad.');return;}try{state=writeWorkspace(localStorage,state);ephemeral=false;message('Prípad je uložený iba v tomto prehliadači.');}catch{ephemeral=true;message('Uloženie sa nepodarilo. Zmeny sú iba v tejto stránke; stiahnite prehľad pred odchodom.');}}
function touch(item:any){item.updatedAt=new Date().toISOString();}
const euros=(v:number)=>new Intl.NumberFormat('sk-SK',{style:'currency',currency:'EUR'}).format(v);
function render(){
 const list=el('case-list');list.replaceChildren();
 const done=state.cases.filter(item=>item.completed.length===CASE_TEMPLATES[item.kind].steps.length).length;
 el('case-summary').textContent=state.cases.length?`${state.cases.length} prípadov · dokončené podľa vášho označenia: ${done}`:'Zatiaľ nemáte prípad. Vyberte situáciu vyššie.';
 for(const item of state.cases){const b=document.createElement('button');b.type='button';b.className='case-select';b.textContent=item.title+' · '+item.completed.length+'/'+CASE_TEMPLATES[item.kind].steps.length;b.setAttribute('aria-pressed',String(item.id===state.activeCaseId));b.addEventListener('click',()=>{refresh();state.activeCaseId=item.id;save();render();el('case-heading').focus();});list.append(b);}
 const item=current();el('case-detail').hidden=!item;if(!item)return;
 el('case-heading').textContent=item.title;el('case-heading').setAttribute('tabindex','-1');inp('case-rename').value=item.title;
 const termBox=el('case-deadlines');termBox.replaceChildren();try{const raw=localStorage.getItem('v24-personal-center-v1');const center=raw?JSON.parse(raw):null;if(center&&(!Array.isArray(center.deadlines)||center.version!==1))throw new Error('invalid');const terms=(center?.deadlines??[]).slice(0,500).map(normalizeDeadline).filter(d=>d&&d.caseId===item.id).sort((a,b)=>a.date.localeCompare(b.date));if(!terms.length)termBox.textContent='K tomuto prípadu zatiaľ nie je priradený termín.';else{const ul=document.createElement('ul');for(const d of terms){const li=document.createElement('li');li.textContent=d.date+' · '+d.title;ul.append(li);}termBox.append(ul);}}catch{termBox.textContent='Termíny sa nepodarilo načítať. Samotný prípad môžete používať ďalej.';}
 const t=CASE_TEMPLATES[item.kind];el('case-progress').textContent=`${t.title}: dokončené ${item.completed.length} z ${t.steps.length} krokov. Tento prípad preberú ďalšie nástroje až po vašom potvrdení.`;
 for(const key of Object.keys(VALUE_FIELDS)){inp('case-'+key).value=item.values[key]===undefined?'':String(item.values[key]);const applicable=item.kind==='car'||(item.kind==='home'?!['annualKm','fuelPrice','consumption','monthlyService','monthlyInsurance'].includes(key):['monthlyIncome','monthlyExpenses'].includes(key));(document.querySelector(`[data-value-field="${key}"]`) as HTMLElement).hidden=!applicable;inp('case-'+key).disabled=!applicable;}
 const projection=caseProjection(item);const lines=[];
 if(projection.surplus!==null)lines.push('Mesačný zostatok pred novým záväzkom: '+euros(projection.surplus));
 if(item.values.purchasePrice!==undefined){lines.push('Financovaná suma po vlastnom vklade: '+euros(projection.principal));if(projection.payment!==null)lines.push('Orientačná mesačná splátka: '+euros(projection.payment));else lines.push('Na prepočet splátky doplňte splatnosť a sadzbu.');if((item.values.downPayment??0)>item.values.purchasePrice)lines.push('Vlastné peniaze prevyšujú cenu; financovaná suma je nulová.');}
 if(item.kind==='car'&&projection.remaining!==null&&item.values.purchasePrice!==undefined)lines.push('Zostatok po splátke, servise a poistení (bez paliva a ďalších nákladov): '+euros(projection.remaining));
 el('case-projection').textContent=lines.join(' · ')||'Vstupy zatiaľ nie sú uložené.';
 const steps=el('case-steps');steps.replaceChildren();
 for(const step of t.steps){const li=document.createElement('li');const a=document.createElement('a');a.href=step.href;a.textContent=step.title;const label=document.createElement('label');const c=document.createElement('input');c.type='checkbox';c.checked=item.completed.includes(step.id);c.setAttribute('aria-label','Hotovo – '+step.title);c.addEventListener('change',()=>{refresh();const latest=state.cases.find(c=>c.id===item.id);if(!latest)return;latest.completed=c.checked?[...new Set([...latest.completed,step.id])]:latest.completed.filter(id=>id!==step.id);touch(latest);save();const focusId=step.id;render();const controls=el('case-steps').querySelectorAll<HTMLInputElement>('input');controls[t.steps.findIndex(s=>s.id===focusId)]?.focus();});label.append(c,' Hotovo');li.append(a,label);steps.append(li);}
}
el('case-create').addEventListener('submit',e=>{e.preventDefault();refresh();if(state.cases.length>=30){message('Najviac 30 prípadov. Pred vytvorením ďalšieho odstráňte nepotrebný prípad.');return;}try{const item=createCase(inp('case-kind').value,inp('case-title').value);state.cases.push(item);state.activeCaseId=item.id;save();inp('case-title').value='';render();el('case-heading').focus();}catch{message('Prípad sa nepodarilo vytvoriť. Skontrolujte názov a typ situácie.');}});
el('case-rename-save').addEventListener('click',()=>{const name=inp('case-rename').value.trim();if(!name){message('Názov nesmie byť prázdny.');inp('case-rename').focus();return;}const intended=current()?.id;refresh();const item=state.cases.find(c=>c.id===intended);if(!item)return;item.title=name;touch(item);save();render();});
el('case-values').addEventListener('submit',e=>{e.preventDefault();const intended=current()?.id;const values:Record<string,number>={};for(const key of Object.keys(VALUE_FIELDS)){const field=inp('case-'+key);if(!field.disabled&&field.value!==''){if(!field.checkValidity()){field.reportValidity();return;}values[key]=Number(field.value);}}refresh();const item=state.cases.find(c=>c.id===intended);if(!item)return;item.values=values;touch(item);save();render();});
el('case-values-clear').addEventListener('click',()=>{const intended=current()?.id;if(!confirm('Vymazať iba spoločné číselné vstupy tohto prípadu?'))return;refresh();const item=state.cases.find(c=>c.id===intended);if(!item)return;item.values={};touch(item);save();render();});
el('case-delete').addEventListener('click',()=>{const intended=current()?.id;if(!confirm('Odstrániť tento prípad a jeho vstupy? Termíny a údaje v ostatných nástrojoch zostanú.'))return;refresh();state.cases=state.cases.filter(item=>item.id!==intended);state.activeCaseId=state.cases[0]?.id??null;save();render();});
el('case-export').addEventListener('click',()=>{const item=current();if(!item)return;const lines=[item.title,CASE_TEMPLATES[item.kind].title,'Uložené vstupy:',...Object.entries(item.values).map(([k,v])=>VALUE_FIELDS[k].label+': '+v),'Postup:',...CASE_TEMPLATES[item.kind].steps.map(s=>`${item.completed.includes(s.id)?'[x]':'[ ]'} ${s.title} – https://vsetko24.sk${s.href}`),'Export obsahuje vaše údaje. Uložte ho na súkromné miesto.'];const url=URL.createObjectURL(new Blob([lines.join('\n')],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='moja-situacia.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);message('Prehľad je pripravený na stiahnutie. Obsahuje vaše zadané hodnoty.');});
window.addEventListener('storage',event=>{if(event.key===WORKSPACE_KEY||event.key==='v24-personal-center-v1'){refresh();render();}});window.addEventListener('pageshow',()=>{refresh();render();});render();
</script>
<style>
.workspace{max-width:1120px}.workspace .panel{padding:1.4rem;margin:1.2rem 0}.workspace-links,.case-actions{display:flex;flex-wrap:wrap;gap:1rem}.workspace-links a{padding:.7rem;border:1px solid #8290a5;border-radius:9px}.new-case,.value-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.new-case button{align-self:end}.workspace label{display:block;font-weight:650}.workspace input:not([type=checkbox]),.workspace select{display:block;width:100%;padding:.8rem;background:var(--surface);color:var(--ink);border:1px solid #8290a5;border-radius:9px;font:inherit}.workspace :global(button){padding:.75rem;border:1px solid #8290a5;border-radius:9px;background:var(--surface);color:var(--ink);font:inherit;cursor:pointer;min-height:44px}.case-layout{display:grid;grid-template-columns:minmax(220px,1fr) minmax(0,2fr);gap:1.3rem}.workspace :global(.case-select){display:block;width:100%;text-align:left;margin:.7rem 0;overflow-wrap:anywhere}.workspace :global(.case-select[aria-pressed=true]){border:2px solid var(--ink);font-weight:750}.case-inputs{margin:1.4rem 0}.case-inputs summary{cursor:pointer;font-weight:700;padding:.7rem 0}.workspace :global(#case-steps li){padding:.8rem 0}.workspace :global(#case-steps label){display:flex;gap:.7rem;align-items:center;min-height:44px}.workspace :global(#case-steps input){width:1.2rem;height:1.2rem}.workspace :global(#case-steps a){display:inline-block;min-height:44px;padding:.5rem 0}#case-projection{margin-top:1rem;white-space:pre-line;overflow-wrap:anywhere}.workspace [hidden]{display:none!important}@media(max-width:720px){.case-layout,.new-case,.value-grid{grid-template-columns:1fr}.workspace .panel{padding:1rem}}
</style>
</Base>
