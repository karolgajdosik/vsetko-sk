---
import Base from '../layouts/Base.astro';
---
<Base title="Moje zmluvy a predplatné" description="Súkromný register cien, obnovy a vlastných lehôt zmlúv bez registrácie.">
<main class="wrap main contracts" id="obsah"><p class="eyebrow">V6 · Moja domácnosť</p><h1>Moje zmluvy a predplatné</h1><p class="intro">Evidujte pravidelné platby a vlastné termíny. Údaje zostávajú v tomto prehliadači; nič sa neposiela poskytovateľom služieb.</p><p>Presný dátum obnovy, lehotu, spôsob a podmienky ukončenia overte vo svojej zmluve. Výpočet dní je len plánovacia pomôcka a neurčuje právnu výpovednú lehotu.</p>
<section class="panel"><h2 id="contract-editor-heading">Pridať zmluvu</h2><form id="contract-form"><div class="fields"><label>Názov zmluvy<input id="contract-title" required maxlength="100" autocomplete="off" /></label><label>Poskytovateľ (nepovinné)<input id="contract-provider" maxlength="100" autocomplete="off" /></label><label>Kategória<select id="contract-category"><option value="telecom">Telefón a internet</option><option value="energy">Energie</option><option value="insurance">Poistenie</option><option value="subscription">Predplatné</option><option value="other">Iné</option></select></label><label>Výška jednej platby (€)<input id="contract-payment" type="number" min="0" max="1000000" step="0.01" required /></label><label>Frekvencia platby<select id="contract-frequency"><option value="monthly">Mesačne</option><option value="yearly">Ročne</option></select></label><label>Dátum obnovy (nepovinné)<input id="contract-renewal" type="date" min="1900-01-01" max="9999-12-31" /></label><label>Koľko kalendárnych dní pred obnovou skontrolovať lehotu<input id="contract-notice" type="number" min="0" max="3650" step="1" value="0" required /></label></div><p class="note">Nezadávajte číslo zmluvy ani osobné identifikátory. Pred uložením termínov sa zobrazia vypočítané dátumy pri zmluve.</p><div class="actions"><button type="submit" id="contract-save">Uložiť zmluvu</button><button type="button" id="contract-cancel" hidden>Zrušiť úpravu</button></div></form></section>
<p id="contract-status" role="status" aria-live="polite"></p><section class="panel" aria-labelledby="contract-list-heading"><h2 id="contract-list-heading">Uložené zmluvy</h2><p id="contract-summary"></p><div id="contract-list"></div></section>
<section class="panel"><h2>Ďalší krok</h2><p>V <a href="/centrum-uspor/">centre úspor</a> porovnajte vlastné ponuky vrátane poplatkov a viazanosti. V <a href="/dokumenty/">dokumentoch</a> pripravte výpoveď po overení podmienok. Údaje sa prenesú do dokumentu iba po zvolení tlačidla „Pripraviť výpoveď“ a následnom potvrdení v dokumentoch.</p><p><a href="/kalendar/">Otvoriť kalendár a exportovať termíny</a> · <a href="/zaloha/">Zálohovať osobný priestor</a></p><p class="note">Pridanie termínov je samostatný krok. Zmena alebo odstránenie zmluvy už uložené termíny automaticky nemení; pri zmene dátumu ich pridajte znovu a pri odstránení skontrolujte kalendár. Portál neposiela upozornenia na pozadí.</p></section><noscript><p>Na evidenciu zmlúv je potrebný JavaScript.</p></noscript></main>
</Base>
<script>
import { CONTRACTS_KEY, emptyContracts, readContracts, normalizeContracts, contractMonthlyAmount, contractNoticeDate, addContractDeadlines } from '../lib/contract-store.mjs';
const el=(id:string)=>document.getElementById(id)!;const field=(id:string)=>el(id) as HTMLInputElement;const form=el('contract-form') as HTMLFormElement;let state=emptyContracts(),snapshot:string|null=null,blocked=false,editing:string|null=null;
const money=(n:number)=>new Intl.NumberFormat('sk-SK',{style:'currency',currency:'EUR'}).format(n);const status=(s:string)=>el('contract-status').textContent=s;
function load(){try{snapshot=localStorage.getItem(CONTRACTS_KEY);state=readContracts(localStorage);blocked=false;}catch{blocked=true;status('Úložisko je nedostupné alebo register poškodený. Pôvodné údaje sa neprepíšu.');}render();}
function save(next:typeof state){if(blocked)throw Error('Ukladanie je zablokované, aby sa zachovali pôvodné údaje.');const validated=normalizeContracts(next);if(localStorage.getItem(CONTRACTS_KEY)!==snapshot)throw Error('Register sa zmenil v inom okne. Obnovte stránku.');const raw=JSON.stringify(validated);localStorage.setItem(CONTRACTS_KEY,raw);snapshot=raw;state=validated;render();}
function reset(){editing=null;form.reset();el('contract-editor-heading').textContent='Pridať zmluvu';el('contract-save').textContent='Uložiť zmluvu';el('contract-cancel').hidden=true;}
function render(){const list=el('contract-list');list.replaceChildren();el('contract-summary').textContent=state.entries.length?state.entries.length+' zmlúv · Priemer pravidelných platieb: '+money(state.entries.reduce((sum,item)=>sum+contractMonthlyAmount(item),0))+' mesačne. Ročné platby delíme 12; nejde o skutočný rozpis splatnosti.':'Zatiaľ nemáte uloženú zmluvu.';
 for(const item of state.entries){const article=document.createElement('article');const title=document.createElement('h3');title.textContent=item.title;const details=document.createElement('p');details.textContent=(item.provider?item.provider+' · ':'')+money(item.paymentAmount)+(item.paymentFrequency==='yearly'?' ročne':' mesačne');article.append(title,details);const timing=document.createElement('p');timing.textContent=item.renewalDate?'Obnova: '+item.renewalDate+' · Kontrola lehoty: '+(contractNoticeDate(item)||'mimo podporovaného rozsahu')+' ('+item.noticeDays+' dní vopred).':'Dátum obnovy nie je zadaný.';article.append(timing);
 const actions=document.createElement('div');actions.className='actions';const button=(label:string,fn:()=>void)=>{const b=document.createElement('button');b.type='button';b.textContent=label;b.addEventListener('click',fn);actions.append(b);return b;};button('Upraviť '+item.title,()=>{editing=item.id;field('contract-title').value=item.title;field('contract-provider').value=item.provider;field('contract-category').value=item.category;field('contract-payment').value=String(item.paymentAmount);field('contract-frequency').value=item.paymentFrequency;field('contract-renewal').value=item.renewalDate;field('contract-notice').value=String(item.noticeDays);el('contract-editor-heading').textContent='Upraviť zmluvu';el('contract-save').textContent='Uložiť úpravu';el('contract-cancel').hidden=false;field('contract-title').focus();});
 const calendar=button('Pridať termíny: '+item.title,()=>{try{const added=addContractDeadlines(localStorage,item);status('Do kalendára uložené '+added.length+' termíny pre '+item.title+'. Rovnaké termíny sa neduplikujú.');}catch(error){status((error as Error).message);}});calendar.disabled=!item.renewalDate||blocked;
 button('Odstrániť '+item.title,()=>{if(!confirm('Odstrániť zmluvu „'+item.title+'“? Jej termíny v kalendári zostanú.'))return;try{save({version:1,entries:state.entries.filter(x=>x.id!==item.id)});if(editing===item.id)reset();status('Zmluva odstránená. Skontrolujte samostatne jej termíny v kalendári.');field('contract-title').focus();}catch(error){status((error as Error).message);}});button('Pripraviť výpoveď: '+item.title,()=>{try{sessionStorage.setItem('v24-contract-draft-v6',JSON.stringify({provider:item.provider,title:item.title,renewalDate:item.renewalDate,noticeDays:item.noticeDays}));location.assign('/dokumenty/?source=contract');}catch{status('Prenos nie je dostupný. Otvorte Dokumenty a údaje doplňte ručne.');}});article.append(actions);list.append(article);}}
form.addEventListener('submit',event=>{event.preventDefault();try{const item={id:editing||crypto.randomUUID(),title:field('contract-title').value,provider:field('contract-provider').value,category:field('contract-category').value,paymentAmount:field('contract-payment').valueAsNumber,paymentFrequency:field('contract-frequency').value,renewalDate:field('contract-renewal').value,noticeDays:field('contract-notice').valueAsNumber};save({version:1,entries:[...state.entries.filter(x=>x.id!==item.id),item]});reset();window.dispatchEvent(new CustomEvent('v24:complete',{detail:{tool:'contracts'}}));status('Zmluva uložená iba v tomto prehliadači. Termíny pridáte samostatným tlačidlom.');}catch(error){status((error as Error).message);}});el('contract-cancel').addEventListener('click',()=>{reset();field('contract-title').focus();});load();
</script>
<style>
.contracts{max-width:1000px}.contracts .panel{padding:1.3rem;margin:1.3rem 0}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.contracts label{display:block;font-weight:650}.contracts input,.contracts select{display:block;box-sizing:border-box;width:100%;font:inherit;padding:.75rem;margin-top:.4rem;background:var(--surface);color:var(--ink);border:1px solid #8290a5;border-radius:8px;min-height:44px}.actions{display:flex;flex-wrap:wrap;gap:.7rem;margin:1rem 0}.contracts button{font:inherit;padding:.7rem 1rem;min-height:44px;border:1px solid #8290a5;border-radius:8px;background:var(--surface);color:var(--ink);cursor:pointer;overflow-wrap:anywhere;max-width:100%}.contracts button:disabled{opacity:.6;cursor:default}.contracts article{border-top:1px solid #8290a5;padding:1rem 0;overflow-wrap:anywhere}.contracts :is(input,select,button):focus-visible{outline:3px solid currentColor;outline-offset:3px}.contracts [hidden]{display:none!important}@media(max-width:650px){.fields{grid-template-columns:1fr}.contracts .panel{padding:1rem}}
</style>
