---
import Base from '../../layouts/Base.astro';
const fields = [
  {id:'monthlyPayment',label:'Nájom alebo splátka hypotéky mesačne (€)',value:850},
  {id:'energy',label:'Energie, kúrenie a voda mesačne (€)',value:180},
  {id:'management',label:'Správa domu a fond opráv mesačne (€)',value:70},
  {id:'internet',label:'Internet, TV a ďalšie služby mesačne (€)',value:25},
  {id:'parking',label:'Parkovanie mesačne (€)',value:0},
  {id:'maintenance',label:'Rezerva na údržbu a drobné opravy mesačne (€)',value:60},
  {id:'insuranceYear',label:'Poistenie bývania ročne (€)',value:180},
  {id:'taxYear',label:'Daň z nehnuteľnosti a ďalšie ročné poplatky (€)',value:50},
  {id:'upfront',label:'Jednorazové vybavovacie a sťahovacie výdavky (€)',value:1500},
  {id:'income',label:'Čistý mesačný príjem domácnosti (€; nepovinné)',value:2500}
];
---
<Base title="Celkové výdavky na bývanie – kalkulačka" description="Vypočítajte mesačné, ročné a dlhodobé výdavky na bývanie vrátane energií, správy, poistenia a jednorazových poplatkov.">
  <main class="wrap main" id="obsah">
    <p class="eyebrow">Bývanie · Bezplatná kalkulačka</p>
    <h1>Koľko vás skutočne stojí bývanie?</h1>
    <p>Samotné nájomné alebo splátka hypotéky nie sú celý mesačný rozpočet. Doplňte energie, správu, poistenie a ďalšie náklady. Výpočet prebieha iba vo vašom prehliadači, bez registrácie a ukladania údajov.</p>
    <form id="housing-form" class="housing-form" novalidate>
      <div class="housing-fields">
        {fields.map(field => <div class="housing-field">
          <label for={field.id}>{field.label}</label>
          <input type="number" id={field.id} min="0" max="5000000" step="0.01" inputmode="decimal" value={field.value}/>
        </div>)}
        <div class="housing-field">
          <label for="years">Obdobie plánovania (roky)</label>
          <input type="number" id="years" min="1" max="30" step="1" inputmode="numeric" value="5"/>
        </div>
      </div>
      <button type="reset" class="housing-reset">Obnoviť predvolené hodnoty</button>
      <p id="housing-error" role="alert" hidden>Skontrolujte vstupy. Výdavky musia byť nezáporné čísla a obdobie celé číslo od 1 do 30 rokov.</p>
    </form>
    <section aria-labelledby="housing-results-title" class="housing-results">
      <h2 id="housing-results-title">Váš prehľad výdavkov</h2>
      <div class="housing-results-grid" aria-live="polite">
        <div class="housing-result"><small>Bežné mesačné výdavky</small><strong id="housing-regular">—</strong></div>
        <div class="housing-result"><small>Mesačný priemer vrátane jednorazových výdavkov</small><strong id="housing-monthly">—</strong></div>
        <div class="housing-result"><small>Ročný priemer</small><strong id="housing-annual">—</strong></div>
        <div class="housing-result"><small>Celkom za plánované obdobie</small><strong id="housing-total">—</strong></div>
        <div class="housing-result"><small>Podiel z čistého príjmu domácnosti</small><strong id="housing-share">—</strong></div>
      </div>
      <p class="housing-note">Mesačný priemer rozpočítava jednorazové výdavky rovnomerne počas zvoleného obdobia. Ročný priemer zodpovedá dvanástim takýmto priemerným mesiacom. Ak nezadáte príjem, podiel z príjmu sa nevypočíta.</p>
    </section>
    <button type="button" id="housing-print" class="housing-reset">Vytlačiť alebo uložiť výsledky ako PDF</button>
    <section aria-labelledby="housing-method" class="panel">
      <h2 id="housing-method">Čo výpočet zahŕňa?</h2>
      <p>Priebežné platby, náklady na energie a služby, ročné poistenie a dane prepočítané na mesiace, rezervu na údržbu a samostatne zadané jednorazové výdavky.</p>
      <p><strong>Upozornenie:</strong> Toto je model peňažných výdavkov domácnosti, nie investičný výpočet návratnosti nehnuteľnosti. Pri hypotéke zahŕňa aj splácanie istiny, hoci tým vzniká vlastnícky podiel. Nezahŕňa zmeny sadzieb, infláciu, zhodnotenie nehnuteľnosti ani prípadné daňové úľavy. Nedávajte jeden výdavok do viacerých polí.</p>
      <p>Ďalšie nástroje: <a href="/financie/porovnanie-hypotek/">Porovnanie hypoték</a> · <a href="/byvanie/">Bývanie a nehnuteľnosti</a>. Viac o kategóriách nákladov: <a href="https://eures.europa.eu/living-and-working/living-and-working-conditions-europe/living-and-working-conditions-slovakia_en" target="_blank" rel="noopener noreferrer">EURES – životné podmienky na Slovensku</a>.</p>
    </section>
  </main>
</Base>
<style>
  .housing-form{margin:1.5rem 0}
  .housing-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:1rem}
  .housing-field{display:flex;flex-direction:column;gap:.4rem}
  .housing-field label{font-weight:650}
  .housing-field input{box-sizing:border-box;width:100%;padding:.8rem;border:1px solid #8191a5;border-radius:.65rem;background:transparent;color:inherit;font:inherit}
  .housing-reset{margin-top:1rem;padding:.75rem 1rem;border:1px solid #8191a5;border-radius:.65rem;background:transparent;color:inherit;font:inherit;cursor:pointer}
  .housing-reset:hover,.housing-reset:focus-visible{outline:2px solid currentColor;outline-offset:2px}
  .housing-results{margin:1.5rem 0 2rem}
  .housing-results-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,205px),1fr));gap:.75rem}
  .housing-result{display:flex;flex-direction:column;gap:.4rem;padding:1rem;border:1px solid #8d9aaa;border-radius:.75rem}
  .housing-result small{font-size:.85rem}
  .housing-result strong{font-size:clamp(1.15rem,2.5vw,1.65rem);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
  .housing-note{margin-top:1rem}
  @media print{.housing-form,.housing-reset{display:none!important}.housing-results{break-inside:avoid}}
  #housing-error[hidden]{display:none}
</style>
<script>
  import {calculateHousingCosts} from '../../lib/housing-costs.mjs';
  const ids=['monthlyPayment','energy','management','internet','parking','maintenance','insuranceYear','taxYear','upfront','income','years'];
  const el=(id:string)=>document.getElementById(id) as HTMLInputElement;
  const output=(id:string)=>document.getElementById(id) as HTMLElement;
  const euro=(value:number)=>new Intl.NumberFormat('sk-SK',{style:'currency',currency:'EUR',maximumFractionDigits:2}).format(value);
  function update(){
    const inputs=Object.fromEntries(ids.map(id=>[id,id==='income' && el(id).value.trim()==='' ? 0 : el(id).valueAsNumber]));
    const result=calculateHousingCosts(inputs);
    const error=output('housing-error');
    error.hidden=Boolean(result);
    if(!result){
      for(const id of ['housing-regular','housing-monthly','housing-annual','housing-total','housing-share'])output(id).textContent='—';
      return;
    }
    output('housing-regular').textContent=euro(result.monthlyRecurring);
    output('housing-monthly').textContent=euro(result.monthlyAverage);
    output('housing-annual').textContent=euro(result.annualAverage);
    output('housing-total').textContent=euro(result.horizonTotal);
    output('housing-share').textContent=result.shareOfIncome===null?'Nezadané':new Intl.NumberFormat('sk-SK',{maximumFractionDigits:1}).format(result.shareOfIncome)+' %';
  }
  document.getElementById('housing-form')?.addEventListener('input',update);
  document.getElementById('housing-form')?.addEventListener('reset',()=>requestAnimationFrame(update));
  document.getElementById("housing-print")?.addEventListener("click",()=>window.print());
  update();
</script>