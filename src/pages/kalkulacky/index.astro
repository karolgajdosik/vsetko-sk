---
import Base from '../../layouts/Base.astro';
import catalog from '../../data/calculators.json';
const all=[{slug:'hypoteka',title:'Hypotekárna kalkulačka',category:'Financie',description:'Splátka hypotéky',url:'/financie/#hypoteka'},{slug:'rozpocet',title:'Rodinný rozpočet',category:'Financie',description:'Mesačné príjmy a výdavky',url:'/financie/#rozpocet'},{slug:'naklady-na-auto',title:'Náklady na auto',category:'Auto',description:'Celkové prevádzkové náklady',url:'/kalkulacky/naklady-na-auto/'},...catalog.map(t=>({...t,url:'/kalkulacky/'+t.slug+'/'}))];
---
<Base title="Všetky kalkulačky" description="Bezplatné finančné a automobilové kalkulačky na jednom mieste."><main class="wrap main" id="obsah"><p class="eyebrow">Nástroje</p><h1>Všetky kalkulačky</h1><p class="intro">18 bezplatných nástrojov. Výpočty prebiehajú vo vašom prehliadači.</p><div class="list">{all.map(t=><a class="article" href={t.url}><span class="tag">{t.category}</span><h3>{t.title} →</h3><p class="muted">{t.description}</p></a>)}</div></main></Base>