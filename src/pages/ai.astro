---
import Base from '../layouts/Base.astro';
---
<Base title="VŠETKO AI – asistent" description="Položte otázku po slovensky a získajte orientačnú odpoveď s odkazmi na návody portálu.">
<main class="wrap main ai-page" id="obsah">
<p class="eyebrow">VŠETKO AI · Pilotná verzia</p><h1>Spýtajte sa asistenta</h1>
<p class="intro">Asistent odpovedá po slovensky na základe vybraných návodov portálu. Ak nemá dostatočné podklady, prizná to. Odpovede nie sú úradným, právnym ani finančným poradenstvom.</p>
<section class="panel ai-box" aria-label="Konverzácia s AI asistentom">
<div id="ai-conversation" class="ai-conversation" aria-live="polite"><div class="ai-message ai-bot">Dobrý deň! S čím vám môžem pomôcť? Napríklad s občianskym preukazom, hypotékou alebo prepisom auta.</div></div>
<form id="ai-form"><label for="ai-question">Vaša otázka</label><div class="ai-input"><textarea id="ai-question" maxlength="600" rows="2" required placeholder="Napríklad: Čo robiť, keď stratím občiansky preukaz?"></textarea><button id="ai-submit" type="submit">Odoslať</button></div><p class="note">Nepíšte rodné čísla, adresy, zdravotné ani iné citlivé údaje. Otázka sa odošle AI službe Cloudflare len v prípade aktivovaného modelu. Bez aktivácie použite <a href="/hladat/">fulltext</a>.</p></form>
</section>
<p class="note">AI môže robiť chyby. Vždy si overte aktuálne postupy v odkazovaných oficiálnych zdrojoch. Táto verzia neuchováva históriu konverzácie na portáli.</p>
</main>
<script>
const form=document.querySelector<HTMLFormElement>('#ai-form')!;
const field=document.querySelector<HTMLTextAreaElement>('#ai-question')!;
const button=document.querySelector<HTMLButtonElement>('#ai-submit')!;
const conversation=document.querySelector<HTMLElement>('#ai-conversation')!;
function bubble(message:string,role:'ai-user'|'ai-bot'){const div=document.createElement('div');div.className='ai-message '+role;div.textContent=message;conversation.append(div);return div;}
form.addEventListener('submit',async e=>{e.preventDefault();const question=field.value.trim();if(question.length<3)return;button.disabled=true;field.disabled=true;bubble(question,'ai-user');field.value='';const response=bubble('Pripravujem odpoveď…','ai-bot');try{const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),18000);let r:Response;try{r=await fetch('/api/assistant',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question}),signal:controller.signal});}finally{clearTimeout(timer);}const data=await r.json();response.textContent=r.ok?data.answer:(data.error||'Služba je nedostupná.');if(r.ok&&Array.isArray(data.sources)&&data.sources.length){const links=document.createElement('div');links.className='ai-sources';const label=document.createElement('strong');label.textContent='Súvisiace návody:';links.append(label);for(const item of data.sources){if(typeof item.url!=='string'||!/^\/(?:navody|kalkulacky|sprievodca)\//.test(item.url))continue;const a=document.createElement('a');a.href=item.url;a.textContent=item.title+' ↗';links.append(a);}response.append(links);}if(r.ok&&Array.isArray(data.officialSources)&&data.officialSources.length){const official=document.createElement('div');official.className='ai-sources';const title=document.createElement('strong');title.textContent='Oficiálny zdroj:';official.append(title);for(const source of data.officialSources){if(typeof source.url!=='string'||!source.url.startsWith('https://www.slovensko.sk/'))continue;const a=document.createElement('a');a.href=source.url;a.target='_blank';a.rel='noopener noreferrer';a.textContent=source.title+' ↗';official.append(a);}response.append(official);}}catch{response.textContent='Spojenie sa nepodarilo. Skúste to neskôr alebo použite fulltext.';}finally{button.disabled=false;field.disabled=false;field.focus();response.scrollIntoView({block:'nearest',behavior:'smooth'});}});
</script>
<style>
.ai-page{max-width:900px}.ai-box{padding:1.4rem;background:var(--surface)}.ai-conversation{display:flex;flex-direction:column;gap:1rem;min-height:180px;margin-bottom:2rem}:global(.ai-message){max-width:92%;border-radius:16px;padding:1rem 1.2rem;line-height:1.65;white-space:pre-wrap;overflow-wrap:anywhere}:global(.ai-bot){align-self:flex-start;background:var(--surface);border:1px solid #7c8ca5;color:var(--ink)}:global(.ai-user){align-self:flex-end;background:#5145d8;color:white;border:2px solid #8177ed}.ai-input{display:flex;gap:.7rem}.ai-input textarea{flex:1;min-width:0;padding:.9rem;border:1px solid #8a9bb4;border-radius:12px;background:var(--surface);color:var(--ink);font:inherit}.ai-input button{background:#5145d8;color:#fff;border:0;border-radius:12px;padding:1rem}.ai-input button:disabled{opacity:.5;cursor:wait}:global(.ai-sources){display:flex;flex-direction:column;gap:.6rem;margin-top:1.1rem;padding-top:.9rem;border-top:1px solid #8794aa;white-space:normal}:global(.ai-sources strong){display:block}:global(.ai-sources a){display:block;overflow-wrap:anywhere}:global(.ai-sources a){text-decoration:underline}.ai-page label{display:block;font-weight:700;margin-bottom:.6rem}@media(max-width:550px){.ai-input{flex-direction:column}:global(.ai-message){max-width:100%}}
</style>
</Base>