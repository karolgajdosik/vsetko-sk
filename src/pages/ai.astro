---
import Base from '../layouts/Base.astro';
---
<Base title="VŠETKO AI – asistent" description="Položte otázku po slovensky a získajte orientačnú odpoveď s odkazmi na návody portálu.">
<main class="wrap main ai-page" id="obsah">
<p class="eyebrow">VŠETKO AI · Praktický sprievodca</p><h1>Spýtajte sa asistenta</h1>
<p class="intro">Asistent odpovedá po slovensky na základe vybraných návodov portálu. Ak nemá dostatočné podklady, prizná to. Odpovede nie sú úradným, právnym ani finančným poradenstvom.</p>
<section class="panel ai-path"><h2>Vyhľadávanie naprieč portálom</h2><p>Vyhľadajte overiteľné návody a kalkulačky bez odosielania otázky AI modelu.</p><label for="knowledge-query">Hľadať nástroje a návody</label><input id="knowledge-query" type="search" placeholder="Napríklad hypotéka, občiansky preukaz…" maxlength="600" autocomplete="off"/><div class="knowledge-filters"><div><label for="knowledge-category">Oblasť</label><select id="knowledge-category"><option value="">Všetky oblasti</option></select></div><div><label for="knowledge-kind">Čo hľadáte?</label><select id="knowledge-kind"><option value="">Všetky výsledky</option><option value="guide">Návody a postupy</option><option value="calculator">Kalkulačky</option><option value="other">Ostatné nástroje a stránky</option></select></div></div><p id="knowledge-summary" class="note" role="status">Napíšte tému a podľa potreby spresnite oblasť alebo typ výsledku. Toto vyhľadávanie zostáva v prehliadači.</p><div id="knowledge-results" aria-live="polite"></div></section><section class="panel ai-path"><h2>Vyriešte životnú situáciu</h2><p>Vyberte si situáciu a otvárajte jednotlivé kroky. Tlačidlom Späť sa vrátite k plánu. Dokončené kroky si môžete označiť v tejto karte.</p><label for="ai-goal">Čo potrebujete vyriešiť?</label><select id="ai-goal"><option value="">Vyberte situáciu</option><option value="home">Kúpa bytu</option><option value="car">Kúpa auta</option><option value="documents">Strata dokladu</option><option value="business">Začiatok podnikania</option><option value="budget">Rozpočet domácnosti</option><option value="vehicle">Prevádzka auta</option><option value="services">Porovnanie služieb</option></select><p id="ai-path-status" role="status"></p><ol id="ai-path-links"></ol><button type="button" id="ai-path-reset" hidden>Zrušiť označenia v tomto postupe</button></section>
<section class="panel ai-quick" aria-label="Rýchle otázky"><h2>Čo potrebujete vyriešiť?</h2><div class="quick-grid"><button type="button" data-question="Ako postupovať pri kúpe bytu a porovnaní hypoték?">🏠 Kúpa bytu</button><button type="button" data-question="Čo potrebujem na prepis auta?">🚗 Prepis auta</button><button type="button" data-question="Čo robiť pri strate občianskeho preukazu?">🪪 Strata dokladu</button><button type="button" data-question="Ako si vytvoriť finančnú rezervu?">💶 Finančná rezerva</button></div><p class="note">Asistent pracuje s vybranými témami portálu. Nie je pripojený na všetky aktuálne úradné registre.</p></section>
<section class="panel ai-box" aria-label="Konverzácia s AI asistentom">
<div id="ai-conversation" class="ai-conversation" aria-live="polite"><div class="ai-message ai-bot">Dobrý deň! S čím vám môžem pomôcť? Napríklad s občianskym preukazom, hypotékou alebo prepisom auta.</div></div>
<form id="ai-form"><label for="ai-question">Vaša otázka</label><p class="note" id="ai-context-note">Každú otázku posudzujem samostatne. Pri nadväzujúcej otázke uveďte aj tému; predchádzajúca konverzácia sa do API neposiela.</p><div class="ai-input"><textarea id="ai-question" maxlength="600" rows="2" required aria-describedby="ai-context-note" placeholder="Napríklad: Čo robiť, keď stratím občiansky preukaz?"></textarea><button id="ai-submit" type="submit">Odoslať</button></div><label class="ai-local-choice" for="ai-local-only"><input id="ai-local-only" type="checkbox" checked /> Vyhľadávať iba v návodoch portálu (predvolené; otázka sa neodošle službe AI)</label><p class="note">Nepíšte rodné čísla, adresy, zdravotné ani iné citlivé údaje. Pri vypnutom lokálnom režime sa otázka odosiela do API asistenta; pri zapnutom sa spracuje iba v tomto prehliadači. <a href="/ochrana-sukromia/">Ochrana súkromia</a>.</p></form>
</section>
<p class="note">AI môže robiť chyby. Vždy si overte aktuálne postupy v odkazovaných oficiálnych zdrojoch. Táto verzia neuchováva históriu konverzácie na portáli.</p>
</main>
<script>
import catalog from '../data/search.json';
import {trustedOfficialUrl} from '../lib/official-sources.mjs';
const searchInput=document.querySelector<HTMLInputElement>('#knowledge-query');
const searchResults=document.querySelector<HTMLElement>('#knowledge-results');
const norm=(x:string)=>x.toLocaleLowerCase('sk-SK').normalize('NFD').replace(/[\u0300-\u036f]/g,'');
const ignored=new Set(['ako','kde','kedy','co','som','bol','mam','chcem','potrebujem','prosim','robit','postupovat','postup','moja','moje','moj','ked','pri','pre','som','mozete','mam','sa','ci','tie','toto','aky','aka','ake','vybavit','vybavim','treba','ziskat','ziskam','najdem','najst','zistit','zistim','mozem','musim','urobit','spravit']);
const shortTerms=new Set(['ev','ek']);
const tokens=(s:string)=>norm(s).split(/\s+/).flatMap(part=>part.split(/[^a-z0-9]+/)).filter(t=>(t.length>=3||shortTerms.has(t))&&!ignored.has(t)).slice(0,14);
const isInternal=(url:unknown):url is string => typeof url==='string'&&/^\/(?!\/)[a-zA-Z0-9/_#?=&.%-]*$/.test(url)&&!/%(?:2f|5c|00|0d|0a)/i.test(url)&&!url.includes('..')&&!url.includes('\\');
const knownSourceUrls=new Set(catalog.filter(x=>isInternal(x.url)).map(x=>x.url));
const library=catalog.filter(x=>isInternal(x.url)).map(x=>({
  x,title:norm(x.title),keywords:norm(x.keywords??''),description:norm(x.description??''),category:norm(x.category??'')
}));
// Conservative inflection matching: exact words outrank shared stems.
const endings=['ami','ach','och','eho','emu','ova','ove','ovy','om','ou','ov','mi','ia','ie','iu','ej','am','im','a','e','i','y','u','o'];
function relatedWord(a:string,b:string){
  if(a.length<5||b.length<5)return false;
  const stems=(word:string)=>[word,...endings.filter(end=>word.endsWith(end)&&word.length-end.length>=4).map(end=>word.slice(0,-end.length))];
  const left=stems(a),right=stems(b);
  return left.some(stem=>right.includes(stem)) || (Math.min(a.length,b.length)>=5&&Math.abs(a.length-b.length)<=4&&(a.startsWith(b)||b.startsWith(a)));
}
function findLocal(question:string,max=6,eligible=library){
  const terms=[...new Set(tokens(question))];if(!terms.length)return [];
  const ranked=eligible.map(item=>{
    let score=0,matched=0;
    for(const t of terms){
      const matches=(text:string)=>text.split(/[^a-z0-9]+/).reduce((best,word)=>Math.max(best,word===t?2:relatedWord(word,t)?1:0),0);
      const hitsTitle=matches(item.title),hitsKeywords=matches(item.keywords),hitsDescription=matches(item.description),hitsCategory=matches(item.category);
      if(hitsTitle||hitsKeywords||hitsDescription||hitsCategory)matched++;
      score+=hitsTitle*7+hitsKeywords*4+hitsDescription*2+hitsCategory;
    }
    if(question.trim().length>=3&&item.title.includes(norm(question.trim())))score+=16;
    return {x:item.x,score,matched};
  });
  // Long, multi-topic questions rarely match 40% of their terms in one guide.
  // Prefer high-coverage matches, but do not hide useful partial sources when none qualify.
  const strictMinimum=Math.max(1,Math.ceil(terms.length*.4));
  const strict=ranked.filter(item=>item.matched>=strictMinimum && (terms.length===1||item.matched>=2));
  const minimum=strict.length?strictMinimum:2;
  return (strict.length?strict:ranked.filter(item=>item.matched>=minimum))
    .sort((a,b)=>b.score-a.score||b.matched-a.matched||a.x.title.localeCompare(b.x.title,'sk'))
    .slice(0,max).map(item=>item.x);
}
function renderLocalLinks(parent:HTMLElement,question:string,label='Súvisiace návody a nástroje:', showEmpty=false){
  const linked = new Set(Array.from(parent.querySelectorAll('a'), anchor => anchor.href));
  const hits = findLocal(question).filter(item => {
    const href = new URL(item.url, location.origin).href;
    if (linked.has(href)) return false;
    linked.add(href);
    return true;
  });
  if(!hits.length){if(showEmpty){const p=document.createElement('p');p.textContent='V databáze portálu som nenašiel dostatočne súvisiace stránky. Skúste kratšiu otázku alebo fulltext.';parent.append(p);}return;}
  const block=document.createElement('div');block.className='ai-sources';
  const heading=document.createElement('strong');heading.textContent=label;block.append(heading);
  for(const item of hits){const a=document.createElement('a');a.href=item.url;a.textContent=item.title+' — '+item.category+' →';block.append(a);}
  parent.append(block);
}
const categoryFilter=document.querySelector<HTMLSelectElement>('#knowledge-category');
const kindFilter=document.querySelector<HTMLSelectElement>('#knowledge-kind');
const searchSummary=document.querySelector<HTMLElement>('#knowledge-summary');
for(const category of [...new Set(library.map(item=>item.x.category))].filter(Boolean).sort((a,b)=>a.localeCompare(b,'sk'))){
  const option=document.createElement('option');option.value=category;option.textContent=category;categoryFilter?.append(option);
}
function kindOf(url:string){
  if(/^\/(navody|sprievodca)\//.test(url))return 'guide';
  if(url.startsWith('/kalkulacky/')||/^\/financie\/#(hypoteka|rozpocet)/.test(url))return 'calculator';
  return 'other';
}
function updateKnowledgeResults(){
  if(!searchResults)return;
  searchResults.replaceChildren();
  const q=searchInput?.value.trim()??'';
  if(q.length<3&&!shortTerms.has(norm(q))){if(searchSummary)searchSummary.textContent='Napíšte aspoň tri znaky alebo skratku EV či EK. Filtre nemenia ani neodosielajú otázku asistentovi.';return;}
  // Filter the complete ranked list before limiting the visible results.
  const eligible=library.filter(({x:item})=>(!categoryFilter?.value||item.category===categoryFilter.value)&&(!kindFilter?.value||kindOf(item.url)===kindFilter.value));
  const hits=findLocal(q,eligible.length,eligible);
  if(searchSummary)searchSummary.textContent=hits.length?'Nájdených stránok: '+hits.length+'. Zobrazených: '+Math.min(hits.length,8)+'. Ide o tematické výsledky katalógu, nie potvrdenie odpovede.':'Pre zvolené filtre sa nenašli výsledky. Zmeňte filter alebo skúste kratší výraz.';
  for(const item of hits.slice(0,8)){
    const a=document.createElement('a');a.href=item.url;
    const name=document.createElement('strong');name.textContent=item.title;
    const desc=document.createElement('span');desc.textContent=' — '+item.category+': '+item.description;
    a.append(name,desc);searchResults.append(a);
  }
}
searchInput?.addEventListener('input',updateKnowledgeResults);
categoryFilter?.addEventListener('change',updateKnowledgeResults);
kindFilter?.addEventListener('change',updateKnowledgeResults);
const goal = document.querySelector<HTMLSelectElement>('#ai-goal')!;
const pathLinks = document.querySelector<HTMLOListElement>('#ai-path-links')!;
const status = document.querySelector<HTMLElement>('#ai-path-status')!;
const resetPath = document.querySelector<HTMLButtonElement>('#ai-path-reset')!;
const paths: Record<string, [string, string][]> = {
  home: [
    ["Prejdite si postup kúpy bytu","/sprievodca/kupa-bytu/"],
    ["Stanovte si vlastný rozpočet","/moje-centrum/#rozpocet"],
    ["Porovnajte hypotéky","/financie/porovnanie-hypotek/"],
    ["Spočítajte celkové náklady na bývanie","/kalkulacky/naklady-na-byvanie/"],
    ["Skontrolujte kroky pred kúpou nehnuteľnosti","/kupa-nehnutelnosti/"],
  ],
  car: [
    ["Prejdite si postup kúpy auta","/sprievodca/nove-auto/"],
    ["Porovnajte náklady vozidiel","/auto/porovnanie-nakladov/"],
    ["Pripravte si podklady na prepis auta","/navody/prepis-auta/"],
  ],
  documents: [
    ["Prejdite si postup pri strate dokladu","/sprievodca/strata-obcianskeho/"],
    ["Prejdite kontrolný zoznam pri strate dokladov","/strata-dokladov/"],
    ["Zapíšte si vlastný termín","/kalendar/"],
  ],
  business: [
    ["Prejdite si sprievodcu založením živnosti","/sprievodca/zivnost/"],
    ["Otvorte kontrolný zoznam k založeniu živnosti","/zalozenie-zivnosti/"],
    ["Overte údaje firmy podľa IČO","/data/firmy/"],
  ],
  budget: [
    ["Spočítajte rozpočet domácnosti","/financie/prehlad/"],
    ["Prepočítajte náklady na bývanie","/kalkulacky/naklady-na-byvanie/"],
    ["Uložte si finančné nástroje do svojho prehľadu","/moj-prehlad/"],
  ],
  vehicle: [
    ["Zaznamenajte výdavky na prevádzku auta","/auto/moje-auto/"],
    ["Porovnajte náklady vozidiel","/auto/porovnanie-nakladov/"],
    ["Zapíšte si vlastný termín údržby","/kalendar/"],
  ],
  services: [
    ["Porovnajte poplatky dvoch ponúk","/porovnavace/"],
    ["Prepočítajte dopad na rozpočet domácnosti","/financie/prehlad/"],
  ],
};
// Keep only the selected goal and completed public route IDs in this history entry.
const saved = history.state?.assistantPath;
const completed = new Map<string, Set<string>>();
for (const [key, steps] of Object.entries(paths)) {
  const savedRoutes = saved?.completed?.[key];
  completed.set(key, new Set(steps.map(([, url]) => url).filter(url => Array.isArray(savedRoutes) && savedRoutes.includes(url))));
}
if (saved && typeof saved.goal === 'string' && Object.hasOwn(paths, saved.goal)) goal.value = saved.goal;

function savePath() {
  const entries = Object.fromEntries([...completed].map(([key, urls]) => [key, [...urls]]));
  try {
    history.replaceState({ ...history.state, assistantPath: { goal: goal.value, completed: entries } }, '');
  } catch { /* The current page still retains the selection. */ }
}
function showPathProgress() {
  const steps = paths[goal.value] ?? [];
  const count = completed.get(goal.value)?.size ?? 0;
  status.textContent = steps.length ? 'Dokončené kroky: ' + count + ' z ' + steps.length + '.' : '';
  resetPath.hidden = count === 0;
}
function updateGoal() {
  pathLinks.replaceChildren();
  const checked = completed.get(goal.value);
  for (const [label, url] of paths[goal.value] ?? []) {
    const row = document.createElement('li');
    const link = document.createElement('a');
    link.href = url;
    link.textContent = label;
    const control = document.createElement('label');
    const box = document.createElement('input');
    box.type = 'checkbox';
    box.checked = checked?.has(url) ?? false;
    box.setAttribute('aria-label', 'Hotovo – ' + label);
    box.addEventListener('change', () => {
      if (box.checked) checked?.add(url); else checked?.delete(url);
      savePath();
      showPathProgress();
    });
    control.append(box, ' Hotovo');
    row.append(link, control);
    pathLinks.append(row);
  }
  showPathProgress();
}
goal.addEventListener('change', () => { updateGoal(); savePath(); });
resetPath.addEventListener('click', () => {
  completed.get(goal.value)?.clear();
  updateGoal();
  savePath();
  pathLinks.querySelector<HTMLInputElement>('input')?.focus();
});
window.addEventListener('pageshow', () => { updateGoal(); updateKnowledgeResults(); });
updateGoal(); updateKnowledgeResults();
const form=document.querySelector<HTMLFormElement>('#ai-form')!;
const field=document.querySelector<HTMLTextAreaElement>('#ai-question')!;
const button=document.querySelector<HTMLButtonElement>('#ai-submit')!;
const conversation=document.querySelector<HTMLElement>('#ai-conversation')!;
function bubble(message:string,role:'ai-user'|'ai-bot'){const div=document.createElement('div');div.className='ai-message '+role;div.textContent=message;conversation.append(div);return div;}
const quickButtons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-question]'));
let busy=false;
quickButtons.forEach(b=>b.addEventListener('click',()=>{if(busy)return;field.value=b.dataset.question||'';field.setCustomValidity('');field.focus();form.requestSubmit();}));
const localOnly=document.querySelector<HTMLInputElement>('#ai-local-only');
// Reset restored form state on navigation; online processing is an explicit choice.
if(localOnly)localOnly.checked=true;
window.addEventListener('pageshow',event=>{if(event.persisted&&localOnly)localOnly.checked=true;});
function addRefinement(response:HTMLElement,question:string){
  const topics=findLocal(question,3);
  if(!topics.length)return;
  const block=document.createElement('div');block.className='ai-refinement';
  const label=document.createElement('strong');label.textContent='Spresnite ďalšiu otázku podľa témy:';block.append(label);
  const hint=document.createElement('p');hint.className='note';hint.textContent='Výber iba pripraví otázku. Upravte ju a odošlite, keď budete pripravení.';block.append(hint);
  for(const topic of topics){
    const refine=document.createElement('button');refine.type='button';refine.textContent=topic.title;
    refine.addEventListener('click',()=>{
      if(busy)return;
      field.value='Téma: '+topic.title+'. Čo si potrebujem pripraviť a kde nájdem konkrétny postup?';
      field.setCustomValidity('');
      field.focus();
      field.scrollIntoView({block:'nearest',behavior:'smooth'});
    });
    block.append(refine);
  }
  response.append(block);
}

field.addEventListener('input',()=>field.setCustomValidity(''));
form.addEventListener('submit',async e=>{
  e.preventDefault();
  const question=field.value.trim();
  if(busy)return;
  if((question.length<3&&!(localOnly?.checked&&shortTerms.has(norm(question))))||question.length>600){field.setCustomValidity('Zadajte otázku s 3 až 600 znakmi; v lokálnom režime môžete použiť aj EV alebo EK.');field.reportValidity();return;}
  busy=true;
  button.disabled=true;field.disabled=true;
  quickButtons.forEach(b=>b.disabled=true);
  if(localOnly)localOnly.disabled=true;
  form.setAttribute('aria-busy','true');
  bubble(question,'ai-user');field.value='';
  const response=bubble('Hľadám vhodné zdroje…','ai-bot');
  try{
    if(localOnly?.checked){
      response.textContent='Toto je lokálne vyhľadávanie v obsahu portálu, nie AI odpoveď. Otázka nebola odoslaná na server. Vyberte si súvisiaci postup a overte aktuálne podmienky na oficiálnom zdroji.';
      renderLocalLinks(response,question,'Nájdené návody a nástroje:',true);
      return;
    }
    const controller=new AbortController();
    const timer=setTimeout(()=>controller.abort(),18000);
    let result:Response;
    let data:any;
    try{
      result=await fetch('/api/assistant',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({question}),signal:controller.signal});
      data=await result.json();
    }finally{clearTimeout(timer);}
    const answer=typeof data?.answer==='string'?data.answer.trim():'';
    const validSources=result.ok&&Array.isArray(data?.sources)?data.sources.filter((item:unknown):item is {url:string}=>typeof item==='object'&&item!==null&&isInternal((item as {url?:unknown}).url)&&knownSourceUrls.has((item as {url:string}).url)):[];
    const hasGrounding=validSources.length>0;
    const mode=data?.mode;
    const isGenerated=mode==='ai';
    const isGroundedMode=isGenerated||mode==='verified-guide'||mode==='guide-navigation';
    // Unknown modes and source-free responses must never display arbitrary API text.
    // The server's grounded mode is a no-answer signal, not an answer to display.
    const acceptedAnswer=result.ok&&Boolean(answer)&&isGroundedMode&&hasGrounding;
    response.textContent=!acceptedAnswer?'Asistent neposkytol overiteľnú odpoveď s dohľadateľným podkladom v katalógu portálu. Nižšie nájdete iba tematicky súvisiace stránky; ich obsah si overte v oficiálnych zdrojoch.':isGenerated?'Orientačná odpoveď AI (nie overený úradný postup):\n'+answer+'\n\nUvedené odkazy sú tematické podklady, nie potvrdenie každej vety odpovede.':answer;
    if(acceptedAnswer&&hasGrounding){
      const links=document.createElement('div');links.className='ai-sources';
      const label=document.createElement('strong');label.textContent='Odkazy uvedené v odpovedi:';links.append(label);
      let count=0;
      for(const item of validSources){
        const a=document.createElement('a');a.href=item.url;a.textContent=String(item.title||'Súvisiaci zdroj')+' ↗';
        links.append(a);count++;
      }
      if(count)response.append(links);
    }
    if(acceptedAnswer&&Array.isArray(data.officialSources)){
      const official=document.createElement('div');official.className='ai-sources';
      const title=document.createElement('strong');title.textContent='Odkazy na oficiálne zdroje:';official.append(title);
      let count=0;
      for(const source of data.officialSources){
        const trustedUrl=trustedOfficialUrl(source?.url);if(!trustedUrl)continue;
        const a=document.createElement('a');a.href=trustedUrl;a.target='_blank';a.rel='noopener noreferrer';
        a.textContent=String(source.title||'Oficiálny portál')+' ↗';official.append(a);count++;
      }
      if(count)response.append(official);
    }
    renderLocalLinks(response,question,'Ďalšie relevantné stránky portálu:',!acceptedAnswer);
  }catch{
    response.textContent='Službu AI sa teraz nepodarilo načítať. Nižšie sú len výsledky vyhľadávania v obsahu portálu; nejde o generovanú odpoveď.';
    renderLocalLinks(response,question,'Dostupné návody a nástroje:',true);
  }finally{
    busy=false;
    button.disabled=false;field.disabled=false;
    quickButtons.forEach(b=>b.disabled=false);
    if(localOnly)localOnly.disabled=false;
    form.removeAttribute('aria-busy');
    addRefinement(response,question);
    field.focus();
    response.scrollIntoView({block:'nearest',behavior:'smooth'});
  }
});
</script>
