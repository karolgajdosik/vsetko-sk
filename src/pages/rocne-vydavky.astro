---
import Base from '../layouts/Base.astro';
---
<Base title="Ročné a nepravidelné výdavky" description="Pripravte si rezervu na poistky, servis a ďalšie nepravidelné platby. Výpočet a údaje zostávajú vo vašom prehliadači.">
<main id="obsah" class="wrap main annual">
<nav aria-label="Navigácia"><a href="/moj-prehlad/">Môj prehľad</a> / Ročné výdavky</nav>
<h1>Ročné a nepravidelné výdavky</h1><p class="intro">Koľko odkladať na najbližšiu poistku, servis alebo školské výdavky? Každú platbu zadajte samostatne s jej konkrétnym termínom.</p>
<p class="note">Údaje sa ukladajú iba v tomto prehliadači. Výdavky sa automaticky neopakujú a nič sa nepripočítava do vášho rozpočtu. Existujúce platby nezadávajte dvakrát.</p>
<p id="annual-status" role="status" aria-live="polite"></p>
<section class="panel"><h2>Nový výdavok alebo úprava</h2>
<form id="annual-form"><input id="annual-id" type="hidden" />
<div class="grid"><label for="annual-title">Názov platby<input id="annual-title" maxlength="100" required /></label><label for="annual-amount">Celková suma (€)<input id="annual-amount" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" required /></label><label for="annual-date">Termín platby<input id="annual-date" type="date" min="1900-01-01" max="9999-12-31" required /></label><label for="annual-saved">Už odložené peniaze (€)<input id="annual-saved" type="number" min="0" max="10000000" step="0.01" value="0" inputmode="decimal" required /></label></div>
<div class="actions"><button type="submit">Uložiť výdavok</button><button id="annual-cancel" type="button">Zrušiť úpravu</button></div></form>
</section>
<section class="panel"><h2>Plán odkladania</h2><label for="annual-asof">Dátum výpočtu<input id="annual-asof" type="date" min="1900-01-01" max="9999-12-31" required /></label>
<p>Pre každú platbu: zostáva = celková suma − už odložené peniaze. Počet období = počet dní do termínu / 30, zaokrúhlený nahor. Odkladanie za každé 30-dňové obdobie = zostáva / počet období, zaokrúhlené nahor na cent. Ide o orientačný plán; skontrolujte dostupnosť peňazí pred termínom.</p>
<p>Platby splatné dnes alebo v minulosti majú celú nezabezpečenú sumu v položke „Potrebné ihneď“. Ak už boli zaplatené, odstráňte ich alebo nastavte odloženú sumu na celú platbu.</p>
<p id="annual-summary" role="status"></p><ul id="annual-list"></ul>
<p>Ročný súčet zahŕňa presne raz všetky zadané platby s termínom v roku dátumu výpočtu, aj už minulých. Nie je to ďalšia suma na pripočítanie k plánovanému odkladaniu. Celkové odkladanie zahŕňa všetky budúce zadané platby, aj v nasledujúcich rokoch.</p>
</section>
<section class="panel"><h2>Prijať plán ako úlohu</h2><p>Do osobného centra pridáme jednu úlohu s aktuálnou sumou odkladania. Rozpočet sa nezmení. Ak už taká úloha existuje, nepridáme ju znova.</p><label class="consent"><input id="annual-consent" type="checkbox" /> Chcem pridať túto úlohu do svojho osobného centra.</label><button id="annual-task" type="button">Pridať úlohu</button><p><a href="/moje-centrum/#ulohy">Moje úlohy</a> · <a href="/financie/kontrola/">Kontrola financií</a> · <a href="/zaloha/">Šifrovaná záloha</a></p></section>
<noscript><p>Na výpočet a uloženie je potrebný JavaScript.</p></noscript></main></Base>
<script>
import {ANNUAL_EXPENSES_KEY,emptyAnnualExpenses,normalizeAnnualExpenses,annualExpensePlan,addAnnualReserveTask} from '../lib/annual-expenses.mjs';
const get=(id:string)=>document.getElementById('annual-'+id)!;const field=(id:string)=>get(id) as HTMLInputElement;const status=(s:string)=>get('status').textContent=s;const form=get('form') as HTMLFormElement;const euro=(n:number)=>new Intl.NumberFormat('sk-SK',{style:'currency',currency:'EUR'}).format(n);let state=emptyAnnualExpenses();let writable=true;let storageSnapshot:string|null=null;
const now=new Date();field('asof').value=String(now.getFullYear()).padStart(4,'0')+'-'+String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0');
try{const raw=localStorage.getItem(ANNUAL_EXPENSES_KEY);storageSnapshot=raw;if(raw!==null)state=normalizeAnnualExpenses(JSON.parse(raw));}catch{writable=false;status('Uložené údaje sa nedajú načítať. Pôvodné údaje neprepíšeme. Nové výpočty fungujú len do obnovenia stránky.');}
function save(){if(!writable){status('Zmena je iba dočasná. Pôvodné údaje neboli prepísané.');return;}try{if(localStorage.getItem(ANNUAL_EXPENSES_KEY)!==storageSnapshot){writable=false;status('Uložené výdavky sa medzitým zmenili v inej karte alebo pri obnove zálohy. Zmena je iba dočasná; nič sme neprepísali. Pred ďalšou úpravou obnovte stránku.');return;}const next=JSON.stringify(state);localStorage.setItem(ANNUAL_EXPENSES_KEY,next);storageSnapshot=next;status('Výdavky uložené v tomto prehliadači.');window.dispatchEvent(new CustomEvent('v24:complete',{detail:{tool:'annual'}}));}catch{writable=false;status('Ukladanie nie je dostupné. Zmena je iba dočasná.');}}
function clear(){form.reset();field('id').value='';field('title').focus();}
function render(){const list=get('list');list.replaceChildren();try{const p=annualExpensePlan(state,field('asof').value);get('summary').textContent='Odkladanie za 30 dní: '+euro(p.monthly)+'. Potrebné ihneď: '+euro(p.immediate)+'. Platby v roku '+p.year+': '+euro(p.yearTotal)+'.';for(const e of p.expenses){const li=document.createElement('li');const text=document.createElement('p');text.textContent=e.title+' · '+e.dueDate+' · celkom '+euro(e.amount)+' · už odložené '+euro(e.savedAmount)+' · '+(e.periods?euro(e.monthly)+' za 30 dní ('+e.periods+' období)':'potrebné ihneď '+euro(e.immediate));li.append(text);const edit=document.createElement('button');edit.type='button';edit.textContent='Upraviť '+e.title;edit.onclick=()=>{field('id').value=e.id;field('title').value=e.title;field('amount').value=String(e.amount);field('saved').value=String(e.savedAmount);field('date').value=e.dueDate;field('title').focus();};const del=document.createElement('button');del.type='button';del.textContent='Odstrániť '+e.title;del.onclick=()=>{if(!window.confirm('Odstrániť výdavok „'+e.title+'“?'))return;state={...state,expenses:state.expenses.filter(x=>x.id!==e.id)};save();if(field('id').value===e.id)clear();render();field('title').focus();};li.append(edit,del);list.append(li);}}catch(e){get('summary').textContent=(e as Error).message;}}
form.addEventListener('submit',event=>{event.preventDefault();try{const id=field('id').value||crypto.randomUUID();const item={id,title:field('title').value,amount:field('amount').valueAsNumber,savedAmount:field('saved').valueAsNumber,dueDate:field('date').value};state=normalizeAnnualExpenses({version:1,expenses:[...state.expenses.filter(x=>x.id!==id),item]});save();clear();render();}catch(e){status((e as Error).message);}});get('cancel').addEventListener('click',clear);field('asof').addEventListener('change',render);
get('task').addEventListener('click',()=>{if(!field('consent').checked){status('Najprv potvrďte pridanie úlohy.');return;}try{const p=annualExpensePlan(state,field('asof').value);if(!state.expenses.length)throw Error('Najprv pridajte aspoň jeden výdavok.');const key='v24-personal-center-v1';const raw=localStorage.getItem(key);const center=raw===null?{version:1,tasks:[],deadlines:[],budget:{}}:JSON.parse(raw);const r=addAnnualReserveTask(center,'Odkladať '+euro(p.monthly)+' za 30 dní; pripraviť ihneď '+euro(p.immediate));if(r.added)localStorage.setItem(key,JSON.stringify(r.center));field('consent').checked=false;status(r.added?'Úloha bola pridaná. Rozpočet sa nezmenil.':'Táto úloha už existuje; nič sme nezmenili.');}catch(e){status((e as Error).message||'Úlohu sa nepodarilo uložiť.');}});render();
</script>
<style>
.annual{max-width:1050px}.annual .panel{padding:1.3rem;margin:1.3rem 0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.annual label{display:block;font-weight:650;margin:.7rem 0}.annual input:not([type=checkbox]){box-sizing:border-box;display:block;width:100%;min-width:0;padding:.8rem;margin-top:.4rem;border:1px solid #8290a5;border-radius:8px;background:var(--surface);color:var(--ink);font:inherit}.annual button{font:inherit;min-height:44px;padding:.7rem 1rem;margin:.3rem .5rem .3rem 0;cursor:pointer;border:1px solid #8290a5;border-radius:8px;background:var(--surface);color:var(--ink);overflow-wrap:anywhere}.annual li{padding:.8rem 0;overflow-wrap:anywhere}.annual .consent{display:flex;gap:.7rem;align-items:flex-start}.annual .consent input{width:1.2rem;height:1.2rem;flex-shrink:0}.annual :is(input,button):focus-visible{outline:3px solid currentColor;outline-offset:3px}.annual ul{padding-left:1.2rem}@media(max-width:650px){.grid{grid-template-columns:1fr}.annual .panel{padding:1rem}}
</style>
