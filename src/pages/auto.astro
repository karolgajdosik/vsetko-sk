---
import Base from '../layouts/Base.astro';
const tasks=[
{title:'Kupujem ojazdené auto',category:'kupa',icon:'🚗',desc:'VIN, história, kontrola technického stavu, zmluva a bezpečné prevzatie.',href:'/navody/kontrola-vozidla-pred-kupou/',tag:'Pred kúpou'},
{title:'Prepisujem vozidlo',category:'evidencia',icon:'📝',desc:'Zmena držiteľa alebo vlastníka, doklady, poistenie a elektronické podanie.',href:'/navody/prepis-auta/',tag:'Úradné vybavenie'},
{title:'Predávam auto',category:'evidencia',icon:'🤝',desc:'Kúpna zmluva, odovzdávací protokol, splnomocnenie a evidencia.',href:'/navody/predaj-vozidla/',tag:'Úradné vybavenie'},
{title:'Potrebujem STK alebo EK',category:'prevadzka',icon:'🔧',desc:'Príprava na kontrolu, platnosť, doklady a kontrola poistenia.',href:'/navody/stk-priprava/',tag:'Prevádzka'},
{title:'Overujem PZP',category:'poistenie',icon:'🛡️',desc:'Čo kryje PZP, ako overiť platnosť a čo robiť pri kúpe auta.',href:'/navody/povinne-zmluvne-poistenie/',tag:'Poistenie'},
{title:'Riešim dopravnú nehodu',category:'poistenie',icon:'🚨',desc:'Bezpečnosť, privolanie pomoci, dokumentácia a poisťovňa.',href:'/navody/nehoda-na-ceste/',tag:'Poistenie'},
{title:'Kupujem diaľničnú známku',category:'prevadzka',icon:'🛣️',desc:'Oficiálny nákup, kontrola EČV a overenie platnosti.',href:'/navody/dialnicna-znamka-kupa/',tag:'Prevádzka'},
{title:'Plánujem nabíjanie EV',category:'elektro',icon:'⚡',desc:'AC/DC, Type 2 a CCS2, ceny, aplikácie a plánovanie zastávok.',href:'/navody/nabijanie-elektromobilu/',tag:'Elektromobilita'},
{title:'Nabíjam doma',category:'elektro',icon:'🏠',desc:'Wallbox, elektrická inštalácia, bezpečnosť a tarifa.',href:'/navody/domace-nabijanie/',tag:'Elektromobilita'},
{title:'Kupujem elektromobil',category:'elektro',icon:'🔋',desc:'Dojazd, batéria, nabíjací výkon a celkové náklady.',href:'/navody/kupa-elektromobilu/',tag:'Elektromobilita'}
