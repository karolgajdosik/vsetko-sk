{title:'Platnosť STK / EK',detail:'Overte údaje o technickej a emisnej kontrole a dostupné notifikácie.',url:'https://www.jiscd.sk/prevadzka-vozidla/preverenie-vozidiel-v-suvislosti-tk-ek-ko-a-mpz/',source:'JISCD'},
{title:'Platnosť PZP',detail:'Vyhľadanie poisťovateľa a overenie poistenia podľa EČV alebo VIN.',url:'https://www.skp.sk/vyhladat-poistovatela-vozidla-a-overit-platnost-pzp/',source:'SKP'},
{title:'Diaľničná známka',detail:'Overenie platnosti zakúpenej známky podľa údajov vozidla.',url:'https://eznamka.sk/selfcare/modification/select/select-vignettes/?operation=Check',source:'eZnamka'},
{title:'Elektronické služby evidencie',detail:'Zmena držby, splnomocnenie, rezervácia a informácie o vozidle.',url:'https://www.slovensko.sk/sk/zivotne-situacie/zivotna-situacia/_elektronicke-sluzby-evidencie',source:'Slovensko.sk'},
{title:'Oficiálny nákup známky',detail:'Pri nákupe použite priamo portál NDS, nie sprostredkovateľa.',url:'https://eznamka.sk/',source:'NDS'}
];
const calculators=[
{title:'Náklady na auto',desc:'Mesačné a ročné náklady na vlastníctvo.',url:'/kalkulacky/naklady-na-auto/'},
{title:'Cena jazdy autom',desc:'Výdavky na plánovanú trasu.',url:'/kalkulacky/cena-cesty/'},
{title:'EV verzus benzín',desc:'Porovnanie ročných nákladov na energiu.',url:'/kalkulacky/ev-vs-benzin/'},
{title:'Cena nabíjania',desc:'Koľko zaplatíte za nabité kWh.',url:'/kalkulacky/cena-nabijania/'},
{title:'Splátka leasingu',desc:'Orientačný model financovania.',url:'/kalkulacky/leasing/'},
{title:'Servisný rozpočet',desc:'Mesačná rezerva na údržbu.',url:'/kalkulacky/servisny-rozpocet/'}
];
