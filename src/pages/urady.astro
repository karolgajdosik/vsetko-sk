---
import Base from '../layouts/Base.astro';
import guides from '../data/guides.json';
const guideCategories={
'ako-vybavit-obciansky-preukaz':'doklady','strata-obcianskeho-preukazu':'doklady','vymena-cestovneho-pasu':'doklady','cestovny-pas-pre-dieta':'doklady','strata-cestovneho-pasu':'doklady','zmena-mena-a-priezviska':'matrika','rodny-list':'matrika','sobas-na-slovensku':'matrika','zmena-trvaleho-pobytu':'byvanie','kataster-vlastnictvo':'byvanie','zacatie-podnikania':'podnikanie','dedicske-konanie':'rodina','vybavenie-po-umrti':'rodina'
};
const groups=[{id:'vsetky',label:'Všetky'},{id:'doklady',label:'Doklady'},{id:'matrika',label:'Matrika a rodina'},{id:'byvanie',label:'Pobyt a nehnuteľnosti'},{id:'podnikanie',label:'Podnikanie'},{id:'rodina',label:'Dedičstvo a úmrtie'}];
const services=[
{title:'Elektronické služby štátu',desc:'Ústredný portál verejnej správy a katalóg elektronických služieb.',url:'https://www.slovensko.sk/',source:'Slovensko.sk'},
{title:'Rezervačný systém dokladov',desc:'Vyhľadanie a rezervácia termínu na pracovisku dokladov podľa dostupnosti.',url:'https://portal.minv.sk/',source:'Ministerstvo vnútra SR'},
{title:'Strata občianskeho preukazu',desc:'Elektronická služba na nahlásenie straty alebo odcudzenia občianskeho preukazu s čipom.',url:'https://www.slovensko.sk/sk/detail-sluzby?externalCode=sluzba_egov_1065',source:'Slovensko.sk'},
{title:'Kataster nehnuteľností',desc:'Prístup k informáciám o vlastníctve, ťarchách a katastrálnym službám.',url:'https://www.skgeodesy.sk/',source:'ÚGKK SR'},
{title:'Živnostenský register',desc:'Vyhľadávanie podnikateľov a informácií o živnostenskom oprávnení.',url:'https://www.zrsr.sk/',source:'Živnostenský register SR'},
{title:'Obchodný register',desc:'Vyhľadanie spoločností, štatutárov a zápisov.',url:'https://www.orsr.sk/',source:'Ministerstvo spravodlivosti SR'},
{title:'Centrálny register zmlúv',desc:'Zverejnené zmluvy povinných osôb.',url:'https://www.crz.gov.sk/',source:'Úrad vlády SR'},
{title:'Finančná správa',desc:'Daňové informácie, elektronická komunikácia a formuláre.',url:'https://www.financnasprava.sk/',source:'Finančná správa SR'},
{title:'Sociálna poisťovňa',desc:'Dôchodkové a nemocenské poistenie, dávky a elektronické služby.',url:'https://www.socpoist.sk/',source:'Sociálna poisťovňa'},
{title:'Ústredie práce',desc:'Evidencia uchádzačov, sociálne dávky, rodinné príspevky a služby.',url:'https://www.upsvr.gov.sk/',source:'ÚPSVaR'}
];
const situations=[
{title:'Stratil som doklady',desc:'Oznámenie straty, ochrana identity a vybavenie nového dokladu.',href:'/navody/strata-obcianskeho-preukazu/',icon:'🪪'},
{title:'Potrebujem nový pas',desc:'Žiadosť, požadované doklady, podmienky a prevzatie.',href:'/navody/vymena-cestovneho-pasu/',icon:'🛂'},
{title:'Sťahujem sa',desc:'Ohlásenie trvalého pobytu a nadväzujúce povinnosti.',href:'/navody/zmena-trvaleho-pobytu/',icon:'🏠'},
{title:'Zakladám živnosť',desc:'Výber činnosti, ohlásenie a registrácie.',href:'/navody/zacatie-podnikania/',icon:'💼'},
{title:'Vybavujem úmrtie blízkeho',desc:'Matrika, pohreb, oznámenia inštitúciám a dedičské konanie.',href:'/navody/vybavenie-po-umrti/',icon:'🕊️'},
{title:'Overujem nehnuteľnosť',desc:'List vlastníctva, ťarchy, plomby a kataster.',href:'/navody/kataster-vlastnictvo/',icon:'🏘️'}
];
---
<Base title="Úrady a elektronické služby na Slovensku" description="Praktické návody na občiansky preukaz, pas, matriku, pobyt, živnosť, dedičstvo a kataster. Oficiálne služby a navigácia podľa životných situácií." updated="22. 10. 2026" sourceLinks={[{label:'Slovensko.sk',url:'https://www.slovensko.sk/'},{label:'Ministerstvo vnútra SR',url:'https://www.minv.sk/'},{label:'ÚGKK SR',url:'https://www.skgeodesy.sk/'}]}>
<main class="wrap main offices" id="obsah">
<header class="offices-hero"><p class="eyebrow">VŠETKO24.sk / Úrady</p><h1>Vybavte úrady bez zbytočného hľadania</h1><p class="intro">Občiansky preukaz, pas, trvalý pobyt, živnosť, kataster aj dedičstvo. Nájdite svoj postup, zistite čo si pripraviť a prejdite priamo na oficiálnu službu.</p><nav class="offices-nav" aria-label="Navigácia sekcie"><a class="primary" href="#situacie">Vybrať životnú situáciu ↓</a><a href="#navody">Všetky návody</a><a href="#sluzby">Oficiálne služby</a><a href="#elektronicky">Ako vybavovať online</a></nav></header>
<section class="offices-section" id="situacie"><p class="eyebrow">Najčastejšie úkony</p><h2>Čo potrebujete vybaviť?</h2><div class="offices-grid">{situations.map(s=><a class="office-card" href={s.href}><span class="office-emoji" aria-hidden="true">{s.icon}</span><h3>{s.title} →</h3><p>{s.desc}</p></a>)}</div></section>
<section class="offices-section" id="navody"><p class="eyebrow">Praktické návody</p><h2>Nájdite konkrétny postup</h2><p>Filtrovať môžete podľa oblasti alebo vyhľadať slovo, napríklad „pas“, „rodný list“ alebo „živnosť“.</p><div class="offices-filter"><label for="office-search">Hľadať návod</label><input type="search" id="office-search" placeholder="Čo potrebujete vybaviť?" autocomplete="off"/><div class="offices-pills" role="group" aria-label="Kategória návodov">{groups.map((g,i)=><button type="button" data-filter={g.id} aria-pressed={i===0?'true':'false'}>{g.label}</button>)}</div><p class="muted" id="office-count" aria-live="polite">Zobrazených {guides.filter(g=>g.category==='urady').length} návodov</p></div><div class="offices-grid">{guides.filter(g=>g.category==='urady').map(g=><a class="office-card office-guide" href={'/navody/'+g.slug+'/'} data-category={guideCategories[g.slug]??'vsetky'} data-search={(g.title+' '+g.description).toLocaleLowerCase('sk')}><span class="office-tag">{groups.find(c=>c.id===guideCategories[g.slug])?.label??'Úrady'}</span><h3>{g.title} →</h3><p>{g.description}</p></a>)}</div><p id="office-empty" hidden>Pre tento výber sme nenašli návod. Skúste iný výraz alebo všetky kategórie.</p><button type="button" id="office-reset" hidden>Vymazať filtre a zobraziť všetky témy</button></section>
<section class="offices-section" id="sluzby"><p class="eyebrow">Oficiálne odkazy</p><h2>Priamo na príslušný úrad alebo službu</h2><p>Odkazy vedú na oficiálne weby. Osobné údaje, rodné číslo ani čísla dokladov nevypĺňajte na VŠETKO24.sk.</p><div class="offices-grid">{services.map(s=><a class="office-card office-service" href={s.url} target="_blank" rel="noopener noreferrer"><span class="office-tag">{s.source}</span><h3>{s.title} ↗</h3><p>{s.desc}</p></a>)}</div></section>
<section class="offices-section" id="elektronicky"><p class="eyebrow">Elektronické vybavenie</p><h2>Čo potrebujete na online úradovanie</h2><div class="offices-steps"><article><span class="step-no">01</span><h3>Elektronický občiansky preukaz</h3><p>Na prihlásenie do mnohých služieb potrebujete občiansky preukaz s čipom (eID), čítačku alebo podporovaný spôsob prihlásenia a bezpečnostný osobný kód (BOK). Konkrétne požiadavky sa líšia podľa služby.</p></article><article><span class="step-no">02</span><h3>Elektronický podpis</h3><p>Niektoré podania vyžadujú kvalifikovaný elektronický podpis (KEP) a platné certifikáty. Prihlásenie eID samo osebe nenahrádza podpis podania.</p></article><article><span class="step-no">03</span><h3>Elektronická schránka</h3><p>Skontrolujte elektronickú schránku na slovensko.sk, jej aktiváciu na doručovanie a nové úradné správy. Právne účinky doručenia závisia od pravidiel príslušnej služby.</p></article><article><span class="step-no">04</span><h3>Potvrdenie a platba</h3><p>Po podaní uložte potvrdenie, skontrolujte stav podania a prípadné výzvy na doplnenie. Poplatky a lehoty overujte pri konkrétnej službe.</p></article></div><a href="https://www.slovensko.sk/" target="_blank" rel="noopener noreferrer">Otvoriť portál Slovensko.sk ↗</a></section>
<section class="offices-section offices-note"><h2>Dôležité pred návštevou úradu</h2><ul><li><strong>Doklady:</strong> overte si originály, prílohy a prípadné splnomocnenie.</li><li><strong>Termín:</strong> pri pracoviskách s rezervačným systémom skontrolujte voľné termíny.</li><li><strong>Poplatky:</strong> môžu sa líšiť podľa úkonu, veku žiadateľa a spôsobu vybavenia.</li><li><strong>Lehoty:</strong> závisia od typu podania a aktuálnych pravidiel; nepredpokladajte rovnakú lehotu pre všetky úrady.</li><li><strong>Bezpečnosť:</strong> prihlasujte sa iba na oficiálnych doménach štátu a neposielajte prístupové údaje cez formuláre tretích strán.</li></ul><p class="muted">Tento portál poskytuje orientačné návody. Rozhodujúce sú aktuálne pokyny a právne predpisy príslušného úradu.</p></section>
</main>
<style>
.offices{--accent:#0f766e}.offices-hero{padding:2rem 0 1rem}.offices-hero h1{max-width:19ch;line-height:1.12}.offices-hero .intro{max-width:55rem}.offices-nav{display:flex;gap:.7rem;flex-wrap:wrap;margin:1.5rem 0}.offices-nav a{display:inline-flex;border:1px solid #cbd5e1;border-radius:.7rem;padding:.75rem 1rem;text-decoration:none}.offices-nav a.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.offices-section{margin:2.5rem 0 3.5rem;scroll-margin-top:2rem}.offices-section h2{margin:.3rem 0 1rem}.offices-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:1rem}.office-card{display:block;border:1px solid #cbd5e1;border-radius:1rem;padding:1.25rem;text-decoration:none;color:inherit;transition:border-color .2s,transform .2s}.office-card:hover,.office-card:focus-visible{border-color:var(--accent);transform:translateY(-2px)}.office-card h3{font-size:1.1rem;margin:.6rem 0}.office-card p{line-height:1.55;opacity:.85;margin:.4rem 0}.office-emoji{font-size:1.6rem}.office-tag{font-size:.78rem;font-weight:700;color:var(--accent)}.offices-filter{border:1px solid #cbd5e1;border-radius:1rem;padding:1.2rem;margin:1.2rem 0}.offices-filter label{display:block;font-weight:700;margin-bottom:.4rem}.offices-filter input{width:100%;max-width:42rem;padding:.85rem 1rem;border:1px solid #94a3b8;border-radius:.65rem;background:transparent;color:inherit}.offices-pills{display:flex;gap:.5rem;flex-wrap:wrap;margin:1rem 0}.offices-pills button{border:1px solid #94a3b8;background:transparent;color:inherit;border-radius:999px;padding:.6rem .9rem;cursor:pointer;font:inherit}.offices-pills button[aria-pressed=true]{background:var(--accent);color:white;border-color:var(--accent)}.office-guide[hidden],#office-empty[hidden]{display:none}.offices-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:1rem;margin:1.2rem 0}.offices-steps article{border:1px solid #cbd5e1;border-radius:1rem;padding:1.4rem}.offices-steps h3{margin:.5rem 0}.offices-steps p{line-height:1.6}.step-no{color:var(--accent);font-weight:800}.offices-note{border-top:1px solid #cbd5e1;padding-top:2rem}.offices-note li{margin:.6rem 0;line-height:1.6}@media(max-width:640px){.offices-hero{padding-top:1rem}.offices-nav a{width:100%;justify-content:center}.offices-section{margin:2rem 0}}
</style>
<script>
const input=document.querySelector<HTMLInputElement>('#office-search');
const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
const cards=[...document.querySelectorAll<HTMLElement>('.office-guide')];
const count=document.querySelector<HTMLElement>('#office-count');
const empty=document.querySelector<HTMLElement>('#office-empty');
const normalize=(s:string)=>s.toLocaleLowerCase('sk').normalize('NFD').replace(/[\u0300-\u036f]/g,'');
let selected='vsetky';
function filter(){const q=normalize(input?.value||'').trim();let shown=0;for(const card of cards){const match=(selected==='vsetky'||card.dataset.category===selected)&&(!q||normalize(card.dataset.search||'').includes(q));card.hidden=!match;if(match)shown++;}if(count)count.textContent='Zobrazených '+shown+' z '+cards.length+' návodov';if(empty)empty.hidden=shown!==0;if(reset)reset.hidden=shown!==0;}
buttons.forEach(b=>b.addEventListener('click',()=>{selected=b.dataset.filter||'vsetky';buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));filter();}));
input?.addEventListener('input',filter);
const reset=document.querySelector<HTMLButtonElement>('#office-reset');
reset?.addEventListener('click',()=>{selected='vsetky';if(input)input.value='';buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter==='vsetky')));filter();input?.focus();});

</script>
</Base>