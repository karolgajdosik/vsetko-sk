---
import Base from '../../layouts/Base.astro';
const tools=[
{slug:'porovnavac',title:'Porovnávač nákladov',desc:'Porovnajte dva modelové varianty na základe vlastných čísel. Nejde o živé ceny dodávateľov.'},
{slug:'slovensko',title:'Slovensko – porovnanie regiónov',desc:'Praktický rozcestník krajov s odkazmi na oficiálne zdroje. Údaje nie sú automaticky načítavané.'},
{slug:'financie-pro',title:'Finančný plánovač',desc:'Spočítajte čas potrebný na dosiahnutie cieľa a sledujte ho iba vo svojom prehliadači.'},
{slug:'auto-ev',title:'Servisný denník auta',desc:'Zaznamenávajte servisné úkony a výdavky bez registrácie.'},
{slug:'obcan',title:'Môj úradný postup',desc:'Vytvorte si vlastný zoznam krokov a sledujte ich splnenie.'},
{slug:'firmy',title:'Overenie firmy vo verejných registroch',desc:'Vyhľadajte subjekt cez odkazy na oficiálne registre. Výsledky registrov neukladáme.'},
{slug:'dnes',title:'Môj denný prehľad',desc:'Vlastná štartovacia stránka s termínmi a rýchlymi odkazmi.'}
];
export function getStaticPaths(){return tools.map(t=>({params:{slug:t.slug},props:{tool:t}}))}
const {tool}=Astro.props;
---
<Base title={tool.title} description={tool.desc}>
<main class="wrap main suite" id="obsah" data-suite={tool.slug}>
<p class="eyebrow"><a href="/sluzby/">Všetky služby</a> / Funkčný nástroj</p><h1>{tool.title}</h1><p class="intro">{tool.desc}</p>
{tool.slug==='porovnavac'&&<section class="panel"><h2>Porovnanie dvoch variantov</h2><p>Porovnajte napríklad dva paušály, energie alebo predplatné pri rovnakej jednotke spotreby.</p><div class="fields"><label>Variant A <input id="a-name" value="Variant A" maxlength="50"/></label><label>Variant B <input id="b-name" value="Variant B" maxlength="50"/></label><label>Mesačný paušál A (€) <input id="a-fixed" type="number" min="0" step="0.01" value="15"/></label><label>Mesačný paušál B (€) <input id="b-fixed" type="number" min="0" step="0.01" value="20"/></label><label>Cena za jednotku A (€) <input id="a-unit" type="number" min="0" step="0.001" value="0.2"/></label><label>Cena za jednotku B (€) <input id="b-unit" type="number" min="0" step="0.001" value="0.15"/></label><label>Mesačná spotreba (jednotiek) <input id="usage" type="number" min="0" step="1" value="100"/></label></div><button id="compare">Vypočítať</button><p id="result" class="output" role="status"></p><p class="note">Bez daní a jednorazových poplatkov, pokiaľ ich nezahrniete do vstupov.</p></section>}
{tool.slug==='slovensko'&&<section class="panel"><h2>Vyberte kraj</h2><label for="region">Kraj Slovenska</label><select id="region"><option value="">Vyberte kraj</option>{['Bratislavský','Trnavský','Trenčiansky','Nitriansky','Žilinský','Banskobystrický','Prešovský','Košický'].map(x=><option value={x}>{x}</option>)}</select><p id="region-result" role="status"></p><p>Údaje pre jednotlivé kraje overíte na <a href="https://slovak.statistics.sk/" target="_blank" rel="noopener noreferrer">Štatistickom úrade SR</a>, <a href="https://data.statistics.sk/" target="_blank" rel="noopener noreferrer">DATAcube</a> a <a href="https://www.slovensko.sk/" target="_blank" rel="noopener noreferrer">slovensko.sk</a>.</p><p class="note">Nesľubujeme porovnateľné čísla bez aktuálneho datasetu. Táto verzia poskytuje navigáciu na zdroje.</p></section>}
{tool.slug==='financie-pro'&&<section class="panel"><h2>Cieľ sporenia</h2><div class="fields"><label>Cieľ (€) <input id="target" type="number" min="1" value="10000"/></label><label>Už nasporené (€) <input id="saved" type="number" min="0" value="1500"/></label><label>Mesačný vklad (€) <input id="monthly" type="number" min="1" value="250"/></label></div><button id="finance-calc">Vypočítať a uložiť cieľ</button><p id="result" class="output" role="status"></p><p class="note">Bez úrokov, inflácie a poplatkov. Vstupy zostávajú v tomto prehliadači.</p></section>}
{tool.slug==='auto-ev'&&<section class="panel"><h2>Servisné záznamy</h2><form id="journal"><div class="fields"><label>Dátum <input id="service-date" type="date" required/></label><label>Úkon <input id="service-title" maxlength="100" required placeholder="Výmena pneumatík"/></label><label>Náklady (€) <input id="service-cost" type="number" min="0" step="0.01" required value="0"/></label><label>Stav tachometra (km) <input id="service-km" type="number" min="0" step="1" value="0"/></label></div><button>Pridať záznam</button></form><p id="total" class="output"></p><div id="records" aria-live="polite"></div><button type="button" id="export">Exportovať CSV</button><p class="note">Údaje sa ukladajú len lokálne; pri vymazaní dát prehliadača sa môžu stratiť.</p></section>}
{tool.slug==='obcan'&&<section class="panel"><h2>Vlastný kontrolný zoznam</h2><form id="steps-form"><label>Nový krok <input id="step" maxlength="150" required placeholder="Overiť potrebné dokumenty"/></label><button>Pridať krok</button></form><p id="progress" class="output" role="status"></p><div id="steps"></div><p class="note">Zoznam je váš vlastný plán, nie záväzný úradný postup. Overte si aktuálne požiadavky príslušného úradu.</p></section>}
{tool.slug==='firmy'&&<section class="panel"><h2>Vyhľadanie subjektu</h2><form id="company-form"><label>Názov firmy alebo IČO <input id="company" maxlength="100" required placeholder="Názov spoločnosti"/></label><button>Pripraviť vyhľadávanie</button></form><div id="company-results" aria-live="polite"></div><p class="note">Odkazy otvárajú vyhľadávanie v externých registroch; identitu a stav firmy overte priamo tam.</p></section>}
{tool.slug==='dnes'&&<section class="panel"><h2>Váš dnešný panel</h2><p id="today-date" class="output"></p><h3>Najbližšie termíny</h3><div id="deadlines"></div><h3>Rýchle odkazy</h3><div class="link-grid"><a href="/kalendar/">Kalendár →</a><a href="/data/kurzy/">Kurzy mien →</a><a href="/data/ukazovatele/">Ukazovatele →</a><a href="/ai/">VŠETKO AI →</a></div><p class="note">Termíny sa čítajú z lokálneho kalendára VŠETKO24. Bez upozornení na pozadí.</p></section>}
<p><a href={`/sluzby/${tool.slug}/`}>← Späť na prehľad služby</a></p>
</main>
<script>
const root=document.querySelector<HTMLElement>('[data-suite]');const page=root?.dataset.suite;const $=(id:string)=>document.getElementById(id);const num=(id:string)=>Number((($(id) as HTMLInputElement|null)?.value)||0);const val=(id:string)=>((($(id) as HTMLInputElement|null)?.value)||'').trim();const eur=(v:number)=>v.toLocaleString('sk-SK',{style:'currency',currency:'EUR'});const key='v24-suite-'+page+'-v1';const load=():any[]=>{try{const a=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(a)?a:[]}catch{return []}};const save=(a:any[])=>{try{localStorage.setItem(key,JSON.stringify(a))}catch{alert('Úložisko prehliadača nie je dostupné.')}};const make=(tag:string,text:string)=>{const e=document.createElement(tag);e.textContent=text;return e};const valid=(...values:number[])=>values.every(n=>Number.isFinite(n)&&n>=0);
$('compare')?.addEventListener('click',()=>{const a=num('a-fixed'),b=num('b-fixed'),u=num('a-unit'),v=num('b-unit'),q=num('usage');const out=$('result')!;if(!valid(a,b,u,v,q)){out.textContent='Zadajte platné nezáporné hodnoty.';return}const ca=12*(a+u*q),cb=12*(b+v*q);out.textContent=`${val('a-name')||'A'}: ${eur(ca)}/rok · ${val('b-name')||'B'}: ${eur(cb)}/rok. Rozdiel: ${eur(Math.abs(ca-cb))}/rok. Lacnejší variant: ${ca===cb?'rovnaké náklady':ca<cb?(val('a-name')||'A'):(val('b-name')||'B')}.`});
$('region')?.addEventListener('change',()=>{$('region-result')!.textContent=val('region')?`Vybraný kraj: ${val('region')}. Na portáloch ŠÚ SR vyberte príslušný kraj a rok pre porovnateľné údaje.`:''});
$('finance-calc')?.addEventListener('click',()=>{const t=num('target'),s=num('saved'),m=num('monthly'),out=$('result')!;if(!valid(t,s,m)||t<=0||m<=0){out.textContent='Cieľ a mesačný vklad musia byť väčšie ako nula.';return}const months=Math.ceil(Math.max(0,t-s)/m);out.textContent=`Na cieľ ${eur(t)} potrebujete ešte ${eur(Math.max(0,t-s))}. Pri ${eur(m)} mesačne ho dosiahnete približne za ${months} mesiacov.`;try{localStorage.setItem('v24-savings-goal-v1',JSON.stringify({target:t,saved:s,monthly:m}))}catch{}});
if(page==='financie-pro'){try{const x=JSON.parse(localStorage.getItem('v24-savings-goal-v1')||'null');if(x&&valid(x.target,x.saved,x.monthly)){for(const [id,v] of [['target',x.target],['saved',x.saved],['monthly',x.monthly]] as const)(($(id) as HTMLInputElement).value=String(v))}}catch{}}
function renderJournal(){const rows=load();const container=$('records');if(!container)return;container.replaceChildren();$('total')!.textContent=`Záznamov: ${rows.length} · Spolu: ${eur(rows.reduce((s,x)=>s+(Number(x.cost)||0),0))}`;for(const r of rows){const line=make('div',`${r.date} · ${r.title} · ${eur(r.cost)} · ${r.km} km `);line.className='entry';const del=make('button','Odstrániť');del.type='button';del.addEventListener('click',()=>{save(load().filter(x=>x.id!==r.id));renderJournal()});line.append(del);container.append(line)}}
$('journal')?.addEventListener('submit',e=>{e.preventDefault();const cost=num('service-cost'),km=num('service-km');if(!valid(cost,km)||!val('service-title')||!val('service-date'))return;const a=load();a.push({id:crypto.randomUUID(),date:val('service-date'),title:val('service-title'),cost,km});save(a);renderJournal();($('journal') as HTMLFormElement).reset()});
$('export')?.addEventListener('click',()=>{const esc=(x:any)=>'"'+String(x).replaceAll('"','""')+'"';const csv='Dátum;Úkon;Cena EUR;Km\r\n'+load().map(r=>[r.date,r.title,r.cost,r.km].map(esc).join(';')).join('\r\n');const blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='servisny-dennik.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)});
if(page==='auto-ev'){($('service-date') as HTMLInputElement).value=new Date().toLocaleDateString('en-CA');renderJournal()}
function renderSteps(){const a=load(),wrap=$('steps');if(!wrap)return;wrap.replaceChildren();$('progress')!.textContent=`Splnené: ${a.filter(x=>x.done).length} z ${a.length}`;for(const x of a){const row=make('div','');row.className='entry';const label=document.createElement('label');const check=document.createElement('input');check.type='checkbox';check.checked=!!x.done;check.addEventListener('change',()=>{x.done=check.checked;save(a);renderSteps()});label.append(check,document.createTextNode(' '+x.title));const del=make('button','Odstrániť');del.type='button';del.addEventListener('click',()=>{save(a.filter(y=>y.id!==x.id));renderSteps()});row.append(label,del);wrap.append(row)}}
$('steps-form')?.addEventListener('submit',e=>{e.preventDefault();if(!val('step'))return;const a=load();a.push({id:crypto.randomUUID(),title:val('step'),done:false});save(a);($('step') as HTMLInputElement).value='';renderSteps()});if(page==='obcan')renderSteps();
$('company-form')?.addEventListener('submit',e=>{e.preventDefault();const q=val('company');if(!q)return;const wrap=$('company-results')!;wrap.replaceChildren();for(const [label,url] of [['Obchodný register SR','https://www.orsr.sk/'],['Register účtovných závierok','https://www.registeruz.sk/'],['Živnostenský register','https://www.zrsr.sk/']]){const a=make('a',label+' ↗');a.setAttribute('href',url);a.setAttribute('target','_blank');a.setAttribute('rel','noopener noreferrer');wrap.append(a)}wrap.prepend(make('p',`Hľadaný subjekt: ${q}. Zadajte ho do vyhľadávania príslušného registra.`))});
if(page==='dnes'){const now=new Date();$('today-date')!.textContent=now.toLocaleDateString('sk-SK',{weekday:'long',year:'numeric',month:'long',day:'numeric'});const wrap=$('deadlines')!;try{const state=JSON.parse(localStorage.getItem('v24-personal-center-v1')||'null');const dates=Array.isArray(state?.deadlines)?state.deadlines:[];const items=dates.filter((x:any)=>typeof x.date==='string'&&x.date>=now.toLocaleDateString('en-CA')).sort((a:any,b:any)=>a.date.localeCompare(b.date)).slice(0,5);if(!items.length)wrap.append(make('p','Nemáte uložené žiadne budúce termíny.'));for(const x of items)wrap.append(make('p',`${x.date} · ${x.title||'Termín'}`))}catch{wrap.append(make('p','Termíny sa nepodarilo načítať.'))}}
</script>
<style>.suite{max-width:900px}.suite .panel{padding:1.5rem;margin:1.4rem 0}.suite .fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.suite label{display:block;margin:.5rem 0;font-weight:600}.suite input,.suite select{display:block;width:100%;padding:.7rem;margin:.4rem 0;border:1px solid #8290a5;border-radius:8px;background:var(--surface);color:var(--ink)}.suite button{padding:.65rem 1rem;border:1px solid #8290a5;border-radius:8px;cursor:pointer;margin:.5rem 0}.suite .output{font-weight:700;margin:1rem 0}.suite :global(.entry){display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid #8290a5;padding:.6rem 0}.suite :global(.entry input){display:inline;width:auto}.suite :global(#company-results a){display:block;margin:.6rem 0}.suite .link-grid{display:flex;flex-wrap:wrap;gap:1rem}@media(max-width:600px){.suite .fields{grid-template-columns:1fr}.suite :global(.entry){flex-wrap:wrap}}</style>
</Base>