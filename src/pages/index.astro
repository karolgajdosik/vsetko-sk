---
import Base from '../layouts/Base.astro';
import articles from '../data/search.json';
import scenarios from '../data/scenarios.json';
const categories=[{icon:'🗂️',name:'Moje centrum',slug:'moje-centrum',desc:'Úlohy, termíny a mesačný rozpočet bez registrácie'},{icon:'📊',name:'Dáta a API',slug:'data',desc:'Otvorené údaje a plánované živé integrácie'},{icon:'🧭',name:'Sprievodca',slug:'sprievodca',desc:'15 životných situácií krok za krokom'},{icon:'🧮',name:'Kalkulačky',slug:'kalkulacky',desc:'Praktické výpočty pre každý deň'},{icon:'💶',name:'Financie',slug:'financie',desc:'Hypotéky, úvery a rozpočet'},{icon:'🚗',name:'Auto',slug:'auto',desc:'Prepis, STK a elektromobilita'},{icon:'🏛️',name:'Úrady',slug:'urady',desc:'Doklady a životné situácie'}];
---
<Base updated="22. 10. 2026" title="Praktický sprievodca Slovenskom" description="VŠETKO.sk – vyhľadávanie životných situácií, praktické návody a bezplatné kalkulačky pre Slovensko."><section class="hero"><div class="wrap hero-layout"><div class="hero-content"><div class="eyebrow"><span class="live-dot"></span> Slovensko na jednom mieste</div><h1>Všetko, čo potrebuješ.<br/><span class="gradient-text">Na jednom mieste.</span></h1><p>Od hypotéky cez úrady až po elektromobilitu. Nájdi odpoveď, vypočítaj si možnosti a vybav každodenné veci jednoduchšie.</p><form id="search-form" class="searchbar" role="search" autocomplete="off"><input id="search" type="search" aria-controls="suggestions" aria-expanded="false" placeholder="Napr. prepis auta, hypotéka, pas…" aria-label="Hľadať na portáli" autocomplete="off"/><button type="submit">Hľadať →</button></form><div id="suggestions" class="suggestions hidden" role="listbox" aria-label="Návrhy vyhľadávania"></div><div class="search-info">Bez registrácie · Fulltext naprieč portálom · Praktické návody</div><div class="hero-chips"><a href="/kalkulacky/hypoteka/">Hypotéka <span>↗</span></a><a href="/data/nabijacky/">Nabíjacie stanice <span>↗</span></a><a href="/data/firmy/">Overiť firmu <span>↗</span></a></div></div><aside class="hero-feature" aria-label="Rýchly prístup k službám"><img class="hero-art" src="/illustrations/hero.svg" alt="Ilustrácia digitálneho centra s prehľadom služieb" width="640" height="440" fetchpriority="high"/><div class="feature-top"><span class="feature-indicator"></span> TVOJE DIGITÁLNE CENTRUM <span class="feature-dots">•••</span></div><div class="feature-heading">Čo vybavíme dnes?</div><a href="/sprievodca/" class="feature-link"><span class="feature-icon">✦</span><span><strong>Životné situácie</strong><small>Postup krok za krokom</small></span><span>↗</span></a><a href="/kalkulacky/" class="feature-link"><span class="feature-icon">⌗</span><span><strong>Inteligentné kalkulačky</strong><small>Rýchle a bezplatné výpočty</small></span><span>↗</span></a><a href="/data/" class="feature-link"><span class="feature-icon">◈</span><span><strong>Aktuálne dáta</strong><small>Oficiálne zdroje a API</small></span><span>↗</span></a><div class="feature-bottom"><span class="feature-indicator"></span> Všetko pod jednou strechou</div></aside></div></section><main class="wrap main" id="obsah"><section id="search-results" class="hidden" aria-live="polite"><h2>Výsledky vyhľadávania</h2><div id="results" class="list"></div><p id="no-results" class="panel hidden">Nenašli sme zodpovedajúcu tému. Skúste iné slová.</p></section><div class="home-highlights"><section class="panel" aria-label="Novinka Moje centrum"><img class="highlight-art" src="/illustrations/centrum.svg" alt="" loading="lazy" width="640" height="440"/><span class="section-kicker">NOVINKA · OSOBNÉ NÁSTROJE</span><h2>Váš plán, vaše termíny, váš rozpočet</h2><p>Vytvorte si úlohy, sledujte dôležité termíny a plánujte mesačné financie. Údaje zostanú iba vo vašom prehliadači.</p><a class="primary" href="/moje-centrum/">Otvoriť Moje centrum →</a></section><section class="panel" aria-label="Novinka porovnanie hypoték"><img class="highlight-art" src="/illustrations/hypoteka.svg" alt="" loading="lazy" width="640" height="440"/><span class="section-kicker">NOVINKA · FINANCIE</span><h2>Porovnajte tri hypotéky naraz</h2><p>Rozdiely v mesačných splátkach, úrokoch a celkových nákladoch na jednom mieste. Bez registrácie.</p><a class="primary" href="/financie/porovnanie-hypotek/">Spustiť porovnanie hypoték →</a></section><section class="panel" aria-label="Novinka porovnanie nákladov áut"><img class="highlight-art" src="/illustrations/auto.svg" alt="" loading="lazy" width="640" height="440"/><span class="section-kicker">NOVINKA · AUTO</span><h2>Koľko vás skutočne stojí auto?</h2><p>Porovnajte elektromobil, benzín a diesel vrátane poklesu hodnoty, energie, servisu a poistenia.</p><a class="primary" href="/auto/porovnanie-nakladov/">Porovnať náklady vozidiel →</a></section><section class="panel" aria-label="Nové nástroje VŠETKO24"><span class="section-kicker">NOVINKY · PRAKTICKÉ SLUŽBY</span><h2>Vybavte viac na jednom mieste</h2><p>Interaktívne kontrolné zoznamy, AI asistent, kalendár povinností, ekonomické údaje a dokumenty pripravené na PDF.</p><div class="hero-chips"><a href="/sprievodca/">✓ Životné situácie</a><a href="/ai/">✦ VŠETKO AI</a><a href="/kalendar/">📅 Kalendár</a><a href="/data/ukazovatele/">📊 Slovensko v číslach</a><a href="/dokumenty/">📄 Dokumenty a PDF</a></div></section></div><section class="smart-guide-section"><div class="section-heading"><div><span class="section-kicker">OSOBNÝ SPRIEVODCA</span><h2>Vyber si životnú situáciu</h2></div><a class="section-link" href="/sprievodca/">Všetky situácie ↗</a></div><div class="smart-guide-grid">{scenarios.slice(0,6).map(s=><a class="smart-guide-link" href={`/sprievodca/${s.slug}/`}><span class="tag">{s.category}</span><strong>{s.title} ↗</strong><small>{s.description}</small></a>)}</div></section><section class="live-data-section"><div class="section-heading"><div><span class="section-kicker">OFICIÁLNE DÁTA</span><h2>Slovensko v číslach</h2></div><a class="section-link" href="/data/">Všetky dáta ↗</a></div><div class="live-data-grid"><div class="live-data-card"><span class="tag">ECB · 1 EUR</span><strong id="live-czk">—</strong><span>CZK · česká koruna</span><small id="live-czk-date">Načítavam…</small></div><div class="live-data-card"><span class="tag">ECB · 1 EUR</span><strong id="live-usd">—</strong><span>USD · americký dolár</span><small id="live-usd-date">Načítavam…</small></div><div class="live-data-card"><span class="tag">World Bank</span><strong id="live-population">—</strong><span>Počet obyvateľov SR</span><small id="live-population-year">Načítavam…</small></div></div><p class="note" id="live-data-status" role="status" aria-live="polite">Údaje sa načítavajú.</p></section><section class="home-quick"><div class="section-heading"><div><span class="section-kicker">RÝCHLY ŠTART</span><h2>Čo potrebuješ vyriešiť?</h2></div><p>Vyber si oblasť alebo jednoducho začni vyhľadávať.</p></div><div class="grid">{categories.map(c=><a class="card" href={'/'+c.slug+'/'}><div class="emoji">{c.icon}</div><h3>{c.name} →</h3><div class="muted">{c.desc}</div></a>)}</div></section><section class="home-topics"><div class="section-heading"><div><span class="section-kicker">OBJAVUJ</span><h2>Praktické témy</h2></div><a class="section-link" href="/sprievodca/">Preskúmať sprievodcu ↗</a></div><div class="list">{articles.slice(0,12).map(a=><a class="article" href={a.url}><span class="tag">{a.category}</span><h3>{a.title} →</h3><p class="muted">{a.description}</p></a>)}</div></section><section class="data-preview"><div><span class="section-kicker">PREPOJENÉ S REÁLNYM SVETOM</span><h2>Údaje, ktoré majú zmysel.</h2><p>Kurzy mien, ekonomické ukazovatele, firmy a nabíjacie stanice. Z dôveryhodných zdrojov a bez zbytočného hľadania.</p><a class="primary" href="/data/">Preskúmať dáta a API ↗</a></div><div class="data-tiles"><a href="/data/kurzy/"><span>↗</span><strong>Kurzy ECB</strong><small>Referenčné výmenné kurzy</small></a><a href="/data/nabijacky/"><span>⚡</span><strong>Nabíjačky</strong><small>Mapa staníc na Slovensku</small></a><a href="/data/firmy/"><span>⌕</span><strong>Overenie IČO</strong><small>Oficiálny register firiem</small></a><a href="/data/ukazovatele/"><span>▥</span><strong>Slovensko v číslach</strong><small>Ekonomické ukazovatele</small></a></div></section><p class="more-link"><a class="primary" href="/kalkulacky/">Všetky kalkulačky →</a></p><section class="notice"><strong>Transparentne:</strong> Toto je pilotná verzia. Digitálny sprievodca je zatiaľ vyhľadávací systém, nie generatívna AI. Pri právnych a úradných postupoch overujte aktuálne podmienky v odkazovaných oficiálnych zdrojoch.</section></main><script>
import articles from '../data/search.json';
const norm=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
const synonyms:Record<string,string[]>={hypoteka:['uver','byvanie','byt'],auto:['vozidlo','automobil'],prepis:['prevod','zmena'],obciansky:['doklad','preukaz'],pas:['cestovny','doklad'],nabijacka:['elektromobil','ev','nabijanie'],firma:['ico','spolocnost','podnik'],kurz:['mena','euro','ecb'],plat:['mzda','prijem']};
const variants=(w:string)=>[w,...Object.entries(synonyms).flatMap(([k,v])=>k.startsWith(w)||v.some(x=>x.startsWith(w))?[k,...v]:[])];
const form=document.querySelector<HTMLFormElement>('#search-form')!;const input=document.querySelector<HTMLInputElement>('#search')!;const area=document.querySelector<HTMLElement>('#search-results')!;const results=document.querySelector<HTMLElement>('#results')!;const empty=document.querySelector<HTMLElement>('#no-results')!;
const suggestions=document.querySelector<HTMLElement>('#suggestions')!;
function rank(a:typeof articles[number],q:string){const title=norm(a.title),keys=norm(a.keywords),desc=norm(a.description),words=q.split(/\s+/).filter(Boolean);if(!words.every(w=>variants(w).some(v=>(title+' '+keys+' '+desc+' '+norm(a.category)).includes(v))))return -1;return words.reduce((n,w)=>n+(title===w?12:title.startsWith(w)?8:title.includes(w)?5:keys.includes(w)?3:1),0);}
function matches(q:string){return articles.map(a=>({a,score:rank(a,norm(q))})).filter(x=>x.score>=0).sort((x,y)=>y.score-x.score||x.a.title.localeCompare(y.a.title,'sk')).map(x=>x.a);}
function suggest(){const q=input.value.trim();suggestions.replaceChildren();if(q.length<2){suggestions.classList.add('hidden');input.setAttribute('aria-expanded','false');return;}for(const a of matches(q).slice(0,6)){const link=document.createElement('a');link.href=a.url;link.setAttribute('role','option');link.textContent=a.title+' · '+a.category;suggestions.append(link);}suggestions.classList.toggle('hidden',!suggestions.children.length);input.setAttribute('aria-expanded',String(!!suggestions.children.length));}
function search(query:string){const q=norm(query);suggestions.classList.add('hidden');input.setAttribute('aria-expanded','false');if(!q){area.classList.add('hidden');return;}const found=matches(q);area.classList.remove('hidden');results.replaceChildren();for(const a of found){const link=document.createElement('a');link.className='article';link.href=a.url;const tag=document.createElement('span');tag.className='tag';tag.textContent=a.category;const h=document.createElement('h3');h.textContent=a.title+' →';const p=document.createElement('p');p.className='muted';p.textContent=a.description;link.append(tag,h,p);results.append(link);}empty.classList.toggle('hidden',found.length>0);area.scrollIntoView({behavior:'smooth',block:'start'});}
input.addEventListener('input',suggest);
input.addEventListener('keydown',e=>{if(e.key==='Escape'){suggestions.classList.add('hidden');input.setAttribute('aria-expanded','false');}if(e.key==='ArrowDown'){const first=suggestions.querySelector<HTMLAnchorElement>('a');if(first){e.preventDefault();first.focus();}}});
suggestions.addEventListener('keydown',e=>{const links=Array.from(suggestions.querySelectorAll<HTMLAnchorElement>('a'));const at=links.indexOf(document.activeElement as HTMLAnchorElement);if(e.key==='ArrowDown'){e.preventDefault();links[(at+1)%links.length]?.focus();}if(e.key==='ArrowUp'){e.preventDefault();if(at<=0)input.focus();else links[at-1].focus();}if(e.key==='Escape'){suggestions.classList.add('hidden');input.focus();}});
document.addEventListener('click',e=>{if(!form.contains(e.target as Node)&&!suggestions.contains(e.target as Node)){suggestions.classList.add('hidden');input.setAttribute('aria-expanded','false');}});
form.addEventListener('submit',e=>{e.preventDefault();if(input.value.trim())window.location.href='/hladat/?q='+encodeURIComponent(input.value.trim());});
</script></Base>

<script>
const fmt=(n:number,d=2)=>new Intl.NumberFormat('sk-SK',{minimumFractionDigits:d,maximumFractionDigits:d}).format(n);
async function api(url:string){const r=await fetch(url);if(!r.ok)throw Error(String(r.status));return r.json();}
Promise.allSettled([api('/api/ecb-rates'),api('/api/ukazovatele')]).then(([a,b])=>{
let ok=0;
if(a.status==='fulfilled'&&Array.isArray(a.value.rates)){for(const code of ['CZK','USD']){const rate=a.value.rates.find((x:{currency:string})=>x.currency===code);if(rate&&Number.isFinite(rate.rate)){document.getElementById('live-'+code.toLowerCase())!.textContent=fmt(rate.rate,4);document.getElementById('live-'+code.toLowerCase()+'-date')!.textContent='Referenčný kurz '+rate.date;ok++;}}}
if(b.status==='fulfilled'&&Array.isArray(b.value.indicators)){const p=b.value.indicators.find((x:{code:string})=>x.code==='SP.POP.TOTL');if(p&&Number.isFinite(p.value)){document.getElementById('live-population')!.textContent=fmt(p.value,0);document.getElementById('live-population-year')!.textContent='Údaj za rok '+p.year;ok++;}}
document.getElementById('live-data-status')!.textContent=ok===3?'Kurzy ECB sú referenčné; počet obyvateľov je posledný dostupný ročný údaj.':ok?'Časť údajov momentálne nie je dostupná.':'Údaje sa momentálne nepodarilo načítať.';
});
</script>