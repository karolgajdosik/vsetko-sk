---
import Base from '../layouts/Base.astro';
import articles from '../data/search.json';
const categories=[{icon:'🧭',name:'Sprievodca',slug:'sprievodca',desc:'15 životných situácií krok za krokom'},{icon:'🧮',name:'Kalkulačky',slug:'kalkulacky',desc:'18 bezplatných výpočtových nástrojov'},{icon:'💶',name:'Financie',slug:'financie',desc:'Hypotéky, úvery a rozpočet'},{icon:'🚗',name:'Auto',slug:'auto',desc:'Prepis, STK a elektromobilita'},{icon:'🏛️',name:'Úrady',slug:'urady',desc:'Doklady a životné situácie'}];
---
<Base updated="22. 10. 2026" title="Praktický sprievodca Slovenskom" description="VŠETKO.sk – vyhľadávanie životných situácií, praktické návody a bezplatné kalkulačky pre Slovensko."><section class="hero"><div class="wrap"><div class="eyebrow">Váš praktický sprievodca Slovenskom</div><h1>Čo dnes potrebujete vyriešiť?</h1><p>Nepotrebujete vedieť, kde hľadať. Stačí vedieť, čo potrebujete.</p><form id="search-form" class="searchbar" role="search" autocomplete="off"><input id="search" type="search" aria-controls="suggestions" aria-expanded="false" placeholder="Napr. prepis auta, hypotéka, pas…" aria-label="Hľadať na portáli" autocomplete="off"/><button type="submit">Hľadať →</button></form><div id="suggestions" class="suggestions hidden" role="listbox" aria-label="Návrhy vyhľadávania"></div><div class="search-info">Praktické návody a sprievodca · Bez registrácie a bez plateného AI</div></div></section><main class="wrap main" id="obsah"><section id="search-results" class="hidden" aria-live="polite"><h2>Výsledky vyhľadávania</h2><div id="results" class="list"></div><p id="no-results" class="panel hidden">Nenašli sme zodpovedajúcu tému. Skúste iné slová.</p></section><section><h2>Preskúmajte oblasti</h2><div class="grid">{categories.map(c=><a class="card" href={'/'+c.slug+'/'}><div class="emoji">{c.icon}</div><h3>{c.name} →</h3><div class="muted">{c.desc}</div></a>)}</div></section><section><h2>Praktické témy</h2><div class="list">{articles.slice(0,12).map(a=><a class="article" href={a.url}><span class="tag">{a.category}</span><h3>{a.title} →</h3><p class="muted">{a.description}</p></a>)}</div></section><p><a class="primary" href="/kalkulacky/">Všetkých 18 kalkulačiek →</a></p><section class="notice"><strong>Transparentne:</strong> Toto je pilotná verzia. Vyhľadávanie nie je generatívna AI. Pri právnych a úradných postupoch overujte aktuálne podmienky v odkazovaných oficiálnych zdrojoch.</section></main><script>
import articles from '../data/search.json';
const norm=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
const form=document.querySelector<HTMLFormElement>('#search-form')!;const input=document.querySelector<HTMLInputElement>('#search')!;const area=document.querySelector<HTMLElement>('#search-results')!;const results=document.querySelector<HTMLElement>('#results')!;const empty=document.querySelector<HTMLElement>('#no-results')!;
const suggestions=document.querySelector<HTMLElement>('#suggestions')!;
function rank(a:typeof articles[number],q:string){const title=norm(a.title),keys=norm(a.keywords),desc=norm(a.description),words=q.split(/\s+/).filter(Boolean);if(!words.every(w=>(title+' '+keys+' '+desc+' '+norm(a.category)).includes(w)))return -1;return words.reduce((n,w)=>n+(title===w?12:title.startsWith(w)?8:title.includes(w)?5:keys.includes(w)?3:1),0);}
function matches(q:string){return articles.map(a=>({a,score:rank(a,norm(q))})).filter(x=>x.score>=0).sort((x,y)=>y.score-x.score||x.a.title.localeCompare(y.a.title,'sk')).map(x=>x.a);}
function suggest(){const q=input.value.trim();suggestions.replaceChildren();if(q.length<2){suggestions.classList.add('hidden');input.setAttribute('aria-expanded','false');return;}for(const a of matches(q).slice(0,6)){const link=document.createElement('a');link.href=a.url;link.setAttribute('role','option');link.textContent=a.title+' · '+a.category;suggestions.append(link);}suggestions.classList.toggle('hidden',!suggestions.children.length);input.setAttribute('aria-expanded',String(!!suggestions.children.length));}
function search(query:string){const q=norm(query);suggestions.classList.add('hidden');input.setAttribute('aria-expanded','false');if(!q){area.classList.add('hidden');return;}const found=matches(q);area.classList.remove('hidden');results.replaceChildren();for(const a of found){const link=document.createElement('a');link.className='article';link.href=a.url;const tag=document.createElement('span');tag.className='tag';tag.textContent=a.category;const h=document.createElement('h3');h.textContent=a.title+' →';const p=document.createElement('p');p.className='muted';p.textContent=a.description;link.append(tag,h,p);results.append(link);}empty.classList.toggle('hidden',found.length>0);area.scrollIntoView({behavior:'smooth',block:'start'});}
input.addEventListener('input',suggest);
input.addEventListener('keydown',e=>{if(e.key==='Escape'){suggestions.classList.add('hidden');input.setAttribute('aria-expanded','false');}if(e.key==='ArrowDown'){const first=suggestions.querySelector<HTMLAnchorElement>('a');if(first){e.preventDefault();first.focus();}}});
suggestions.addEventListener('keydown',e=>{const links=Array.from(suggestions.querySelectorAll<HTMLAnchorElement>('a'));const at=links.indexOf(document.activeElement as HTMLAnchorElement);if(e.key==='ArrowDown'){e.preventDefault();links[(at+1)%links.length]?.focus();}if(e.key==='ArrowUp'){e.preventDefault();if(at<=0)input.focus();else links[at-1].focus();}if(e.key==='Escape'){suggestions.classList.add('hidden');input.focus();}});
document.addEventListener('click',e=>{if(!form.contains(e.target as Node)&&!suggestions.contains(e.target as Node)){suggestions.classList.add('hidden');input.setAttribute('aria-expanded','false');}});
form.addEventListener('submit',e=>{e.preventDefault();search(input.value);});
</script></Base>
