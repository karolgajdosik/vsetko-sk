---
import Base from '../layouts/Base.astro';
import articles from '../data/search.json';
const categories=[{icon:'💶',name:'Financie',slug:'financie',desc:'Hypotéky, úvery a rozpočet'},{icon:'🚗',name:'Auto',slug:'auto',desc:'Prepis, STK a elektromobilita'},{icon:'🏛️',name:'Úrady',slug:'urady',desc:'Doklady a životné situácie'}];
---
<Base title="Praktický sprievodca Slovenskom" description="VŠETKO.sk – vyhľadávanie životných situácií, praktické návody a bezplatné kalkulačky pre Slovensko."><section class="hero"><div class="wrap"><div class="eyebrow">Váš praktický sprievodca Slovenskom</div><h1>Čo dnes potrebujete vyriešiť?</h1><p>Nepotrebujete vedieť, kde hľadať. Stačí vedieť, čo potrebujete.</p><form id="search-form" class="searchbar" role="search"><input id="search" type="search" placeholder="Napr. prepis auta, hypotéka, pas…" aria-label="Hľadať na portáli" autocomplete="off"/><button type="submit">Hľadať →</button></form><div class="search-info">Vyhľadávanie pripravených tém · Bez registrácie a bez plateného AI</div></div></section><main class="wrap main" id="obsah"><section id="search-results" class="hidden" aria-live="polite"><h2>Výsledky vyhľadávania</h2><div id="results" class="list"></div><p id="no-results" class="panel hidden">Nenašli sme zodpovedajúcu tému. Skúste iné slová.</p></section><section><h2>Preskúmajte oblasti</h2><div class="grid">{categories.map(c=><a class="card" href={'/'+c.slug+'/'}><div class="emoji">{c.icon}</div><h3>{c.name} →</h3><div class="muted">{c.desc}</div></a>)}</div></section><section><h2>Praktické témy</h2><div class="list">{articles.map(a=><a class="article" href={a.url}><span class="tag">{a.category}</span><h3>{a.title} →</h3><p class="muted">{a.description}</p></a>)}</div></section><section class="notice"><strong>Transparentne:</strong> Toto je pilotná verzia. Vyhľadávanie nie je generatívna AI. Pri právnych a úradných postupoch overujte aktuálne podmienky v odkazovaných oficiálnych zdrojoch.</section></main><script>
import articles from '../data/search.json';
const norm=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
const form=document.querySelector<HTMLFormElement>('#search-form')!;const input=document.querySelector<HTMLInputElement>('#search')!;const area=document.querySelector<HTMLElement>('#search-results')!;const results=document.querySelector<HTMLElement>('#results')!;const empty=document.querySelector<HTMLElement>('#no-results')!;
function search(query:string){const q=norm(query);if(!q){area.classList.add('hidden');return;}const tokens=q.split(/\s+/).filter(Boolean);const found=articles.filter(a=>tokens.every(t=>norm([a.title,a.category,a.description,a.keywords].join(' ')).includes(t)));area.classList.remove('hidden');results.replaceChildren();for(const a of found){const link=document.createElement('a');link.className='article';link.href=a.url;const tag=document.createElement('span');tag.className='tag';tag.textContent=a.category;const h=document.createElement('h3');h.textContent=a.title+' →';const p=document.createElement('p');p.className='muted';p.textContent=a.description;link.append(tag,h,p);results.append(link);}empty.classList.toggle('hidden',found.length>0);area.scrollIntoView({behavior:'smooth',block:'start'});}
form.addEventListener('submit',e=>{e.preventDefault();search(input.value);});
</script></Base>
