---
import Base from '../../layouts/Base.astro';
import {photoFor} from '../../lib/editorial-photos.mjs';
import guides from '../../data/guides.json';
import guideDetails from '../../data/guide-details.json';
export function getStaticPaths() {
 return guides.map(guide => ({params:{slug:guide.slug},props:{guide}}));
}
const {guide: sourceGuide}=Astro.props;
const supplement=guideDetails[sourceGuide.slug];
const guide={...sourceGuide,preparation:sourceGuide.preparation?.length ? sourceGuide.preparation : (supplement?.before ?? []),steps:sourceGuide.steps?.length ? sourceGuide.steps : (supplement?.detailed.map(step=>step.title) ?? []),updated:sourceGuide.updated,detail:sourceGuide.detail??(supplement?{...supplement,summary:sourceGuide.description,links:[sourceGuide.source]}:undefined)};
const labels={financie:'Financie',auto:'Auto',urady:'Úrady'};
const categoryLabel=labels[guide.category] ?? guide.category;
const categoryUrl = '/' + guide.category + '/';
const tokenize = (text) => (text ?? '').toLocaleLowerCase('sk').split(/[^0-9a-záäčďéíĺľňóôŕšťúýž]+/i).filter(token => token.length >= 4);
const currentTerms = new Set(tokenize(guide.title + ' ' + (guide.keywords ?? '')));
// Curated next steps for connected life events; fallback retains thematic discovery.
const curatedRelated = {
 'financna-rezerva':['kontrola-rodinnych-vydavkov','rodinny-financny-plan','bezpecne-sporenie'],
 'kontrola-rodinnych-vydavkov':['rodinny-financny-plan','financna-rezerva','bezpecne-sporenie'],
 'rodinny-financny-plan':['financna-rezerva','kontrola-rodinnych-vydavkov','bezpecne-sporenie'],
 'bezpecne-sporenie':['financna-rezerva','rodinny-financny-plan','urok-a-rpmn'],
 'spotrebny-uver':['urok-a-rpmn','refinancovanie-uveru','financna-rezerva'],
 'leasing-alebo-uver':['spotrebny-uver','urok-a-rpmn','kontrola-vozidla-pred-kupou'],
 'nehoda-na-ceste':['povinne-zmluvne-poistenie','pzp-pri-kupe-auta','prepis-auta'],
 'stk-priprava':['zimne-pneumatiky','kontrola-vozidla-pred-kupou','predaj-vozidla'],
 'zimne-pneumatiky':['stk-priprava','cesta-elektromobilom','kontrola-vozidla-pred-kupou'],
 'zmena-trvaleho-pobytu':['ako-vybavit-obciansky-preukaz','strata-obcianskeho-preukazu'],
 'rodny-list':['sobas-na-slovensku','cestovny-pas-pre-dieta','vybavenie-po-umrti'],
 'sobas-na-slovensku':['zmena-mena-a-priezviska','zmena-trvaleho-pobytu','rodny-list'],
 'zmena-mena-a-priezviska':['sobas-na-slovensku','ako-vybavit-obciansky-preukaz','vymena-cestovneho-pasu'],
 'vymena-cestovneho-pasu':['strata-cestovneho-pasu','cestovny-pas-pre-dieta'],
 'cestovny-pas-pre-dieta':['rodny-list','vymena-cestovneho-pasu','strata-cestovneho-pasu'],
 'zacatie-podnikania':['kontrola-rodinnych-vydavkov','financna-rezerva'],
 'porovnanie-hypotek':['hypoteka-prva-ziadost','urok-a-rpmn','fixacia-hypoteky','refinancovanie-uveru'],
 'hypoteka-prva-ziadost':['porovnanie-hypotek','kupa-bytu','urok-a-rpmn','financna-rezerva'],
 'fixacia-hypoteky':['refinancovanie-uveru','porovnanie-hypotek','urok-a-rpmn'],
 'refinancovanie-uveru':['fixacia-hypoteky','porovnanie-hypotek','urok-a-rpmn'],
 'kupa-bytu':['kataster-vlastnictvo','hypoteka-prva-ziadost','porovnanie-hypotek'],
 'predaj-bytu':['kataster-vlastnictvo','kupa-bytu'],
 'kataster-vlastnictvo':['kupa-bytu','predaj-bytu','dedicske-konanie'],
 'kontrola-vozidla-pred-kupou':['prepis-auta','pzp-pri-kupe-auta','predaj-vozidla'],
 'predaj-vozidla':['prepis-auta','povinne-zmluvne-poistenie','kontrola-vozidla-pred-kupou'],
 'prepis-auta':['pzp-pri-kupe-auta','predaj-vozidla','kontrola-vozidla-pred-kupou'],
 'pzp-pri-kupe-auta':['prepis-auta','povinne-zmluvne-poistenie','kontrola-vozidla-pred-kupou'],
 'kupa-elektromobilu':['domace-nabijanie','nabijanie-elektromobilu','cesta-elektromobilom'],
 'domace-nabijanie':['kupa-elektromobilu','nabijanie-elektromobilu','cesta-elektromobilom'],
 'cesta-elektromobilom':['nabijanie-elektromobilu','dialnicna-znamka','domace-nabijanie'],
 'dialnicna-znamka':['dialnicna-znamka-kupa','cesta-elektromobilom'],
 'dialnicna-znamka-kupa':['dialnicna-znamka','cesta-elektromobilom'],
 'vybavenie-po-umrti':['dedicske-konanie','rodny-list','kataster-vlastnictvo'],
 'dedicske-konanie':['vybavenie-po-umrti','kataster-vlastnictvo'],
 'strata-cestovneho-pasu':['vymena-cestovneho-pasu','cestovny-pas-pre-dieta'],
 'strata-obcianskeho-preukazu':['ako-vybavit-obciansky-preukaz','zmena-trvaleho-pobytu']
};
const curatedSlugs = curatedRelated[guide.slug] ?? [];
const curatedGuides = curatedSlugs
 .map(slug => guides.find(item => item.slug === slug))
 .filter((item): item is (typeof guides)[number] => Boolean(item) && item.slug !== guide.slug);
const relatedGuides = [
 ...curatedGuides,
 ...guides
  .filter(item => item.slug !== guide.slug && item.category === guide.category && !curatedSlugs.includes(item.slug))
  .map(item => ({
   guide:item,
   similarity:tokenize(item.title + ' ' + (item.keywords ?? '')).filter(token => currentTerms.has(token)).length
  }))
  .sort((a,b) => b.similarity-a.similarity || a.guide.title.localeCompare(b.guide.title,'sk'))
  .map(item => item.guide)
].slice(0,4);
const updatedMatch = /^(\d{1,2})\.\s*(\d{1,2})\.\s*(\d{4})$/.exec(guide.updated ?? '');
const updatedIso = updatedMatch ? [updatedMatch[3],updatedMatch[2].padStart(2,'0'),updatedMatch[1].padStart(2,'0')].join('-') : undefined;
const breadcrumbLd = {
 '@context':'https://schema.org',
 '@type':'BreadcrumbList',
 itemListElement:[
  {'@type':'ListItem',position:1,name:'Domov',item:'https://vsetko24.sk/'},
  {'@type':'ListItem',position:2,name:'Praktické návody',item:'https://vsetko24.sk/navody/'},
  {'@type':'ListItem',position:3,name:categoryLabel,item:new URL(categoryUrl,Astro.site ?? 'https://vsetko24.sk').href},
  {'@type':'ListItem',position:4,name:guide.title,item:new URL(Astro.url.pathname,Astro.site ?? 'https://vsetko24.sk').href}
 ]
};
const jsonLd={
 '@context':'https://schema.org',
 '@type':'Article',
 headline:guide.title,
 description:guide.description,
 inLanguage:'sk',
 dateModified:updatedIso,
 mainEntityOfPage:new URL(Astro.url.pathname,Astro.site ?? 'https://vsetko24.sk').href,
 publisher:{'@type':'Organization',name:'VŠETKO24.sk',url:'https://vsetko24.sk/'}
};
---
<Base title={guide.title} description={guide.description} updated={guide.updated} sourceLinks={[guide.source]}>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
<main class="wrap main" id="obsah">
<nav class="guide-breadcrumbs" aria-label="Drobečková navigácia"><a href="/">Domov</a> / <a href="/navody/">Návody</a> / <a href={categoryUrl}>{categoryLabel}</a> / <span aria-current="page">{guide.title}</span></nav>
<p class="eyebrow">Praktický návod · {categoryLabel}</p>
<h1>{guide.title}</h1><p class="intro">{guide.description}</p>
<p class="guide-update"><strong>Posledná evidovaná úprava obsahu:</strong> {guide.updated}. Aktuálne poplatky, lehoty a podmienky si skontrolujte na oficiálnom zdroji.</p>
<img class="detail-photo" src={photoFor(guide)} alt="" width="1400" height="420" loading="lazy" decoding="async" /><nav class="panel" aria-label="Obsah návodu"><strong>V tomto návode</strong><ol><li><a href="#priprava">Čo si pripraviť</a></li><li><a href="#postup">Postup krok za krokom</a></li>{guide.practical?.length > 0 && <li><a href="#prakticke-tipy">Praktické rady</a></li>}{guide.detail && <li><a href="#podrobne">Podrobný postup</a></li>}{guide.detail?.screenGuide && <li><a href="#online">Navigácia na oficiálnom portáli</a></li>}{guide.detail && <li><a href="#pozor">Na čo si dať pozor</a></li>}<li><a href="#overenie">Overenie a oficiálny zdroj</a></li></ol></nav>
<section class="panel" id="priprava"><h2>Pre koho je návod určený</h2><p>{guide.audience}</p><h2>Čo si pripraviť</h2><ul>{guide.preparation.map(item=><li>{item}</li>)}</ul></section>
<section class="panel" id="postup"><h2>Postup krok za krokom</h2><p>Jednotlivé kroky si môžete odškrtávať. Pred odoslaním žiadosti si vždy skontrolujte aktuálne podmienky na oficiálnom portáli.</p><ol class="guide-steps">{guide.steps.map((step,i)=><li><label class="guide-step"><input type="checkbox" aria-label={'Dokončený krok '+(i+1)} /><span><strong>Krok {i+1}</strong><span>{step}</span></span></label></li>)}</ol><p id="guide-progress" aria-live="polite"></p></section>
{guide.detail && <section class="panel" id="podrobne"><h2>Podrobný praktický postup</h2><p>{guide.detail.summary}</p><h3>Pred začiatkom</h3><ul>{guide.detail.before.map(x=><li>{x}</li>)}</ul><div class="guide-detail-steps">{guide.detail.detailed.map((item,i)=><article class="guide-detail-step"><span class="tag">Krok {i+1}</span><h3>{item.title}</h3><p>{item.body}</p><p class="muted"><strong>Kde:</strong> {item.where}</p>{item.tool && <p><a href={item.tool}>Otvoriť súvisiaci nástroj →</a></p>}</article>)}</div><h3>Čo má byť výsledkom</h3><p>{guide.detail.outcome}</p><h3>Oficiálne a súvisiace odkazy</h3><p>Ak sa externý formulár alebo register neotvorí, začnite na hlavnom informačnom zdroji: <a href={guide.source.url} target="_blank" rel="noopener noreferrer">{guide.source.label} ↗</a>. Informačná stránka nenahrádza samotné podanie alebo overenie v registri.</p><ul>{guide.detail.links.map(link=><li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a></li>)}</ul></section>}
{guide.detail?.screenGuide && <section class="panel" id="online"><h2>Navigácia na oficiálnom portáli</h2><p>Nasledujúce kroky sú textovou navigáciou k overeným stránkam. Rozloženie obrazoviek externého portálu sa môže meniť; aktuálny formulár si vždy pozrite na oficiálnej stránke.</p><ol class="guide-online">{guide.detail.screenGuide.map(item=><li><h3>{item.title}</h3><p>{item.instruction}</p><a href={item.url} target="_blank" rel="noopener noreferrer">Otvoriť príslušnú oficiálnu stránku ↗</a></li>)}</ol></section>}
{guide.detail && <section class="panel" id="pozor"><h2>Najčastejšie chyby a upozornenia</h2><ul>{guide.detail.pitfalls.map(x=><li>{x}</li>)}</ul><p class="muted">Obrazové návody doplníme až po overení aktuálnej podoby oficiálnych obrazoviek. Nezobrazujeme fiktívne screenshoty.</p></section>}
{guide.practical?.length > 0 && <section class="panel" id="prakticke-tipy"><h2>Praktické rady pred rozhodnutím</h2>{guide.practical.map(item=><article><h3>{item.title}</h3><p>{item.body}</p></article>)}</section>}
<section class="notice" id="overenie"><strong>Dôležité:</strong> {guide.verification} {guide.sourceNote}  Ide o orientačný kontrolný zoznam, nie o právne alebo finančné poradenstvo. Pred vybavovaním overte aktuálne požiadavky na oficiálnom zdroji: <a href={guide.source.url} target="_blank" rel="noopener noreferrer">{guide.source.label} ↗</a>.</section>
{relatedGuides.length > 0 && <section class="panel" id="suvisiace-navody" aria-labelledby="suvisiace-navody-heading">
  <h2 id="suvisiace-navody-heading">Súvisiace praktické návody</h2>
  <p>Odporúčané nadväzujúce postupy a ďalšie tematicky súvisiace návody.</p>
  <div class="grid guide-related-grid">{relatedGuides.map(item=>
    <a class="card" href={'/navody/' + item.slug + '/'}>
      <span class="tag">{labels[item.category] ?? item.category}</span>
      <h3>{item.title} →</h3><p>{item.description}</p>
    </a>
  )}</div>
</section>}
<p><a href="/navody/">← Všetky praktické návody</a> · <a href="/sprievodca/">Životné situácie</a> · <a href="/kalkulacky/">Kalkulačky</a></p>
</main>
<style>.guide-breadcrumbs{font-size:.9rem;margin-bottom:1rem;line-height:1.6;overflow-wrap:anywhere}.guide-update{font-size:.9rem;opacity:.85;margin-bottom:1rem}.guide-related-grid{grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}.guide-related-grid .card{padding:1rem}.guide-related-grid h3{margin:.5rem 0}.guide-online li{padding:1rem 0;border-bottom:1px solid #cbd5e1}.guide-detail-steps{display:grid;gap:1rem}.guide-detail-step{border:1px solid #cbd5e1;border-radius:.8rem;padding:1.25rem}.guide-detail-step h3{margin:.7rem 0}.guide-steps{padding-left:1.5rem}.guide-steps li{margin:0 0 .8rem}.guide-step{display:flex;align-items:flex-start;gap:.9rem;padding:1rem;border:1px solid #cbd5e1;border-radius:.75rem;cursor:pointer}.guide-step input{margin-top:.25rem;width:1.15rem;height:1.15rem;flex-shrink:0}.guide-step span span{display:block;margin-top:.35rem}.guide-step:has(input:checked){background:#f0fdf4}.guide-step:has(input:checked) span span{text-decoration:line-through;opacity:.7}</style>
<script>const checks=[...document.querySelectorAll<HTMLInputElement>('.guide-step input')];const progress=document.querySelector('#guide-progress');function refresh(){if(progress)progress.textContent='Hotové kroky: '+checks.filter(c=>c.checked).length+' z '+checks.length;}checks.forEach(c=>c.addEventListener('change',refresh));refresh();</script>
</Base>

