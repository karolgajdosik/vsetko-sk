---
import Base from '../layouts/Base.astro';
import entries from '../data/search.json';
import guides from '../data/guides.json';
import calculators from '../data/calculators.json';
const items=[...entries,...guides.map(g=>({title:g.title,category:'Návody',url:'/navody/'+g.slug+'/',description:g.description,keywords:g.keywords||''})),...calculators.map(c=>({title:c.title,category:'Kalkulačky',url:'/kalkulacky/'+c.slug+'/',description:c.description,keywords:c.title}))];
const unique=[...new Map(items.map(x=>[x.url,x])).values()];
---
<Base title="Fulltextové vyhľadávanie a digitálny sprievodca" description="Hľadajte v návodoch, kalkulačkách a témach VŠETKO24.sk. Bezplatný digitálny sprievodca vyberie relevantné zdroje.">
<main class="wrap main finder" id="obsah"><p class="eyebrow">Vyhľadávanie a sprievodca</p><h1>Nájdite odpoveď na jednom mieste</h1><p class="intro">Vyhľadávanie prehľadáva názvy, opisy a kľúčové slová našich návodov, kalkulačiek a tém. Sprievodca vám odporučí vhodné postupy podľa otázky.</p>
<form id="fulltext-form" role="search"><label for="fulltext">Čo potrebujete vyriešiť?</label><div class="finder-input"><input id="fulltext" name="q" type="search" enterkeyhint="search" placeholder="Napríklad: stratil som občiansky preukaz" autocomplete="off" aria-controls="fulltext-results" required/><button type="submit">Hľadať</button></div></form>
<section class="finder-panel" aria-labelledby="assistant-title"><h2 id="assistant-title">Digitálny sprievodca</h2><p><strong>Bezplatná verzia bez generatívneho AI modelu.</strong> Sprievodca rozpozná kľúčové témy vašej otázky a zobrazí relevantné návody. Nevymýšľa odpovede a neposiela otázky externému AI poskytovateľovi.</p><div id="assistant-answer" role="status" aria-live="polite">Napíšte otázku vyššie. Pomôžem nájsť relevantné postupy a zdroje.</div></section>
<section aria-labelledby="results-title"><h2 id="results-title">Výsledky <span id="result-count" aria-live="polite"></span></h2><div id="fulltext-results" class="finder-results"></div><p id="no-match" hidden>Nenašli sa zodpovedajúce témy. Skúste kratší výraz alebo iné slová.</p></section>
<p class="note">Vyhľadávanie funguje v obsahu portálu, nie na celom internete. Odborné, právne a úradné podmienky si vždy potvrďte v oficiálnom zdroji. Vyhľadávanie je spracované vo vašom prehliadači.</p>
</main>
<script id="search-catalog" type="application/json" set:html={JSON.stringify(unique).replace(/</g,'\\u003c')}></script>
<script>
import {searchPortal} from '../lib/search.mjs';
type Entry={title:string;category:string;url:string;description:string;keywords?:string};
const data=JSON.parse(document.querySelector('#search-catalog')!.textContent||'[]') as Entry[];
const form=document.querySelector<HTMLFormElement>('#fulltext-form')!;
const input=document.querySelector<HTMLInputElement>('#fulltext')!;
const results=document.querySelector<HTMLElement>('#fulltext-results')!;
const answer=document.querySelector<HTMLElement>('#assistant-answer')!;
const count=document.querySelector<HTMLElement>('#result-count')!;
const empty=document.querySelector<HTMLElement>('#no-match')!;
function lookup(query:string){return searchPortal(data,query);}
function run(q:string){const matches=lookup(q);results.replaceChildren();count.textContent='('+matches.length+')';empty.hidden=matches.length!==0;for(const {item} of matches){const a=document.createElement('a');a.href=item.url;a.className='finder-result';const category=document.createElement('span');category.className='tag';category.textContent=item.category;const title=document.createElement('strong');title.textContent=item.title+' →';const desc=document.createElement('span');desc.textContent=item.description;a.append(category,title,desc);results.append(a);}answer.replaceChildren();const p=document.createElement('p');p.textContent=matches.length?'K vašej otázke odporúčam začať týmto obsahom:':'K tejto otázke zatiaľ nemáme vhodný návod. Skúste konkrétnejší výraz.';answer.append(p);for(const {item} of matches.slice(0,3)){const link=document.createElement('a');link.href=item.url;link.textContent=item.title+' ↗';link.className='assistant-link';answer.append(link);}if(q)history.replaceState(null,'','?q='+encodeURIComponent(q));}
form.addEventListener('submit',e=>{e.preventDefault();if(input.value.trim())run(input.value.trim());});
const initial=new URLSearchParams(location.search).get('q');if(initial){input.value=initial;run(initial);}
window.addEventListener('popstate',()=>{const q=new URLSearchParams(location.search).get('q')||'';input.value=q;if(q)run(q);else{results.replaceChildren();count.textContent='';empty.hidden=true;answer.textContent='Napíšte otázku vyššie. Pomôžem nájsť relevantné postupy a zdroje.';}});
</script>
<style>
.finder{max-width:1100px}.finder h1{max-width:20ch}.finder form{margin:2rem 0}.finder label{display:block;font-weight:700;margin-bottom:.65rem}.finder-input{display:flex;gap:.7rem}.finder-input input{flex:1;min-width:0;border:1px solid #9ba9be;border-radius:12px;padding:1rem;background:var(--surface);color:var(--ink)}.finder-input button{background:#5145d8;color:white;border:0;border-radius:12px;padding:0 1.5rem;min-height:48px;cursor:pointer}.finder-input input:focus-visible,.finder-input button:focus-visible,.finder-result:focus-visible{outline:3px solid #f59e0b;outline-offset:3px}.finder-panel{padding:1.5rem;border:1px solid #c7d2e3;border-radius:18px;margin:2rem 0;background:var(--surface)}.finder-panel p{line-height:1.65}.finder-results{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr));gap:1rem}.finder-result{display:flex;flex-direction:column;gap:.7rem;padding:1.2rem;border:1px solid #c7d2e3;border-radius:14px;background:var(--surface);color:var(--ink)}.finder-result strong{font-size:1.1rem}.finder-result span:last-child{line-height:1.5}.assistant-link{display:inline-block;margin:.4rem .8rem .4rem 0;text-decoration:underline}@media(max-width:520px){.finder form{margin:1.25rem 0}.finder-input{flex-direction:column;gap:.55rem}.finder-input input{font-size:16px;min-height:48px}.finder-input button{padding:.85rem 1rem;width:100%}.finder-panel{padding:1rem;margin:1.25rem 0}.finder-results{grid-template-columns:minmax(0,1fr)}.finder-result{padding:1rem;min-height:64px}.assistant-link{padding:.45rem 0;min-height:44px}}
</style>
</Base>