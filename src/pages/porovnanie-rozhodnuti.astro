---
import Base from '../layouts/Base.astro';
const fields=[['upfront','Vlastná vstupná platba a poplatky (€)','0.01','10000000'],['monthly','Mesačná prevádzka alebo nájom bez splátky (€)','0.01','10000000'],['residual','Odhad hodnoty vlastného majetku na konci (€)','0.01','10000000'],['principal','Financovaná istina úveru (€)','0.01','10000000'],['annualRate','Nominálna ročná úroková sadzba (%)','0.01','50'],['loanMonths','Počet mesačných splátok úveru','1','600']];
---
<Base title="Porovnanie rozhodnutí" description="Porovnajte vlastné varianty kúpy, financovania alebo nájmu za rovnaké obdobie. Uložte si porovnania iba vo svojom prehliadači.">
<main id="obsah" class="wrap main decisions"><p><a href="/moj-prehlad/">Môj prehľad</a> / Rozhodnutia</p><h1>Porovnanie rozhodnutí</h1><p class="intro">Porovnajte napríklad dve autá, nájom a kúpu alebo vlastné peniaze a úver. Zadajte všetky budúce platby od dneška za rovnaké obdobie.</p>
<p class="note">Počítame s vašimi odhadmi bez rastu cien a úročenia voľných peňazí. Nejde o cenovú ponuku ani schválenie financovania. Údaje sa neodosielajú; ukladajú sa iba po stlačení tlačidla Uložiť porovnanie.</p>
<form id="decision-form" class="panel"><label for="decision-title">Názov porovnania<input id="decision-title" required maxlength="100" placeholder="Napríklad auto alebo bývanie" /></label><label for="decision-months">Rovnaké obdobie v mesiacoch (1–600)<input id="decision-months" type="number" min="1" max="600" step="1" value="60" required /></label>
<div class="decision-grid">{[0,1].map((n)=><fieldset><legend>Variant {n+1}</legend><label for={`decision-${n}-name`}>Názov variantu<input id={`decision-${n}-name`} maxlength="80" required placeholder={n===0?'Napríklad kúpa za hotovosť':'Napríklad kúpa na úver'} /></label>{fields.map(([key,label,step,max])=><label for={`decision-${n}-${key}`}>{label}<input id={`decision-${n}-${key}`} type="number" min="0" max={max} step={step} value="0" required inputmode={step==='1'?'numeric':'decimal'} /></label>)}</fieldset>)}</div>
<p><strong>Bez dvojitého započítania:</strong> do vstupnej platby zadajte vlastnú akontáciu a poplatky. Financovanú časť ceny zadajte iba ako istinu úveru. Splátku počítame automaticky; nezahŕňajte ju do mesačnej prevádzky. Bez úveru nechajte istinu, sadzbu aj počet splátok na nule.</p>
<p>Hodnota majetku je odhad predajnej ceny ku koncu zvoleného obdobia. Pri nájme bez vlastného majetku zadajte nulu. Nevratné poplatky zahrňte do vstupnej platby; vratnú zábezpeku nezapočítajte ako náklad, ak sa má celá vrátiť.</p>
<div class="actions"><button type="submit">Vypočítať porovnanie</button><button type="reset">Nové porovnanie</button></div></form>
<p id="decision-status" role="status" aria-live="polite"></p>
<section id="decision-result" class="panel" hidden><h2 tabindex="-1" id="decision-result-heading">Výsledok rovnakého obdobia</h2><p id="decision-verdict"></p><div class="table-scroll"><table><caption>Zaplatené peniaze a hodnota majetku sú uvedené samostatne.</caption><thead id="decision-head"></thead><tbody id="decision-rows"></tbody></table></div><p>Čisté náklady = vlastná vstupná platba + mesačná prevádzka × obdobie + zaplatené splátky + zostávajúci dlh − hodnota majetku na konci. Záporný výsledok znamená, že váš odhad hodnoty majetku prevyšuje náklady a dlh; overte tento predpoklad.</p><p>Úver: mesačný úrok je nominálna sadzba / 12. Úrok aj splátku zaokrúhľujeme na centy a poslednú splátku dorovnáme. Istina je čerpaná na začiatku, splátky na konci mesiaca. Model nezahŕňa RPMN, zmeny sadzieb ani nezadané poistky a poplatky. Pri splatnosti po konci porovnania pripočítame nesplatený dlh.</p><div class="actions"><button id="decision-save" type="button">Uložiť porovnanie</button><button id="decision-export" type="button">Stiahnuť porovnanie CSV</button></div></section>
<section class="panel"><h2>Uložené porovnania</h2><p>Najviac 30 porovnaní v tomto prehliadači. Údaje nie sú automaticky synchronizované. Prenos umožňuje <a href="/zaloha/">šifrovaná záloha</a>.</p><p id="decision-storage" role="status" tabindex="-1"></p><ul id="decision-saved"></ul></section>
<p><a href="/centrum-uspor/">Porovnať ponuky služieb</a> · <a href="/moje-situacie/">Moje situácie</a></p><noscript><p>Výpočet a ukladanie vyžadujú JavaScript.</p></noscript></main>
<script>
import {DECISIONS_KEY,emptyDecisions,normalizeDecisions,compareDecisions,comparisonCsv} from '../lib/decision-comparison.mjs';
const get=(id:string)=>document.getElementById('decision-'+id)!;
const input=(id:string)=>get(id) as HTMLInputElement;
const form=get('form') as HTMLFormElement;let selected:string|null=null;let latest:any=null;
const money=(n:number)=>new Intl.NumberFormat('sk-SK',{style:'currency',currency:'EUR'}).format(n);
const fields=['upfront','monthly','residual','principal','annualRate','loanMonths'];
function read(){const raw=localStorage.getItem(DECISIONS_KEY);return raw===null?emptyDecisions():normalizeDecisions(JSON.parse(raw));}
function renderSaved(){const list=get('saved');list.replaceChildren();try{const state=read();get('storage').textContent=state.comparisons.length?'Kliknutím načítate uložené vstupy.':'Zatiaľ nie je uložené žiadne porovnanie.';for(const item of state.comparisons){const li=document.createElement('li'),load=document.createElement('button'),del=document.createElement('button');load.type=del.type='button';load.textContent=item.title;del.textContent='Odstrániť '+item.title;load.addEventListener('click',()=>{selected=item.id;input('title').value=item.title;input('months').value=String(item.months);item.variants.forEach((v:any,i:number)=>{input(i+'-name').value=v.name;for(const key of fields)input(i+'-'+key).value=String(v[key]);});latest=null;get('result').hidden=true;get('status').textContent='Uložené vstupy načítané. Pred uložením zmeny ich prepočítajte.';input('title').focus();});del.addEventListener('click',()=>{try{const fresh=read();fresh.comparisons=fresh.comparisons.filter((v:any)=>v.id!==item.id);localStorage.setItem(DECISIONS_KEY,JSON.stringify(normalizeDecisions(fresh)));if(selected===item.id)selected=null;get('status').textContent='Porovnanie odstránené.';renderSaved();get('storage').focus();}catch{get('status').textContent='Odstránenie sa nepodarilo. Pôvodné údaje sa neprepísali.';}});li.append(load,' ',del);list.append(li);}}catch{get('storage').textContent='Uložené údaje nie sú dostupné alebo majú neplatný formát. Pôvodné záznamy neprepíšeme; výpočet a CSV môžete použiť bez uloženia.';}}
function collect(){return {months:input('months').valueAsNumber,variants:[0,1].map(i=>({name:input(i+'-name').value,...Object.fromEntries(fields.map(key=>[key,input(i+'-'+key).valueAsNumber]))}))};}
form.addEventListener('input',()=>{latest=null;get('result').hidden=true;});
form.addEventListener('reset',()=>{selected=null;latest=null;get('result').hidden=true;get('status').textContent='Začínate nové porovnanie. Uložené záznamy zostali zachované.';});
form.addEventListener('submit',event=>{event.preventDefault();try{const data=collect();const result=compareDecisions(data);latest={...data,title:input('title').value.trim()};const head=document.createElement('tr');for(const name of ['Položka',...result.results.map((r:any)=>r.name)]){const th=document.createElement('th');th.scope='col';th.textContent=name;head.append(th);}get('head').replaceChildren(head);get('rows').replaceChildren();for(const [label,key] of [['Vlastná vstupná platba','upfront'],['Prevádzka za celé obdobie','recurring'],['Mesačná splátka úveru (posledná sa môže líšiť)','payment'],['Zaplatené splátky','installments'],['Z toho úroky','interest'],['Zaplatené peniaze spolu','cashPaid'],['Zostávajúci dlh','remainingDebt'],['Odhad hodnoty majetku','residual'],['Čisté náklady','netCost']]){const row=document.createElement('tr'),th=document.createElement('th');th.scope='row';th.textContent=label;row.append(th);for(const value of result.results){const td=document.createElement('td');td.textContent=money(value[key]);row.append(td);}get('rows').append(row);}get('verdict').textContent=result.difference===0?'Čisté náklady oboch variantov sú podľa vašich vstupov rovnaké.':(result.difference>0?result.results[0].name:result.results[1].name)+' má podľa vašich vstupov nižšie čisté náklady o '+money(Math.abs(result.difference))+'. Zohľadnite aj rozdiel kvality a neistotu zostatkovej hodnoty.';get('result').hidden=false;get('status').textContent='Výpočet hotový. Vstupy sa zatiaľ neuložili.';get('result-heading').focus();window.dispatchEvent(new CustomEvent('v24:complete',{detail:{tool:'comparison'}}));}catch(error){get('status').textContent=error instanceof Error?error.message:'Skontrolujte vstupy.';}});
get('save').addEventListener('click',()=>{if(!latest)return;try{const state=read();const id=selected??crypto.randomUUID();const item={id,title:latest.title,months:latest.months,variants:latest.variants};const index=state.comparisons.findIndex((v:any)=>v.id===id);if(index>=0)state.comparisons[index]=item;else state.comparisons.push(item);localStorage.setItem(DECISIONS_KEY,JSON.stringify(normalizeDecisions(state)));selected=id;get('status').textContent='Porovnanie uložené v tomto prehliadači.';renderSaved();}catch(error){get('status').textContent='Uloženie sa nepodarilo. Pôvodné údaje sa neprepísali. '+(error instanceof Error?error.message:'');}});
get('export').addEventListener('click',()=>{if(!latest)return;const url=URL.createObjectURL(new Blob([comparisonCsv(latest.title,latest)],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='porovnanie-rozhodnuti.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
window.addEventListener('storage',()=>{selected=null;renderSaved();});renderSaved();
</script>
<style>
.decisions{max-width:1080px}.decisions .panel{padding:1.3rem;margin:1.3rem 0}.decision-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.decisions label{display:block;font-weight:650;margin:.8rem 0}.decisions input{width:100%;box-sizing:border-box;display:block;margin-top:.35rem;padding:.75rem;font:inherit;color:var(--ink);background:var(--surface);border:1px solid #8290a5;border-radius:8px}.decisions fieldset{min-width:0;border:1px solid #8290a5;border-radius:8px;padding:1rem}.decisions legend{font-weight:750}.decisions button{font:inherit;padding:.75rem;min-height:44px;border:1px solid #8290a5;border-radius:8px;background:var(--surface);color:var(--ink);cursor:pointer}.actions{display:flex;flex-wrap:wrap;gap:.7rem}.decisions li{margin:.7rem 0;overflow-wrap:anywhere}.decisions :is(button,input):focus-visible{outline:3px solid currentColor;outline-offset:3px}.table-scroll{overflow-x:auto}.decisions table{width:100%;border-collapse:collapse}.decisions :is(td,th){text-align:left;padding:.7rem;border-bottom:1px solid #8290a5;vertical-align:top}.decisions caption{text-align:left;padding:.7rem 0}.decisions [hidden]{display:none!important}@media(max-width:700px){.decision-grid{grid-template-columns:1fr}.decisions .panel{padding:1rem}.decisions :is(th,td){min-width:100px}}
</style>
