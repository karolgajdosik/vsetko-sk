---
import Base from '../../layouts/Base.astro';
const hubs=[{"slug":"porovnavac","title":"VŠETKO Porovnávač","desc":"Porovnávajte služby a modelové náklady na jednom mieste.","links":[["/financie/porovnanie-hypotek/","Porovnanie troch hypoték"],["/auto/porovnanie-nakladov/","EV vs. benzín vs. diesel"],["/data/nabijacky/","Nabíjacie stanice"]],"next":"Pripravujeme jednotný model ponúk s dátumom overenia a zdrojom. Aktuálne nástroje počítajú zo zadaných údajov; nepredstavujú živé ponuky poskytovateľov."},{"slug":"slovensko","title":"VŠETKO Slovensko","desc":"Otvorené štatistiky a oficiálne dáta o Slovensku.","links":[["/data/ukazovatele/","Ekonomické ukazovatele"],["/data/statdata/","STATdata"],["/urady/","Úrady"]],"next":"Regionálne porovnanie miest a okresov bude možné až po pripojení overiteľných regionálnych údajov."},{"slug":"financie-pro","title":"VŠETKO Financie PRO","desc":"Finančné plánovanie bez účtu a bez odosielania osobných údajov.","links":[["/moje-centrum/#rozpocet","Mesačný rozpočet"],["/moje-centrum/#hypoteka","Hypotéka a rozpočet"],["/financie/porovnanie-hypotek/","Ponuky hypoték"],["/kalkulacky/financna-rezerva/","Finančná rezerva"]],"next":"Ďalšie kroky: ciele sporenia a scenáre splácania dlhov. Výpočty nie sú finančné poradenstvo."},{"slug":"auto-ev","title":"VŠETKO Auto & EV","desc":"Nástroje pre vodičov aj majiteľov elektromobilov.","links":[["/auto/porovnanie-nakladov/","Celkové náklady vozidiel"],["/kalkulacky/naklady-na-auto/","Prevádzkové náklady"],["/data/nabijacky/","Nabíjacie stanice"],["/sprievodca/nove-auto/","Kúpa auta"]],"next":"Plánované rozšírenie: servisný denník a plánovanie ciest. Ceny nabíjania treba vždy overiť u prevádzkovateľa."},{"slug":"obcan","title":"VŠETKO Občan","desc":"Životné situácie, úrady, formuláre a termíny.","links":[["/sprievodca/","Životné situácie"],["/urady/","Úradné informácie"],["/dokumenty/","Vzory dokumentov"],["/kalendar/","Termíny povinností"]],"next":"Postupne doplníme kontrolu aktualizácie postupov a priame odkazy na konkrétne elektronické služby štátu."},{"slug":"firmy","title":"VŠETKO Firmy","desc":"Vyhľadávanie verejných informácií o podnikateľských subjektoch.","links":[["/data/firmy/","Overenie firmy"],["/data/","Otvorené dáta"],["/sprievodca/zivnost/","Založenie živnosti"]],"next":"Ďalšie možnosti závisia od dostupnosti a podmienok verejných registrov. Údaje treba overovať v pôvodnom registri."},{"slug":"dnes","title":"VŠETKO DNES","desc":"Vlastný denný prehľad údajov a osobných termínov.","links":[["/kalendar/","Moje termíny"],["/data/kurzy/","Kurzy mien"],["/data/ukazovatele/","Ekonomické údaje"],["/moje-centrum/","Moje centrum"]],"next":"Pripravujeme voliteľné moduly úvodnej stránky. Neponúkame automaticky generované správy bez overeného zdroja."}];
export function getStaticPaths(){return hubs.map(h=>({params:{slug:h.slug},props:{hub:h}}));}
const {hub}=Astro.props;
---
<Base title={hub.title} description={hub.desc}>
<main class="wrap main hub" id="obsah"><p class="eyebrow"><a href="/sluzby/">Služby</a> / {hub.title}</p><h1>{hub.title}</h1><p class="intro">{hub.desc}</p><section class="panel"><h2>Dostupné nástroje</h2><div class="hub-grid">{hub.links.map(([url,title])=><a class="hub-link" href={url}><strong>{title}</strong><span>Otvoriť →</span></a>)}</div></section><section class="panel"><h2>Čo rozširujeme</h2><p>{hub.next}</p><p class="note">Portál je nezávislý pilotný projekt. Ak ide o verejné dáta alebo ponuky, rozhodujú údaje ich pôvodného poskytovateľa.</p></section></main>
<style>.hub{max-width:1050px}.hub .panel{padding:1.5rem;margin:1.5rem 0}.hub-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.hub-link{display:flex;flex-direction:column;gap:.7rem;border:1px solid #8290a5;border-radius:12px;padding:1.2rem;color:var(--ink);text-decoration:none}.hub-link span{color:#7a6af5}@media(max-width:650px){.hub-grid{grid-template-columns:1fr}}</style>
</Base>