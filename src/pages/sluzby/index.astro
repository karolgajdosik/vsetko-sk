---
import Base from '../../layouts/Base.astro';
import tools from '../../data/suite-tools.json';
import hubs from '../../data/hubs.json';
---
<Base title="Veľké služby VŠETKO24" description="Prehľad ôsmich oblastí VŠETKO24: AI, porovnávanie, Slovensko, financie, auto, občan, firmy a denný prehľad.">
<main class="wrap main services" id="obsah"><p class="eyebrow">VŠETKO24 · Nová generácia služieb</p><h1>Všetky služby na jednom mieste</h1><p class="intro">Vyberte si oblasť. Každá služba prepája existujúce nástroje a bude sa rozširovať o nové funkcie. Funkčné nástroje sú označené odkazmi; pripravované možnosti sú výslovne opísané.</p><div class="services-grid"><a class="service" href="/ai/"><strong>✦ VŠETKO AI</strong><p>Otázky, praktické odpovede a zdroje.</p><span>Otvoriť asistenta →</span></a>{hubs.map(h=><a class="service" href={`/sluzby/${h.slug}/`}><strong>{h.title}</strong><p>{h.desc}</p><span>Otvoriť službu →</span></a>)}</div><h2>Interaktívne nástroje</h2><div class="services-grid">{tools.map(t=><a class="service" href={`/nastroje/${t.slug}/`}><strong>{t.title}</strong><p>{t.desc}</p><span>Spustiť →</span></a>)}</div></main>
<style>.services{max-width:1100px}.services-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.8rem 0}.service{border:1px solid #8290a5;border-radius:15px;padding:1.5rem;text-decoration:none;color:var(--ink);background:var(--surface)}.service strong{font-size:1.15rem}.service p{line-height:1.5}.service span{color:var(--accent,#5845cd);font-weight:700}@media(max-width:850px){.services-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.services-grid{grid-template-columns:1fr}}</style>
</Base>
