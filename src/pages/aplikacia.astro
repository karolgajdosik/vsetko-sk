---
import Base from '../layouts/Base.astro';
---
<Base title="VŠETKO24 do mobilu" description="Pridajte si VŠETKO24.sk na plochu mobilu bez obchodu s aplikáciami. Návody na inštaláciu a vysvetlenie offline režimu.">
<main class="wrap main app-page" id="obsah">
  <p class="eyebrow">VŠETKO24 · Mobilná aplikácia</p>
  <h1>VŠETKO24 do mobilu</h1>
  <p class="intro">Pridajte si portál na plochu telefónu alebo počítača. Otvoríte ho jedným dotykom bez hľadania adresy a bez registrácie.</p>
  <section class="panel" aria-labelledby="app-install-title">
    <h2 id="app-install-title">Pridať na plochu</h2>
    <p id="app-install-status" role="status">Spôsob pridania závisí od vášho prehliadača. Ak sa tlačidlo inštalácie nezobrazí, použite postup nižšie.</p>
    <button type="button" id="app-install" hidden>Pridať VŠETKO24 do zariadenia</button>
    <h3>iPhone a iPad</h3>
    <ol><li>Otvorte <strong>vsetko24.sk</strong> v Safari.</li><li>V ponuke zdieľania vyberte <strong>Pridať na plochu</strong>. Ak je dostupná voľba otvorenia ako webovej aplikácie, zapnite ju.</li><li>Potvrďte pridanie. Ikonu potom nájdete na ploche.</li></ol>
    <h3>Android</h3>
    <ol><li>Otvorte portál v Chrome alebo inom podporovanom prehliadači.</li><li>V ponuke prehliadača vyberte <strong>Inštalovať aplikáciu</strong> alebo <strong>Pridať na plochu</strong>. Názov možnosti sa môže líšiť.</li><li>Potvrďte pridanie do zariadenia.</li></ol>
    <p class="note">Na počítači môže podporovaný prehliadač ponúknuť inštaláciu pri adresnom riadku. Ak možnosť chýba, portál môžete ďalej používať ako bežný web.</p>
  </section>
  <section class="panel" aria-labelledby="app-offline-title">
    <h2 id="app-offline-title">Čo funguje bez internetu?</h2>
    <p>Po úspešnom načítaní offline režimu je pri strate pripojenia dostupná obrazovka so stručnými prípravnými kontrolnými zoznamami pre úrady a dokumenty, financie a domácnosť, auto a cestovanie. Nejde o úplné offline návody ani aktuálne údaje. Kalkulačky, vyhľadávanie a API nie sú dostupné ako offline kópia. Osobné údaje sa do offline cache neukladajú.</p>
    <p>Portál neposiela push upozornenia a po zatvorení aplikácie nevykonáva úlohy na pozadí. Termíny môžete z <a href="/kalendar/">kalendára povinností</a> exportovať do vlastnej kalendárovej aplikácie.</p>
    <p class="note">Pridanie na plochu nezálohuje ani nesynchronizuje vaše lokálne záznamy. Samostatná webová aplikácia môže podľa zariadenia používať iné úložisko ako karta prehliadača.</p>
  </section>
  <section class="panel" aria-labelledby="app-check-title">
    <h2 id="app-check-title">Kontrola pripravenosti v tomto zariadení</h2>
    <p>Táto kontrola prebieha iba vo vašom prehliadači. Overí pripojenie, samostatný režim a ovládanie stránky offline pracovníkom. Neoveruje obsah cache ani dostupnosť všetkých stránok bez internetu.</p>
    <p id="app-connection" role="status" aria-live="polite">Stav pripojenia sa zisťuje…</p>
    <p id="app-worker" role="status" aria-live="polite">Stav offline režimu sa zisťuje…</p>
    <p id="app-mode" role="status">Režim otvorenia sa zisťuje…</p>
    <button id="app-recheck" type="button">Skontrolovať znova</button>
    <button id="app-copy-diagnostics" type="button">Skopírovať výsledok kontroly</button>
    <p id="app-copy-status" role="status" aria-live="polite"></p>
    <p class="note">Kopírovaný text obsahuje len technické stavy zobrazené vyššie a čas kontroly, nie vaše formuláre, údaje účtu ani obsah úložiska. Skopírovanie sa spustí iba po stlačení tlačidla.</p>
    <p class="note">Skutočnú dostupnosť offline obrazovky overíte až po prvom online načítaní: vypnite internet a skúste otvoriť novú stránku. Neskúšajte to s neuloženými formulármi.</p>
  </section>
  <section class="panel" aria-labelledby="app-start-title"><h2 id="app-start-title">Kam chcete pokračovať?</h2><nav class="app-links" aria-label="Hlavné nástroje aplikácie"><a href="/ai/">Asistent a vyhľadávanie</a><a href="/kalkulacky/">Kalkulačky</a><a href="/navody/">Praktické návody</a><a href="/moje-centrum/">Moje centrum</a></nav></section>
</main>
<script>
type InstallPromptEvent = Event & {prompt:()=>Promise<void>;userChoice:Promise<{outcome:string}>};
const installButton=document.querySelector<HTMLButtonElement>('#app-install');
const installStatus=document.querySelector<HTMLElement>('#app-install-status');
const connectionStatus=document.querySelector<HTMLElement>('#app-connection');
const workerStatus=document.querySelector<HTMLElement>('#app-worker');
const modeStatus=document.querySelector<HTMLElement>('#app-mode');
const copyStatus=document.querySelector<HTMLElement>('#app-copy-status');
let lastCheckTime='';
async function checkReadiness(){
  lastCheckTime=new Date().toLocaleString('sk-SK',{timeZone:'Europe/Bratislava'});
  if(connectionStatus)connectionStatus.textContent=navigator.onLine?'Prehliadač hlási pripojenie k sieti (dostupnosť servera nie je overená).':'Prehliadač hlási režim bez pripojenia.';
  if(modeStatus)modeStatus.textContent=(window.matchMedia('(display-mode: standalone)').matches||('standalone' in navigator&&navigator.standalone===true))?'Otvorené ako samostatná aplikácia.':'Otvorené v prehliadači; samostatná inštalácia nie je potvrdená.';
  if(!workerStatus)return;
  if(!('serviceWorker' in navigator)){workerStatus.textContent='Offline pracovník nie je v tomto prehliadači podporovaný.';return;}
  try{
    const registration=await navigator.serviceWorker.getRegistration();
    if(navigator.serviceWorker.controller)workerStatus.textContent='Táto stránka je ovládaná offline pracovníkom. Dostupnosť offline obsahu ešte nie je overená.';
    else if(registration?.active)workerStatus.textContent='Offline pracovník je aktívny, ale túto stránku zatiaľ neovláda. Skúste stránku znovu načítať.';
    else workerStatus.textContent='Pre túto stránku zatiaľ nie je potvrdený aktívny offline pracovník. Otvorte ju online a skúste to znova.';
  }catch{workerStatus.textContent='Stav offline pracovníka sa nepodarilo zistiť. Offline dostupnosť nie je potvrdená.';}
}
document.querySelector<HTMLButtonElement>('#app-recheck')?.addEventListener('click',()=>{void checkReadiness();});
document.querySelector<HTMLButtonElement>('#app-copy-diagnostics')?.addEventListener('click',async()=>{
  if(copyStatus)copyStatus.textContent='';
  await checkReadiness();
  const report=['VŠETKO24 – diagnostika PWA','Čas (Bratislava): '+lastCheckTime,'Pripojenie: '+(connectionStatus?.textContent||'nezistené'),'Offline pracovník: '+(workerStatus?.textContent||'nezistené'),'Režim: '+(modeStatus?.textContent||'nezistené'),'Poznámka: nejde o potvrdenie skutočnej offline dostupnosti.'].join('\n');
  try{
    if(!navigator.clipboard?.writeText)throw new Error('Clipboard unavailable');
    await navigator.clipboard.writeText(report);
    if(copyStatus)copyStatus.textContent='Technický výsledok bol skopírovaný. Pred zdieľaním ho môžete skontrolovať.';
  }catch{if(copyStatus)copyStatus.textContent='Kopírovanie nie je v tomto prehliadači dostupné. Technické stavy sú uvedené vyššie.';}
});
window.addEventListener('online',()=>{void checkReadiness();});
window.addEventListener('offline',()=>{void checkReadiness();});
if('serviceWorker' in navigator)navigator.serviceWorker.addEventListener('controllerchange',()=>{void checkReadiness();});
void checkReadiness();
let pendingPrompt:InstallPromptEvent|null=null;
const standalone=window.matchMedia('(display-mode: standalone)').matches||('standalone' in navigator&&navigator.standalone===true);
if(standalone&&installStatus)installStatus.textContent='Portál je otvorený ako samostatná webová aplikácia.';
window.addEventListener('beforeinstallprompt',event=>{
  event.preventDefault();pendingPrompt=event as InstallPromptEvent;
  if(installButton&&!standalone)installButton.hidden=false;
});
installButton?.addEventListener('click',async()=>{
  if(!pendingPrompt)return;
  const prompt=pendingPrompt;pendingPrompt=null;installButton.hidden=true;
  try{
    await prompt.prompt();const choice=await prompt.userChoice;
    if(installStatus)installStatus.textContent=choice.outcome==='accepted'?'Pridanie bolo potvrdené. Dokončenie závisí od vášho prehliadača.':'Pridanie ste zrušili. Portál môžete ďalej používať v prehliadači.';
  }catch{if(installStatus)installStatus.textContent='Inštaláciu sa nepodarilo otvoriť. Použite postup pre váš prehliadač uvedený nižšie.';}
});
window.addEventListener('appinstalled',()=>{
  pendingPrompt=null;if(installButton)installButton.hidden=true;
  if(installStatus)installStatus.textContent='Prehliadač potvrdil pridanie aplikácie. Nájdete ju medzi aplikáciami alebo na ploche.';
});
</script>
<style>.app-page{max-width:900px}.app-page section{padding:1.4rem;margin:1.2rem 0}.app-page li{margin:.6rem 0}.app-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.app-links a{border:1px solid #8290a5;border-radius:10px;padding:.8rem;overflow-wrap:anywhere}#app-install,#app-recheck,#app-copy-diagnostics{min-height:48px;padding:.8rem 1rem;border-radius:10px;border:1px solid #14508c;background:#14508c;color:white;font:inherit;font-weight:700;cursor:pointer}#app-install[hidden]{display:none}@media(max-width:550px){.app-links{grid-template-columns:1fr}}</style>
</Base>
