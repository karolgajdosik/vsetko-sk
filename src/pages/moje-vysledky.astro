---
import Base from '../layouts/Base.astro';
---
<Base title="Moje dokončené kroky" description="Dobrovoľné miestne počítadlá dokončených krokov bez finančných údajov a bez odosielania.">
<main id="obsah" class="wrap main"><h1>Moje dokončené kroky</h1><p><a href="/rozhodovanie/">Osobné rozhodovanie V6</a></p><section class="panel"><h2>Dobrovoľné miestne meranie</h2><p>Po zapnutí počítame úspešné použitia nástrojov V6 iba v tomto prehliadači. Neukladáme finančné sumy, názvy zmlúv, obsah súborov, dátumy ani identifikátory. Tieto počítadlá sa neposielajú správcovi a nepredstavujú celkovú návštevnosť portálu. Opakované výpočty sa počítajú opakovane.</p><p>Verejnú prevádzkovú analytiku opisuje <a href="/metriky/">prehľad portálu</a>. Súhrn používania od všetkých návštevníkov zatiaľ nie je pripojený.</p><button id="metrics-toggle" type="button">Zapnúť miestne počítadlá</button> <button id="metrics-clear" type="button">Vymazať a vypnúť</button><p id="metrics-status" role="status"></p><ul id="metrics-counts"></ul></section><section class="panel"><h2>Ako vzniká odporúčanie</h2><p>Výsledky V6 používajú zadávané čísla a zverejnené výpočty. Každý nástroj uvádza predpoklady; chýbajúce vstupy doplníte sami. Plán sa pridá do úloh až po vašom výbere. Portál nevykonáva platby, neodosiela výpovede ani nepristupuje do banky.</p></section></main>
<script>
import {METRICS_KEY,TOOL_NAMES,readMetrics} from '../lib/completion-metrics.mjs';
const status=document.getElementById('metrics-status')!,toggle=document.getElementById('metrics-toggle') as HTMLButtonElement,list=document.getElementById('metrics-counts')!;
function render(){try{const state=readMetrics(localStorage);toggle.disabled=false;toggle.textContent=state.enabled?'Vypnúť miestne počítadlá':'Zapnúť miestne počítadlá';toggle.setAttribute('aria-pressed',String(state.enabled));list.replaceChildren();for(const [id,name] of Object.entries(TOOL_NAMES)){const li=document.createElement('li');li.textContent=name+': '+(state.counts[id]??0);list.append(li);}status.textContent=state.enabled?'Počítanie je zapnuté iba na tomto zariadení.':'Počítanie je vypnuté.';}catch{status.textContent='Miestne údaje nie sú dostupné alebo sú poškodené. Neboli prepísané.';toggle.disabled=true;}}
toggle.addEventListener('click',()=>{try{const state=readMetrics(localStorage);state.enabled=!state.enabled;localStorage.setItem(METRICS_KEY,JSON.stringify(state));render();}catch{status.textContent='Zmenu nemožno uložiť.';}});
document.getElementById('metrics-clear')!.addEventListener('click',()=>{try{localStorage.removeItem(METRICS_KEY);toggle.disabled=false;render();}catch{status.textContent='Údaje nemožno vymazať.';}});window.addEventListener('storage',render);render();
</script>
<style>.panel{padding:1.4rem;margin:1rem 0}button{min-height:44px;padding:.7rem;font:inherit;color:var(--ink);background:var(--surface);border:1px solid #8290a5;border-radius:8px;margin:.3rem}button:focus-visible{outline:3px solid currentColor;outline-offset:3px}li{padding:.3rem}</style>
</Base>
