import Base from '../layouts/Base.astro';
const tools=[['/import-vydavkov/','1. Načítajte výdavky','Z CSV vyberte mesiac, overte kategórie a preneste iba súhrnný rozpočet.'],['/financie/kontrola/','2. Skontrolujte financie','Zistite rezervu, voľné peniaze a dopad splátok s vysvetlením výpočtu.'],['/rocne-vydavky/','3. Pripravte ročné platby','Rozdeľte nepravidelné výdavky na potrebné mesačné rezervy.'],['/porovnanie-rozhodnuti/','4. Porovnajte možnosti','Dva vlastné varianty vrátane financovania a zostatkovej hodnoty.'],['/moje-zmluvy/','5. Skontrolujte zmluvy','Platby, výročia a vlastné lehoty s prepojením na kalendár a dokumenty.'],['/moj-plan/','6. Prijmite ďalšie kroky','Vyberte návrhy, ktoré chcete pridať do svojich úloh.'],['/moje-vysledky/','7. Sledujte dokončenie','Dobrovoľné miestne počítadlá bez finančných údajov.']];
---
<Base title="Osobné rozhodovanie V6" description="Prepojte výdavky, rezervy, zmluvy a vlastné rozhodnutia do konkrétneho plánu. Bez účtu a platených AI služieb.">
<main class="wrap main decision-hub" id="obsah"><p class="eyebrow">VŠETKO24 · V6</p><h1>Rozhodnite sa s vlastnými číslami</h1><p class="intro">Od výdavkov k porovnaniu možností a konkrétnym úlohám. Každý výpočet ukazuje predpoklady a používa údaje, ktoré zadáte alebo výslovne prenesiete.</p><p><a href="/moje-situacie/">Moje situácie</a> · <a href="/zaloha/">Šifrovaná záloha</a> · <a href="/moj-prehlad/">Môj prehľad</a></p><div class="tools">{tools.map(([href,title,body])=><section class="panel"><h2><a href={href}>{title}</a></h2><p>{body}</p></section>)}</div><section class="panel"><h2>Vaše údaje a vaše rozhodnutie</h2><p>Bez povinného účtu. Zmluvy, porovnania a ročné výdavky môžete ukladať v tomto prehliadači a zahrnúť do šifrovanej zálohy. Surové bankové transakcie sa nearchivujú. Vymazaním údajov prehliadača prídete o miestne záznamy, preto si vytvorte zálohu.</p><p>Termíny sa exportujú do vášho kalendára. Portál neposiela platby ani dokumenty poskytovateľom a neposkytuje bankové schválenie financovania.</p></section></main>
<style>.decision-hub{max-width:1100px}.tools{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.panel{padding:1.3rem;margin:1rem 0;overflow-wrap:anywhere}.panel h2{margin-top:0;font-size:1.3rem}@media(max-width:650px){.tools{grid-template-columns:1fr}}</style>
</Base>
