---
import Base from '../layouts/Base.astro';
---
<Base title="Kalendár povinností" description="Súkromný kalendár termínov s exportom do kalendára iPhone, Google alebo Outlook. Bez registrácie.">
<main class="wrap main calendar" id="obsah"><p class="eyebrow">Moje centrum · Osobné povinnosti</p><h1>Kalendár povinností</h1><p class="intro">Pridajte si STK, poistenie, výmenu dokladov či vlastný termín. Záznamy sa ukladajú iba v tomto prehliadači bez registrácie a zdieľajú sa s termínmi v <a href="/moje-centrum/#terminy">Mojom centre</a> na tomto zariadení.</p>
<section class="panel" aria-labelledby="calendar-templates-title"><h2 id="calendar-templates-title">Vybrať typ povinnosti</h2><p>Vyberte si predlohu, ktorá sa vás týka. Dátum vždy doplňte podľa vlastného dokladu, zmluvy alebo informácie príslušného úradu.</p><label for="calendar-template">Predloha povinnosti</label><select id="calendar-template"><option value="">Vlastný termín</option><optgroup label="Auto a doprava"><option value="stk">Platnosť STK / EK</option><option value="pzp">Poistenie vozidla</option><option value="service">Servis vozidla</option></optgroup><optgroup label="Doklady"><option value="identity">Občiansky preukaz</option><option value="passport">Cestovný pas</option><option value="driving">Vodičský preukaz</option></optgroup><optgroup label="Domácnosť a financie"><option value="insurance">Poistenie domácnosti</option><option value="mortgage">Koniec fixácie úveru</option><option value="contract">Obnova alebo ukončenie zmluvy</option></optgroup></select><p id="calendar-template-help" class="note" aria-live="polite">Predloha vyplní názov. Žiadny termín sa nevytvorí bez vášho potvrdenia.</p><a id="calendar-template-guide" hidden>Otvoriť súvisiaci návod</a></section>
<section class="panel"><h2>Pridať termín</h2><form id="calendar-form" class="calendar-form"><label>Názov povinnosti<input id="calendar-title" required maxlength="120" placeholder="Napr. koniec platnosti PZP"/></label><label>Dátum<input id="calendar-date" type="date" min="1900-01-01" max="9999-12-31" aria-describedby="calendar-template-help" required/></label><label>Pripomenutie pred termínom<select id="calendar-reminder"><option value="0">Bez pripomienky</option><option value="1">1 deň</option><option value="7">7 dní</option><option value="14" selected>14 dní</option><option value="30">30 dní</option><option value="60">60 dní</option></select></label><button type="submit">Pridať</button></form><button id="calendar-cancel" type="button" hidden>Zrušiť úpravu</button><p id="calendar-status" role="status" aria-live="polite"></p></section>
<section class="panel"><h2>Moje termíny</h2><label for="calendar-filter">Zobraziť</label><select id="calendar-filter"><option value="all">Všetky termíny</option><option value="upcoming">Od dnešného dňa</option><option value="month">Najbližších 30 dní</option><option value="past">Po termíne</option></select><p id="calendar-count" class="note" role="status"></p><div id="calendar-items"></div><button id="calendar-export" type="button">Stiahnuť všetky termíny (.ics)</button><p class="note">Súbor .ics môžete importovať do kalendára v mobile alebo počítači. Export zahŕňa zvolenú pripomienku pred termínom. Upozornenie doručí až vaša kalendárová aplikácia po importe .ics; skontrolujte v nej nastavenia a povolenia. Samotný portál neposiela push ani e-mailové upozornenia.</p></section>
</main>
<script>
import { deadlineTemplates as templates, normalizeDeadline, validDeadlineDate as validDate, deadlineTiming, createDeadlineCalendar, REMINDER_DAYS } from '../lib/deadline-center.mjs';
type Deadline={id:string,title:string,date:string,type?:string,reminderDays?:number};type Store={version:1,tasks:unknown[],deadlines:Deadline[],budget:Record<string,number>};
const key='v24-personal-center-v1';let state:Store={version:1,tasks:[],deadlines:[],budget:{}};const el=(id:string)=>document.getElementById(id)!;
let unsaved=false, unreadable=false, editingId:string|null=null;
const refresh=()=>{if(unsaved)return;try{const stored=localStorage.getItem(key);if(stored===null){state={version:1,tasks:[],deadlines:[],budget:{}};return;}let raw;try{raw=JSON.parse(stored);}catch{unreadable=true;throw new Error('invalid JSON');}if(raw&&raw.version===1&&Array.isArray(raw.deadlines)&&raw.deadlines.length<=500&&Array.isArray(raw.tasks)&&raw.budget&&typeof raw.budget==='object'&&!Array.isArray(raw.budget)){state=raw;unreadable=false;}else{unreadable=true;el('calendar-status').textContent='Uložené údaje majú neznámy formát. Pred úpravou ich skontrolujte v Mojom centre.';}}catch{el('calendar-status').textContent='Ukladanie nie je dostupné alebo sa údaje nedajú načítať. Nové termíny môžete použiť v tejto otvorenej stránke a exportovať.';}};
const save=()=>{if(unreadable){unsaved=true;el('calendar-status').textContent='Pôvodné údaje majú neznámy formát a neboli prepísané. Nový termín platí len v otvorenej stránke; môžete ho exportovať.';return false;}try{localStorage.setItem(key,JSON.stringify(state));unsaved=false;el('calendar-status').textContent='Termíny uložené v tomto prehliadači.';return true;}catch{unsaved=true;el('calendar-status').textContent='Ukladanie nie je dostupné. Zmena platí iba do zatvorenia alebo obnovenia stránky. Termíny si môžete exportovať.';return false;}};
refresh();
function templateHelp(fillTitle=true){const selected=(el('calendar-template') as HTMLSelectElement).value;const t=templates[selected];const link=el('calendar-template-guide') as HTMLAnchorElement;link.hidden=!t?.href;if(t?.href)link.href=t.href;else link.removeAttribute('href');el('calendar-template-help').textContent=t?.help||'Predloha vyplní názov. Žiadny termín sa nevytvorí bez vášho potvrdenia.';if(t&&fillTitle){(el('calendar-title') as HTMLInputElement).value=t.title;(el('calendar-date') as HTMLInputElement).focus();}}
el('calendar-template').addEventListener('change',()=>templateHelp());
const localDay=(d:Date)=>[d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');
function resetEditor(){editingId=null;(el('calendar-form') as HTMLFormElement).reset();(el('calendar-template') as HTMLSelectElement).value='';el('calendar-cancel').hidden=true;el('calendar-form').querySelector('button')!.textContent='Pridať';templateHelp(false);}
el('calendar-cancel').addEventListener('click',()=>{resetEditor();el('calendar-title').focus();});
el('calendar-filter').addEventListener('change',render);
function render(){
 const container=el('calendar-items');container.replaceChildren();
 const sorted=state.deadlines.map(normalizeDeadline).filter(Boolean).sort((a,b)=>a.date.localeCompare(b.date));
 const today=localDay(new Date());const filter=(el('calendar-filter') as HTMLSelectElement).value;
 const visible=sorted.filter(d=>{const days=deadlineTiming(d.date,today)!.days;return filter==='upcoming'?days>=0:filter==='month'?days>=0&&days<=30:filter==='past'?days<0:true;});
 const urgent=sorted.filter(d=>deadlineTiming(d.date,today)!.urgent).length;
 el('calendar-count').textContent='Zobrazené: '+visible.length+' z '+sorted.length+' uložených termínov. Po termíne alebo do 30 dní: '+urgent+'.';
 if(!visible.length){container.textContent=sorted.length?'Pre zvolený filter nemáte žiadne termíny.':'Zatiaľ nemáte žiadne termíny.';return;}
 for(const d of visible){
  const timing=deadlineTiming(d.date,today)!;const template=templates[d.type];const row=document.createElement('article');row.className='event';
  const header=document.createElement('div');header.className='event-heading';const title=document.createElement('h3');title.textContent=d.title;
  const date=document.createElement('time');date.dateTime=d.date;date.textContent=new Date(d.date+'T12:00:00').toLocaleDateString('sk-SK');
  const badge=document.createElement('p');badge.className=timing.urgent?'event-timing urgent':'event-timing';badge.textContent=timing.label+(d.reminderDays?' · Pripomienka v exporte '+d.reminderDays+' dní vopred':' · Bez pripomienky');header.append(title,date,badge);
  const prep=document.createElement('p');prep.textContent=template?.next||'Pripravte si vlastné podklady a overte presný postup a termín. Typ povinnosti môžete doplniť tlačidlom Upraviť.';
  const actions=document.createElement('div');actions.className='event-actions';
  if(template?.href){const guide=document.createElement('a');guide.href=template.href;guide.textContent='Pripraviť podklady a ďalší krok';actions.append(guide);}
  const docs=document.createElement('a');docs.href='/dokumenty/';docs.textContent='Centrum dokumentov';actions.append(docs);
  const edit=document.createElement('button');edit.type='button';edit.textContent='Upraviť';edit.setAttribute('aria-label','Upraviť termín: '+d.title);edit.addEventListener('click',()=>{editingId=d.id;(el('calendar-title') as HTMLInputElement).value=d.title;(el('calendar-date') as HTMLInputElement).value=d.date;(el('calendar-template') as HTMLSelectElement).value=d.type;(el('calendar-reminder') as HTMLSelectElement).value=String(d.reminderDays);templateHelp(false);el('calendar-cancel').hidden=false;el('calendar-form').querySelector('button')!.textContent='Uložiť úpravu';el('calendar-title').focus();});
  const remove=document.createElement('button');remove.type='button';remove.textContent='Odstrániť';remove.setAttribute('aria-label','Odstrániť termín: '+d.title);remove.addEventListener('click',()=>{refresh();state.deadlines=state.deadlines.filter(x=>x.id!==d.id);if(editingId===d.id)resetEditor();const saved=save();render();if(saved)el('calendar-status').textContent='Termín odstránený: '+d.title+'.';el('calendar-title').focus();});
  actions.append(edit,remove);row.append(header,prep,actions);container.append(row);
 }
}
el('calendar-form').addEventListener('submit',e=>{
 e.preventDefault();refresh();const title=(el('calendar-title') as HTMLInputElement).value.trim(),date=(el('calendar-date') as HTMLInputElement).value,reminderDays=Number((el('calendar-reminder') as HTMLSelectElement).value),type=(el('calendar-template') as HTMLSelectElement).value;
 if(!title||title.length>120||!validDate(date)||(!editingId&&state.deadlines.length>=500)||!REMINDER_DAYS.includes(reminderDays)){el('calendar-status').textContent='Skontrolujte názov, skutočný dátum, pripomienku alebo limit 500 termínov.';return;}
 if(state.deadlines.some(d=>d&&d.id!==editingId&&d.title===title&&d.date===date)){el('calendar-status').textContent='Rovnaký názov a dátum už máte uložený.';return;}
 if(editingId&&!state.deadlines.some(d=>d.id===editingId)){el('calendar-status').textContent='Termín bol medzitým odstránený. Zrušte úpravu a pridajte ho znova.';return;}
 const deadline={id:editingId||crypto.randomUUID?.()||String(Date.now()),title,date,type,reminderDays};
 if(editingId)state.deadlines=state.deadlines.map(d=>d.id===editingId?deadline:d);else state.deadlines.push(deadline);
 save();resetEditor();render();el('calendar-title').focus();
});
el('calendar-export').addEventListener('click',()=>{refresh();render();if(!state.deadlines.some(d=>normalizeDeadline(d))){el('calendar-status').textContent='Najskôr pridajte aspoň jeden termín.';return;}const content=createDeadlineCalendar(state.deadlines);const url=URL.createObjectURL(new Blob([content],{type:'text/calendar;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='vsetko24-terminy.ics';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);el('calendar-status').textContent='Kalendár je pripravený na import. Pripomienky a čas upozornenia skontrolujte v cieľovej kalendárovej aplikácii.';});
window.addEventListener('storage',event=>{if(event.key===key||event.key===null){refresh();render();}});
window.addEventListener('pageshow',()=>{refresh();render();});
render();
</script>
<style>.calendar{max-width:1050px}.calendar .panel{padding:1.4rem;margin:1.3rem 0}.calendar-form{display:grid;grid-template-columns:2fr 1fr 1fr auto;align-items:end;gap:.7rem}.calendar label{display:block;font-weight:650}.calendar input,.calendar select{display:block;width:100%;min-width:0;padding:.8rem;border:1px solid #8c9ab0;border-radius:9px;background:var(--surface);color:var(--ink);font:inherit}.calendar button{padding:.8rem;min-height:44px;border:1px solid #8290a5;border-radius:9px;cursor:pointer;background:var(--surface);color:var(--ink);font:inherit}.calendar :global(.event){padding:1.2rem 0;border-bottom:1px solid #8290a5}.calendar :global(.event-heading){display:flex;gap:.5rem 1rem;align-items:baseline;flex-wrap:wrap}.calendar :global(.event h3){margin:0;overflow-wrap:anywhere}.calendar :global(.event-timing){margin:.3rem 0}.calendar :global(.urgent){font-weight:750}.calendar :global(.event-actions){display:flex;flex-wrap:wrap;gap:.7rem;align-items:center}.calendar :global(.event-actions a){display:inline-flex;align-items:center;min-height:44px}.calendar :global(.event p){overflow-wrap:anywhere}#calendar-cancel{margin-top:.7rem}@media(max-width:820px){.calendar-form{grid-template-columns:1fr 1fr}}@media(max-width:550px){.calendar-form{grid-template-columns:1fr}.calendar .panel{padding:1rem}}</style>
</Base>
