---
import Base from '../layouts/Base.astro';
---
<Base title="Kalendár povinností" description="Súkromný kalendár termínov s exportom do kalendára iPhone, Google alebo Outlook. Bez registrácie.">
<main class="wrap main calendar" id="obsah"><p class="eyebrow">Moje centrum · Osobné povinnosti</p><h1>Kalendár povinností</h1><p class="intro">Pridajte si STK, poistenie, výmenu dokladov či vlastný termín. Záznamy sa ukladajú iba v tomto prehliadači bez registrácie a zdieľajú sa s termínmi v <a href="/moje-centrum/#terminy">Mojom centre</a> na tomto zariadení.</p>
<section class="panel" aria-labelledby="calendar-templates-title"><h2 id="calendar-templates-title">Vybrať typ povinnosti</h2><p>Vyberte si predlohu, ktorá sa vás týka. Dátum vždy doplňte podľa vlastného dokladu, zmluvy alebo informácie príslušného úradu.</p><label for="calendar-template">Predloha povinnosti</label><select id="calendar-template"><option value="">Vlastný termín</option><optgroup label="Auto a doprava"><option value="stk">Platnosť STK / EK</option><option value="pzp">Poistenie vozidla</option><option value="service">Servis vozidla</option></optgroup><optgroup label="Doklady"><option value="identity">Občiansky preukaz</option><option value="passport">Cestovný pas</option><option value="driving">Vodičský preukaz</option></optgroup><optgroup label="Domácnosť a financie"><option value="insurance">Poistenie domácnosti</option><option value="mortgage">Koniec fixácie úveru</option><option value="contract">Obnova alebo ukončenie zmluvy</option></optgroup></select><p id="calendar-template-help" class="note" aria-live="polite">Predloha vyplní názov. Žiadny termín sa nevytvorí bez vášho potvrdenia.</p><a id="calendar-template-guide" hidden>Otvoriť súvisiaci návod</a></section>
<section class="panel"><h2>Pridať termín</h2><form id="calendar-form" class="calendar-form"><label>Názov povinnosti<input id="calendar-title" required maxlength="120" placeholder="Napr. koniec platnosti PZP"/></label><label>Dátum<input id="calendar-date" type="date" aria-describedby="calendar-template-help" required/></label><button type="submit">Pridať</button></form><p id="calendar-status" role="status" aria-live="polite"></p></section>
<section class="panel"><h2>Moje termíny</h2><label for="calendar-filter">Zobraziť</label><select id="calendar-filter"><option value="all">Všetky termíny</option><option value="upcoming">Od dnešného dňa</option><option value="month">Najbližších 30 dní</option><option value="past">Po termíne</option></select><p id="calendar-count" class="note" role="status"></p><div id="calendar-items"></div><button id="calendar-export" type="button">Stiahnuť všetky termíny (.ics)</button><p class="note">Súbor .ics môžete importovať do kalendára v mobile alebo počítači. Samotný portál neposiela push ani e-mailové upozornenia; pripomienky nastavíte v kalendárovej aplikácii.</p></section>
</main>
<script>
type Deadline={id:string,title:string,date:string};type Store={version:1,tasks:unknown[],deadlines:Deadline[],budget:Record<string,number>};
const key='v24-personal-center-v1';let state:Store={version:1,tasks:[],deadlines:[],budget:{}};const el=(id:string)=>document.getElementById(id)!;
try{const raw=JSON.parse(localStorage.getItem(key)||'null');if(raw&&raw.version===1&&Array.isArray(raw.deadlines)&&Array.isArray(raw.tasks)&&raw.budget&&typeof raw.budget==='object')state=raw;}catch{}
const save=()=>{try{localStorage.setItem(key,JSON.stringify(state));el('calendar-status').textContent='Termíny uložené v tomto prehliadači.';}catch{el('calendar-status').textContent='Ukladanie nie je dostupné.';}};
const validDate=(s:string)=>{if(typeof s!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(s))return false;const d=new Date(s+'T12:00:00');return !Number.isNaN(d.getTime())&&d.getFullYear()===Number(s.slice(0,4))&&d.getMonth()+1===Number(s.slice(5,7))&&d.getDate()===Number(s.slice(8,10));};
const templates:Record<string,{title:string,help:string,href?:string}>={
  stk:{title:'Koniec platnosti STK / EK',help:'Presný dátum prevezmite z dokladu o kontrole alebo z overeného záznamu vozidla. Predloha neurčuje zákonnú periodicitu.',href:'/navody/stk-priprava/'},
  pzp:{title:'Úhrada alebo obnova PZP',help:'Dátum úhrady a výročia overte v poistnej zmluve. Pri výpovedi si osobitne overte lehotu a spôsob doručenia.',href:'/navody/povinne-zmluvne-poistenie/'},
  service:{title:'Servis vozidla',help:'Zvoľte vlastný termín podľa servisného plánu výrobcu a aktuálneho nájazdu.'},
  identity:{title:'Koniec platnosti občianskeho preukazu',help:'Dátum odpíšte z dokladu; prípravu výmeny si môžete uložiť ako samostatný skorší termín.',href:'/navody/ako-vybavit-obciansky-preukaz/'},
  passport:{title:'Koniec platnosti cestovného pasu',help:'Dátum odpíšte z dokladu. Požadovanú zostávajúcu platnosť pri cestovaní overte pre cieľovú krajinu.',href:'/navody/vymena-cestovneho-pasu/'},
  driving:{title:'Koniec platnosti vodičského preukazu',help:'Dátum odpíšte z dokladu; osobitné zdravotné alebo profesijné povinnosti overte na príslušnom úrade.'},
  insurance:{title:'Kontrola poistenia domácnosti',help:'Zvoľte dátum podľa vlastnej poistnej zmluvy alebo plánovanej revízie krytia.'},
  mortgage:{title:'Koniec fixácie úveru',help:'Dátum a podmienky overte v banke alebo zmluve. Ponuku a možné poplatky posúďte samostatne.',href:'/navody/refinancovanie-uveru/'},
  contract:{title:'Kontrola obnovy zmluvy',help:'Skontrolujte dátum obnovy, výpovednú lehotu a požadovaný spôsob doručenia v konkrétnej zmluve.'}
};
el('calendar-template').addEventListener('change',()=>{const t=templates[(el('calendar-template') as HTMLSelectElement).value];const link=el('calendar-template-guide') as HTMLAnchorElement;link.hidden=!t?.href;if(t?.href)link.href=t.href;else link.removeAttribute('href');el('calendar-template-help').textContent=t?.help||'Predloha vyplní názov. Žiadny termín sa nevytvorí bez vášho potvrdenia.';if(t){(el('calendar-title') as HTMLInputElement).value=t.title;(el('calendar-date') as HTMLInputElement).focus();}});
const localDay=(d:Date)=>[d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');
el('calendar-filter').addEventListener('change',render);
function render(){const container=el('calendar-items');container.replaceChildren();const sorted=[...state.deadlines].filter(d=>d&&typeof d.title==='string'&&validDate(d.date)).sort((a,b)=>a.date.localeCompare(b.date));const today=localDay(new Date());const month=new Date();month.setDate(month.getDate()+30);const end=localDay(month);const filter=(el('calendar-filter') as HTMLSelectElement).value;const visible=sorted.filter(d=>filter==='upcoming'?d.date>=today:filter==='month'?d.date>=today&&d.date<=end:filter==='past'?d.date<today:true);el('calendar-count').textContent='Zobrazené: '+visible.length+' z '+sorted.length+' uložených termínov.';if(!visible.length){container.textContent=sorted.length?'Pre zvolený filter nemáte žiadne termíny.':'Zatiaľ nemáte žiadne termíny.';return;}for(const d of visible){const row=document.createElement('div');row.className='event';const title=document.createElement('strong');title.textContent=d.title;const date=document.createElement('time');date.dateTime=d.date;date.textContent=new Date(d.date+'T12:00:00').toLocaleDateString('sk-SK');const remove=document.createElement('button');remove.type='button';remove.textContent='Odstrániť';remove.setAttribute('aria-label','Odstrániť termín: '+d.title);remove.addEventListener('click',()=>{state.deadlines=state.deadlines.filter(x=>x.id!==d.id);save();render();el('calendar-status').textContent='Termín odstránený: '+d.title+'.';(el('calendar-title') as HTMLInputElement).focus();});row.append(date,title,remove);container.append(row);}}
el('calendar-form').addEventListener('submit',e=>{e.preventDefault();const title=(el('calendar-title') as HTMLInputElement).value.trim(),date=(el('calendar-date') as HTMLInputElement).value;if(!title||!validDate(date)||state.deadlines.length>=500){el('calendar-status').textContent='Skontrolujte názov, dátum alebo limit 500 termínov.';return;}if(state.deadlines.some(d=>d&&d.title===title&&d.date===date)){el('calendar-status').textContent='Rovnaký názov a dátum už máte uložený.';return;}state.deadlines.push({id:crypto.randomUUID?.()||String(Date.now()),title:title.slice(0,120),date});save();(el('calendar-form') as HTMLFormElement).reset();render();});
const escapeIcs=(s:string)=>s.replace(/\\/g,'\\\\').replace(/\n/g,'\\n').replace(/,/g,'\\,').replace(/;/g,'\\;');
el('calendar-export').addEventListener('click',()=>{const events=state.deadlines.filter(d=>d&&typeof d.title==='string'&&validDate(d.date)).map(d=>{const start=d.date.replaceAll('-','');const next=new Date(d.date+'T12:00:00');next.setDate(next.getDate()+1);const end=[next.getFullYear(),String(next.getMonth()+1).padStart(2,'0'),String(next.getDate()).padStart(2,'0')].join('');return ['BEGIN:VEVENT','UID:'+encodeURIComponent(d.id)+'@vsetko24.sk','DTSTART;VALUE=DATE:'+start,'DTEND;VALUE=DATE:'+end,'SUMMARY:'+escapeIcs(d.title),'END:VEVENT'].join('\r\n');});if(!events.length){el('calendar-status').textContent='Najskôr pridajte aspoň jeden termín.';return;}const content=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//VSETKO24//Calendar SK//EN','CALSCALE:GREGORIAN',...events,'END:VCALENDAR'].join('\r\n')+'\r\n';const url=URL.createObjectURL(new Blob([content],{type:'text/calendar;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='vsetko24-terminy.ics';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
render();
</script>
<style>.calendar{max-width:950px}.calendar .panel{padding:1.4rem;margin:1.3rem 0}.calendar-form{display:grid;grid-template-columns:2fr 1fr auto;align-items:end;gap:.7rem}.calendar label{display:block;font-weight:650}.calendar input,.calendar select{display:block;width:100%;padding:.8rem;border:1px solid #8c9ab0;border-radius:9px;background:var(--surface);color:var(--ink);font:inherit}.calendar button{padding:.8rem;border:1px solid #8290a5;border-radius:9px;cursor:pointer}.event{display:flex;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid #8290a555}.event strong{flex:1}.event time{min-width:105px}@media(max-width:680px){.calendar-form{grid-template-columns:1fr}.event{flex-wrap:wrap}}</style>
</Base>
