---
import Base from '../layouts/Base.astro';
---
<Base title="Kalendár povinností" description="Súkromný kalendár termínov s exportom do kalendára iPhone, Google alebo Outlook. Bez registrácie.">
<main class="wrap main calendar" id="obsah"><p class="eyebrow">Moje centrum · Novinka 3.15</p><h1>Kalendár povinností</h1><p class="intro">Pridajte si STK, poistenie, výmenu dokladov či vlastný termín. Záznamy sa synchronizujú s termínmi v <a href="/moje-centrum/#terminy">Mojom centre</a> na tomto zariadení.</p>
<section class="panel"><h2>Pridať termín</h2><form id="calendar-form" class="calendar-form"><label>Názov povinnosti<input id="calendar-title" required maxlength="120" placeholder="Napr. koniec platnosti PZP"/></label><label>Dátum<input id="calendar-date" type="date" required/></label><button type="submit">Pridať</button></form><p id="calendar-status" role="status" aria-live="polite"></p></section>
<section class="panel"><h2>Najbližšie termíny</h2><div id="calendar-items"></div><button id="calendar-export" type="button">Stiahnuť všetky termíny (.ics)</button><p class="note">Súbor .ics môžete importovať do kalendára v mobile alebo počítači. Samotný portál neposiela push ani e-mailové upozornenia; pripomienky nastavíte v kalendárovej aplikácii.</p></section>
</main>
<script>
type Deadline={id:string,title:string,date:string};type Store={version:1,tasks:unknown[],deadlines:Deadline[],budget:Record<string,number>};
const key='v24-personal-center-v1';let state:Store={version:1,tasks:[],deadlines:[],budget:{}};const el=(id:string)=>document.getElementById(id)!;
try{const raw=JSON.parse(localStorage.getItem(key)||'null');if(raw&&raw.version===1&&Array.isArray(raw.deadlines)&&Array.isArray(raw.tasks)&&raw.budget&&typeof raw.budget==='object')state=raw;}catch{}
const save=()=>{try{localStorage.setItem(key,JSON.stringify(state));el('calendar-status').textContent='Termíny uložené v tomto prehliadači.';}catch{el('calendar-status').textContent='Ukladanie nie je dostupné.';}};
const validDate=(s:string)=>/^\d{4}-\d{2}-\d{2}$/.test(s)&&!Number.isNaN(new Date(s+'T12:00:00').getTime());
function render(){const container=el('calendar-items');container.replaceChildren();const sorted=[...state.deadlines].filter(d=>d&&typeof d.title==='string'&&validDate(d.date)).sort((a,b)=>a.date.localeCompare(b.date));if(!sorted.length){container.textContent='Zatiaľ nemáte žiadne termíny.';return;}for(const d of sorted){const row=document.createElement('div');row.className='event';const title=document.createElement('strong');title.textContent=d.title;const date=document.createElement('time');date.dateTime=d.date;date.textContent=new Date(d.date+'T12:00:00').toLocaleDateString('sk-SK');const remove=document.createElement('button');remove.type='button';remove.textContent='Odstrániť';remove.addEventListener('click',()=>{state.deadlines=state.deadlines.filter(x=>x.id!==d.id);save();render();});row.append(date,title,remove);container.append(row);}}
el('calendar-form').addEventListener('submit',e=>{e.preventDefault();const title=(el('calendar-title') as HTMLInputElement).value.trim(),date=(el('calendar-date') as HTMLInputElement).value;if(!title||!validDate(date)||state.deadlines.length>=500){el('calendar-status').textContent='Skontrolujte názov, dátum alebo limit 500 termínov.';return;}state.deadlines.push({id:crypto.randomUUID?.()||String(Date.now()),title:title.slice(0,120),date});save();(el('calendar-form') as HTMLFormElement).reset();render();});
const escapeIcs=(s:string)=>s.replace(/\\/g,'\\\\').replace(/\n/g,'\\n').replace(/,/g,'\\,').replace(/;/g,'\\;');
el('calendar-export').addEventListener('click',()=>{const events=state.deadlines.filter(d=>d&&typeof d.title==='string'&&validDate(d.date)).map(d=>{const start=d.date.replaceAll('-','');const next=new Date(d.date+'T12:00:00');next.setDate(next.getDate()+1);const end=[next.getFullYear(),String(next.getMonth()+1).padStart(2,'0'),String(next.getDate()).padStart(2,'0')].join('');return ['BEGIN:VEVENT','UID:'+encodeURIComponent(d.id)+'@vsetko24.sk','DTSTART;VALUE=DATE:'+start,'DTEND;VALUE=DATE:'+end,'SUMMARY:'+escapeIcs(d.title),'END:VEVENT'].join('\r\n');});if(!events.length){el('calendar-status').textContent='Najskôr pridajte aspoň jeden termín.';return;}const content=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//VSETKO24//Calendar SK//EN','CALSCALE:GREGORIAN',...events,'END:VCALENDAR'].join('\r\n')+'\r\n';const url=URL.createObjectURL(new Blob([content],{type:'text/calendar;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='vsetko24-terminy.ics';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
render();
</script>
<style>.calendar{max-width:950px}.calendar .panel{padding:1.4rem;margin:1.3rem 0}.calendar-form{display:grid;grid-template-columns:2fr 1fr auto;align-items:end;gap:.7rem}.calendar label{display:block;font-weight:650}.calendar input{display:block;width:100%;padding:.8rem;border:1px solid #8c9ab0;border-radius:9px;background:var(--surface);color:var(--ink);font:inherit}.calendar button{padding:.8rem;border:1px solid #8290a5;border-radius:9px;cursor:pointer}.event{display:flex;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid #8290a555}.event strong{flex:1}.event time{min-width:105px}@media(max-width:680px){.calendar-form{grid-template-columns:1fr}.event{flex-wrap:wrap}}</style>
</Base>