---
interface Step { title: string; detail: string }
interface Props { steps: Step[]; storageKey: string }
const { steps, storageKey } = Astro.props;
---
<section class="panel guide-checklist" data-guide-checklist data-storage-key={storageKey} aria-label="Kontrolný zoznam úloh">
  <h2>Váš postup krok za krokom</h2>
  <p>Označte vybavené kroky. Postup sa ukladá iba vo vašom prehliadači, nie na server. <a href="/moje-kontrolne-zoznamy/">Zobraziť prehľad všetkých kontrolných zoznamov →</a></p>
  <p class="guide-progress" role="status" aria-live="polite">Vybavené: 0 z {steps.length}</p>
  <ol class="guide-steps">
    {steps.map((step, index) => (
      <li>
        <label class="guide-step-label">
          <input type="checkbox" data-guide-step={index} />
          <span><strong>{step.title}</strong><br />{step.detail}</span>
        </label>
      </li>
    ))}
  </ol>
  <button type="button" data-guide-reset class="guide-reset">Začať odznova</button>
</section>
<style>
  .guide-steps{list-style:none;padding:0;display:grid;gap:1rem}
  .guide-steps li{padding:.8rem;border:1px solid var(--border,#d7dce4);border-radius:.65rem}
  .guide-step-label{display:flex;align-items:flex-start;gap:.85rem;cursor:pointer}
  .guide-step-label input{margin-top:.3rem;flex:none;width:1.2rem;height:1.2rem}
  .guide-step-label input:checked+span{opacity:.72}
  .guide-progress{font-weight:700}
  .guide-reset{padding:.65rem 1rem;border-radius:.6rem;cursor:pointer}
  @media print{.guide-reset{display:none}}
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-guide-checklist]').forEach((root) => {
    const key = 'vsetko24:guide:v1:' + root.dataset.storageKey;
    const inputs = [...root.querySelectorAll<HTMLInputElement>('[data-guide-step]')];
    const progress = root.querySelector<HTMLElement>('.guide-progress');
    const update = () => {
      const done = inputs.filter(input => input.checked).length;
      if (progress) progress.textContent = `Vybavené: ${done} z ${inputs.length}`;
      try { localStorage.setItem(key, JSON.stringify(inputs.map(input => input.checked))); } catch {}
    };
    try {
      const saved = JSON.parse(localStorage.getItem(key) || '[]');
      if (Array.isArray(saved)) inputs.forEach((input, i) => { input.checked = saved[i] === true; });
    } catch {}
    inputs.forEach(input => input.addEventListener('change', update));
    root.querySelector('[data-guide-reset]')?.addEventListener('click', () => {
      inputs.forEach(input => { input.checked = false; });
      update();
    });
    update();
  });
</script>
