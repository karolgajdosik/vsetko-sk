---
const {title='VŠETKO24.sk',description='Praktické návody a kalkulačky pre Slovensko.',updated,sourceLinks=[]}=Astro.props;
const path=Astro.url.pathname;
const nav=[['/','Domov'],['/sluzby/','Služby'],['/financie/','Financie'],['/auto/','Auto'],['/urady/','Úrady'],['/sprievodca/','Sprievodca'],['/data/','Dáta'],['/hladat/','Hľadať'],['/ai/','VŠETKO AI'],['/moje-centrum/','Moje centrum'],['/kalendar/','Kalendár'],['/dokumenty/','Dokumenty']];
const primaryNav=nav.filter(([href])=>!['/data/','/moje-centrum/','/kalendar/','/dokumenty/'].includes(href));
const extraNav=nav.filter(([href])=>['/data/','/moje-centrum/','/kalendar/','/dokumenty/'].includes(href));
const section=path.split('/').filter(Boolean)[0] ?? '';
const photoBySection={
 financie:['photo-1560518883-ce09059eeffa','Financie a bývanie'],
 kalkulacky:['photo-1560518883-ce09059eeffa','Kalkulačky a výpočty'],
 auto:['photo-1503376780353-7e6692767b70','Auto a mobilita'],
 urady:['photo-1486406146926-c627a92ad1ab','Úrady a dokumenty'],
 navody:['photo-1497366754035-f200968a6e72','Praktické návody'],
 sprievodca:['photo-1497366811353-6870744d04b2','Životné situácie'],
 sluzby:['photo-1497366754035-f200968a6e72','Digitálne služby'],
 nastroje:['photo-1497366811353-6870744d04b2','Praktické nástroje'],
 data:['photo-1451187580459-43490279c0fa','Dáta a informácie'],
 ai:['photo-1451187580459-43490279c0fa','Digitálny asistent'],
 dokumenty:['photo-1486406146926-c627a92ad1ab','Dokumenty'],
 kalendar:['photo-1497366811353-6870744d04b2','Kalendár'],
 'moje-centrum':['photo-1497366811353-6870744d04b2','Moje centrum'],
 hladat:['photo-1497366754035-f200968a6e72','Vyhľadávanie']
};
const photo=photoBySection[section];
const showPhoto=Boolean(photo);
const canonical = new URL(path, Astro.site ?? 'https://vsetko24.sk').href;
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN; // Leave unset when Pages injects Web Analytics automatically.
const fullTitle = title === 'VŠETKO24.sk' ? title : `${title} | VŠETKO24.sk`;
---
<!doctype html>
<html lang="sk" data-theme="auto">
<head>
<script is:inline>
(function(){try{const v=localStorage.getItem('v24-theme');document.documentElement.dataset.theme=v==='dark'||(v!=='light'&&matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';const n=Number(localStorage.getItem('v24-font'));if(n>=100&&n<=150)document.documentElement.style.fontSize=n+'%';}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}})();
</script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#123b69" />
<meta name="color-scheme" content="light dark" />
<meta name="robots" content={section==='404' ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="stylesheet" href="/site.css?v=4.33.0" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="sk_SK" />
<meta property="og:site_name" content="VŠETKO24.sk" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<title>{fullTitle}</title>
{analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:analyticsToken})}></script>}
</head>
<body>
<a class="skip" href="#obsah">Preskočiť na obsah</a>
<header class="top"><div class="wrap topinner"><a class="brand" href="/" aria-label="VŠETKO24.sk – domov">VŠETKO<span>24.sk</span></a><div class="mobile-quick-actions"><button type="button" id="mobile-theme-toggle" aria-pressed="false" aria-label="Prepnúť tmavý režim" title="Tmavý režim"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.8A8.6 8.6 0 0 1 8.2 4a8.8 8.8 0 1 0 11.8 11.8Z"/></svg></button><button type="button" id="mobile-font-up" aria-label="Zväčšiť písmo" title="Zväčšiť písmo">A+</button><a href="/hladat/" aria-label="Hľadať na portáli" title="Hľadať"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg></a><a href="/moje-centrum/" aria-label="Moje uložené položky" title="Uložené"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.5h12v17l-6-4-6 4z"/></svg></a></div><button class="mobile-menu-toggle" type="button" aria-label="Otvoriť navigáciu" aria-controls="site-nav" aria-expanded="false"><span></span><span></span><span></span></button><nav id="site-nav" aria-label="Hlavná navigácia">{primaryNav.map(([href,label])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}<details class="nav-more"><summary>Viac <span aria-hidden="true">▾</span></summary><div class="nav-more-links">{extraNav.map(([href,label])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}</div></details></nav><div class="access-tools" role="group" aria-label="Nastavenia zobrazenia"><button type="button" id="theme-toggle" aria-label="Prepnúť tmavý režim" aria-pressed="false" title="Tmavý režim">◐</button><button type="button" id="font-down" aria-label="Zmenšiť písmo" title="Zmenšiť písmo">A−</button><button type="button" id="font-up" aria-label="Zväčšiť písmo" title="Zväčšiť písmo">A+</button><button type="button" id="font-reset" aria-label="Obnoviť veľkosť písma" title="Obnoviť písmo">↺</button></div></div></header>
{showPhoto && <div class="section-photo" aria-label={photo[1]}><img src={`https://images.unsplash.com/${photo[0]}?auto=format&fit=crop&w=1200&q=72`} alt="" width="1200" height="420" loading="lazy" decoding="async"/><div class="section-photo-overlay"><span class="wrap">{photo[1]}</span></div></div>}
<slot />
<nav class="mobile-bottom-nav" aria-label="Rýchla mobilná navigácia">
<a href="/sluzby/" aria-current={['sluzby','nastroje'].includes(section)?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span>Služby</span></a>
<a href="/kalkulacky/" aria-current={section==='kalkulacky'?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2.5" width="14" height="19" rx="2"/><path d="M8 7h8M8 11h2m4 0h2m-8 4h2m4 0h2m-8 4h2m4 0h2"/></svg><span>Kalkulačky</span></a>
<a href="/ai/" aria-current={section==='ai'?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5z"/></svg><span>AI</span></a>
<a href="/navody/" aria-current={section==='navody'?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C9 3 6 3 3 4v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Zm0 0v15"/></svg><span>Návody</span></a>
<a href="/moje-centrum/" aria-current={section==='moje-centrum'?'page':undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 21c.5-5 3-7 7.5-7s7 2 7.5 7"/></svg><span>Moje</span></a>
</nav>
<a class="assistant-floating" href="/ai/" aria-label="Otvoriť AI asistenta">✦ <span>Sprievodca</span></a>
{(updated || sourceLinks.length>0) && <aside class="wrap trust" aria-label="Informácie o obsahu"><p><strong>Informácie o obsahu:</strong> {updated ? `Posledná redakčná aktualizácia: ${updated}.` : 'Obsah sa priebežne dopĺňa.'} {sourceLinks.length>0 && <> Oficiálne zdroje: {sourceLinks.map((s,i)=><span>{i>0?', ':''}<a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></span>)}</>}</p><p>Pri úradných a právnych témach majú prednosť aktuálne informácie príslušných úradov. Dátum aktualizácie neznamená overenie všetkých právnych detailov.</p></aside>}
<footer class="footer"><div class="wrap footinner"><span>© {new Date().getFullYear()} VŠETKO24.sk · Nezávislý pilotný portál</span><span><a href="/o-projekte/">O projekte</a> · <a href="/kontakt/">Kontakt</a> · <a href="/ochrana-sukromia/">Ochrana súkromia</a> · <a href="/pristupnost/">Prístupnosť a pravidlá EÚ</a></span><span>Nie sme oficiálny portál štátnej správy.</span></div></footer>
<script is:inline>const toggle=document.querySelector('.mobile-menu-toggle');const nav=document.querySelector('#site-nav');if(toggle&&nav){toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Zavrieť navigáciu':'Otvoriť navigáciu');nav.classList.toggle('nav-open',open)});const closeMenu=()=>{nav.classList.remove('nav-open');toggle.setAttribute('aria-expanded','false');toggle.setAttribute('aria-label','Otvoriť navigáciu')};nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));document.addEventListener('keydown',event=>{if(event.key==='Escape'&&toggle.getAttribute('aria-expanded')==='true'){closeMenu();toggle.focus()}});document.addEventListener('click',event=>{if(toggle.getAttribute('aria-expanded')==='true'&&!nav.contains(event.target)&&!toggle.contains(event.target))closeMenu()});}</script><script is:inline>
(function(){
const root=document.documentElement;
const storage=(key)=>{try{return localStorage.getItem(key)}catch{return null}};
const save=(key,val)=>{try{localStorage.setItem(key,val)}catch{}};
const preferred=storage('v24-theme');
const media=window.matchMedia('(prefers-color-scheme: dark)');
const applyTheme=()=>{const dark=(preferredTheme==='dark'||(preferredTheme==='auto'&&media.matches));root.dataset.theme=dark?'dark':'light';root.classList.toggle('dark-mode',dark);for(const btn of [document.getElementById('theme-toggle'),document.getElementById('mobile-theme-toggle')]){if(btn){btn.setAttribute('aria-pressed',String(dark));btn.setAttribute('aria-label',dark?'Zapnúť svetlý režim':'Zapnúť tmavý režim');btn.title=dark?'Svetlý režim':'Tmavý režim';if(btn.id==='theme-toggle')btn.textContent=dark?'☀':'☾';}}};
let preferredTheme=preferred==='dark'||preferred==='light'?preferred:'auto';applyTheme();
media.addEventListener?.('change',applyTheme);
const toggleTheme=()=>{preferredTheme=root.dataset.theme==='dark'?'light':'dark';save('v24-theme',preferredTheme);applyTheme()};document.getElementById('theme-toggle')?.addEventListener('click',toggleTheme);document.getElementById('mobile-theme-toggle')?.addEventListener('click',toggleTheme);
let size=Math.min(150,Math.max(100,Number(storage('v24-font'))||100));
const applySize=()=>{root.style.fontSize=size+'%';};
applySize();
const increaseFont=()=>{size=Math.min(150,size+10);save('v24-font',String(size));applySize()};document.getElementById('font-up')?.addEventListener('click',increaseFont);document.getElementById('mobile-font-up')?.addEventListener('click',increaseFont);
document.getElementById('font-down')?.addEventListener('click',()=>{size=Math.max(100,size-10);save('v24-font',String(size));applySize()});
document.getElementById('font-reset')?.addEventListener('click',()=>{size=100;save('v24-font',String(size));applySize()});
})();
</script></body></html>
