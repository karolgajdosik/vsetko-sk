---
const {title='VŠETKO24.sk',description='Praktické návody a kalkulačky pre Slovensko.',updated,sourceLinks=[]}=Astro.props;
const path=Astro.url.pathname;
const nav=[['/','Domov'],['/financie/','Financie'],['/auto/','Auto'],['/urady/','Úrady'],['/sprievodca/','Sprievodca'],['/data/','Dáta'],['/hladat/','Hľadať'],['/ai/','VŠETKO AI']];
const canonical = new URL(path, Astro.site ?? 'https://vsetko24.sk').href;
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN; // Leave unset when Pages injects Web Analytics automatically.
const fullTitle = title === 'VŠETKO.sk' ? title : `${title} | VŠETKO24.sk`;
---
<!doctype html>
<html lang="sk" data-theme="auto">
<head>
<script is:inline>
(function(){try{const v=localStorage.getItem('v24-theme');document.documentElement.dataset.theme=v==='dark'||(v!=='light'&&matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';const n=Number(localStorage.getItem('v24-font'));if(n>=100&&n<=150)document.documentElement.style.fontSize=n+'%';}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}})();
</script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#123b69" />
<meta name="color-scheme" content="light dark" />
<meta name="robots" content="index,follow,max-image-preview:large" />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="stylesheet" href="/site.css?v=3.7.2" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="sk_SK" />
<meta property="og:site_name" content="VŠETKO24.sk" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<title>{fullTitle}</title>
{analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:analyticsToken})}></script>}
</head>
<body>
<a class="skip" href="#obsah">Preskočiť na obsah</a>
<header class="top"><div class="wrap topinner"><a class="brand" href="/" aria-label="VŠETKO24.sk – domov">VŠETKO<span>24.sk</span></a><button class="mobile-menu-toggle" type="button" aria-label="Otvoriť navigáciu" aria-controls="site-nav" aria-expanded="false"><span></span><span></span><span></span></button><nav id="site-nav" aria-label="Hlavná navigácia">{nav.map(([href,label])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}</nav><div class="access-tools" role="group" aria-label="Nastavenia zobrazenia"><button type="button" id="theme-toggle" aria-label="Prepnúť tmavý režim" aria-pressed="false" title="Tmavý režim">◐</button><button type="button" id="font-down" aria-label="Zmenšiť písmo" title="Zmenšiť písmo">A−</button><button type="button" id="font-up" aria-label="Zväčšiť písmo" title="Zväčšiť písmo">A+</button><button type="button" id="font-reset" aria-label="Obnoviť veľkosť písma" title="Obnoviť písmo">↺</button></div></div></header>
<slot />
<a class="assistant-floating" href="/ai/" aria-label="Otvoriť AI asistenta">✦ <span>Sprievodca</span></a>
{(updated || sourceLinks.length>0) && <aside class="wrap trust" aria-label="Informácie o obsahu"><p><strong>Informácie o obsahu:</strong> {updated ? `Posledná redakčná aktualizácia: ${updated}.` : 'Obsah sa priebežne dopĺňa.'} {sourceLinks.length>0 && <> Oficiálne zdroje: {sourceLinks.map((s,i)=><span>{i>0?', ':''}<a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></span>)}</>}</p><p>Pri úradných a právnych témach majú prednosť aktuálne informácie príslušných úradov. Dátum aktualizácie neznamená overenie všetkých právnych detailov.</p></aside>}
<footer class="footer"><div class="wrap footinner"><span>© {new Date().getFullYear()} VŠETKO24.sk · Nezávislý pilotný portál</span><span><a href="/o-projekte/">O projekte</a> · <a href="/kontakt/">Kontakt</a> · <a href="/ochrana-sukromia/">Ochrana súkromia</a> · <a href="/pristupnost/">Prístupnosť a pravidlá EÚ</a></span><span>Nie sme oficiálny portál štátnej správy.</span></div></footer>
<script is:inline>const toggle=document.querySelector('.mobile-menu-toggle');const nav=document.querySelector('#site-nav');if(toggle&&nav){toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Zavrieť navigáciu':'Otvoriť navigáciu');nav.classList.toggle('nav-open',open)});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('nav-open');toggle.setAttribute('aria-expanded','false')}));}</script><script is:inline>
(function(){
const root=document.documentElement;
const storage=(key)=>{try{return localStorage.getItem(key)}catch{return null}};
const save=(key,val)=>{try{localStorage.setItem(key,val)}catch{}};
const preferred=storage('v24-theme');
const media=window.matchMedia('(prefers-color-scheme: dark)');
const applyTheme=()=>{const dark=(preferredTheme==='dark'||(preferredTheme==='auto'&&media.matches));root.dataset.theme=dark?'dark':'light';root.classList.toggle('dark-mode',dark);const btn=document.getElementById('theme-toggle');if(btn){btn.setAttribute('aria-pressed',String(dark));btn.setAttribute('aria-label',dark?'Zapnúť svetlý režim':'Zapnúť tmavý režim');btn.textContent=dark?'☀':'☾';}};
let preferredTheme=preferred==='dark'||preferred==='light'?preferred:'auto';applyTheme();
media.addEventListener?.('change',applyTheme);
document.getElementById('theme-toggle')?.addEventListener('click',()=>{preferredTheme=root.dataset.theme==='dark'?'light':'dark';save('v24-theme',preferredTheme);applyTheme()});
let size=Math.min(150,Math.max(100,Number(storage('v24-font'))||100));
const applySize=()=>{root.style.fontSize=size+'%';};
applySize();
document.getElementById('font-up')?.addEventListener('click',()=>{size=Math.min(150,size+10);save('v24-font',String(size));applySize()});
document.getElementById('font-down')?.addEventListener('click',()=>{size=Math.max(100,size-10);save('v24-font',String(size));applySize()});
document.getElementById('font-reset')?.addEventListener('click',()=>{size=100;save('v24-font',String(size));applySize()});
})();
</script></body></html>
